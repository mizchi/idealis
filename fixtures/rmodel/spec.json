    "rules": [
      {
        "id": "MUTEX-ONE-HOLDER",
        "text": {
          "ja": "1 つのロックを同時に持つプロセスは高々 1 つ。",
          "en": "At most one process holds a lock at a time."
        },
        "terms": [
          "lock",
          "proc",
          "holder"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/mutex.model",
            "check": "OneHolder",
            "expect": "holds"
          },
          {
            "model": "fixtures/rmodel/declared.model",
            "check": "OneHolder",
            "expect": "holds"
          }
        ]
      },
      {
        "id": "MUTEX-USED",
        "text": {
          "ja": "ロックは実際に取得され、すべてのロックが同時に持たれることもある。",
          "en": "Locks are actually acquired, and all of them can be held at once."
        },
        "terms": [
          "lock",
          "acquire",
          "holder"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/mutex.model",
            "check": "NeverHeld",
            "expect": "violated"
          },
          {
            "model": "fixtures/rmodel/mutex.model",
            "check": "Handover",
            "expect": "reachable"
          },
          {
            "model": "fixtures/rmodel/declared.model",
            "check": "BothHeld",
            "expect": "reachable"
          }
        ]
      },
      {
        "id": "MUTEX-SEVERAL-LOCKS",
        "text": {
          "ja": "1 つのプロセスが複数のロックを同時に持てる。",
          "en": "One process can hold several locks at once."
        },
        "terms": [
          "proc",
          "lock",
          "holder"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/mutex.model",
            "check": "TwoLocksOneProc",
            "expect": "reachable"
          }
        ]
      },
      {
        "id": "WAIT-EXACTLY-ONE",
        "text": {
          "ja": "待機中のプロセスは常にちょうど 1 つ。",
          "en": "There is always exactly one waiting process."
        },
        "terms": [
          "waiting",
          "wait"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/declared.model",
            "check": "OneWaiting",
            "expect": "holds"
          }
        ]
      },
      {
        "id": "PERM-NO-LEAK",
        "text": {
          "ja": "付与の方針の下では、機密文書を開いている利用者は、許可を受けた利用者だけ。",
          "en": "Under the grant policy, only cleared users have secret documents open."
        },
        "terms": [
          "secret",
          "cleared",
          "open",
          "grants"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/permissions.model",
            "check": "NoLeak",
            "expect": "holds"
          },
          {
            "model": "fixtures/rmodel/permissions.model",
            "check": "UnclearedSecret",
            "expect": "unreachable"
          }
        ]
      },
      {
        "id": "PERM-POLICY-NEEDED",
        "text": {
          "ja": "付与の方針がなければ、許可を受けていない利用者が機密文書を開けてしまう。",
          "en": "Without the grant policy, a user who is not cleared can open a secret document."
        },
        "terms": [
          "secret",
          "cleared",
          "grants"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/permissions-open.model",
            "check": "NoLeak",
            "expect": "violated"
          },
          {
            "model": "fixtures/rmodel/permissions-open.model",
            "check": "UnclearedSecret",
            "expect": "reachable"
          }
        ]
      },
      {
        "id": "PERM-ONLY-GRANTED",
        "text": {
          "ja": "利用者が開いている文書は、付与されたロールが読める文書だけ。",
          "en": "A user has open only documents a granted role can read."
        },
        "terms": [
          "open",
          "grants",
          "reads"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/permissions.model",
            "check": "OnlyGranted",
            "expect": "holds"
          },
          {
            "model": "fixtures/rmodel/permissions-open.model",
            "check": "OnlyGranted",
            "expect": "holds"
          }
        ]
      },
      {
        "id": "PERM-SECRET-USABLE",
        "text": {
          "ja": "付与の方針があっても、機密文書を開ける場合がある。",
          "en": "Even under the grant policy, a secret document can be opened."
        },
        "terms": [
          "secret",
          "read"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/permissions.model",
            "check": "SecretRead",
            "expect": "reachable"
          },
          {
            "model": "fixtures/rmodel/permissions-open.model",
            "check": "SecretRead",
            "expect": "reachable"
          }
        ]
      },
      {
        "id": "SESS-CAPACITY",
        "text": {
          "ja": "同時にログインしている利用者は 2 人まで。",
          "en": "At most two users are logged in at once."
        },
        "terms": [
          "active",
          "login"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/sessions.model",
            "check": "Capacity",
            "expect": "holds"
          },
          {
            "model": "fixtures/rmodel/sessions.model",
            "check": "ThreeActive",
            "expect": "unreachable"
          }
        ]
      },
      {
        "id": "SESS-FULL-AND-LOCKED",
        "text": {
          "ja": "定員いっぱいで、かつロックされた状態になりうる。",
          "en": "The system can be full and locked at the same time."
        },
        "terms": [
          "active",
          "locked"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/sessions.model",
            "check": "Full",
            "expect": "reachable"
          }
        ]
      },
      {
        "id": "SESS-LOCK-BY-ADMIN",
        "text": {
          "ja": "システムをロックしているのは管理者だけ。",
          "en": "Only an administrator has the system locked."
        },
        "terms": [
          "locked",
          "admins",
          "lock-system"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/sessions.model",
            "check": "LockedByAdmin",
            "expect": "holds"
          }
        ]
      },
      {
        "id": "SESS-LOCK-OUTLIVES-LOGOUT",
        "text": {
          "ja": "ロックした利用者がログアウトしても、ロックは残る。",
          "en": "The lock remains after the locking user logs out."
        },
        "terms": [
          "locked",
          "logout",
          "active"
        ],
        "claims": [
          {
            "model": "fixtures/rmodel/sessions.model",
            "check": "LockedIsActive",
            "expect": "violated"
          }
        ]
      }
    ],
    "groundings": []
  }
}
