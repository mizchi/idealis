---- MODULE Differential ----
EXTENDS Naturals, Sequences
VARIABLE x
Init == x = 0
Next == UNCHANGED x
D0 == TRUE
D1 == IF TRUE THEN TRUE ELSE (D0 /\ D0)
D2 == IF TRUE THEN TRUE ELSE (D1 /\ D1)
D3 == IF TRUE THEN TRUE ELSE (D2 /\ D2)
D4 == IF TRUE THEN TRUE ELSE (D3 /\ D3)
D5 == IF TRUE THEN TRUE ELSE (D4 /\ D4)
D6 == IF TRUE THEN TRUE ELSE (D5 /\ D5)
D7 == IF TRUE THEN TRUE ELSE (D6 /\ D6)
D8 == IF TRUE THEN TRUE ELSE (D7 /\ D7)
D9 == IF TRUE THEN TRUE ELSE (D8 /\ D8)
D10 == IF TRUE THEN TRUE ELSE (D9 /\ D9)
D11 == IF TRUE THEN TRUE ELSE (D10 /\ D10)
D12 == IF TRUE THEN TRUE ELSE (D11 /\ D11)
D13 == IF TRUE THEN TRUE ELSE (D12 /\ D12)
D14 == IF TRUE THEN TRUE ELSE (D13 /\ D13)
D15 == IF TRUE THEN TRUE ELSE (D14 /\ D14)
D16 == IF TRUE THEN TRUE ELSE (D15 /\ D15)
D17 == IF TRUE THEN TRUE ELSE (D16 /\ D16)
D18 == IF TRUE THEN TRUE ELSE (D17 /\ D17)
D19 == IF TRUE THEN TRUE ELSE (D18 /\ D18)
D20 == IF TRUE THEN TRUE ELSE (D19 /\ D19)
D21 == IF TRUE THEN TRUE ELSE (D20 /\ D20)
D22 == IF TRUE THEN TRUE ELSE (D21 /\ D21)
D23 == IF TRUE THEN TRUE ELSE (D22 /\ D22)
D24 == IF TRUE THEN TRUE ELSE (D23 /\ D23)
D25 == IF TRUE THEN TRUE ELSE (D24 /\ D24)
D26 == IF TRUE THEN TRUE ELSE (D25 /\ D25)
D27 == IF TRUE THEN TRUE ELSE (D26 /\ D26)
D28 == IF TRUE THEN TRUE ELSE (D27 /\ D27)
D29 == IF TRUE THEN TRUE ELSE (D28 /\ D28)
D30 == IF TRUE THEN TRUE ELSE (D29 /\ D29)
Safe == D30
====
