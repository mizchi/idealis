---------------------------- MODULE LongConjunction ----------------------------

EXTENDS Integers, Sequences, FiniteSets, TLC, Apalache, Variants

VARIABLE
  (*
    @type: Int;
  *)
  x

(*
  @type: (() => Bool);
*)
step == x' := (IF x < 5 THEN x + 1 ELSE 0)

(*
  @type: (() => Bool);
*)
safety ==
  ((((((((((((((((((((((((((((((((((((((((((x /= 10 /\ x /= 11) /\ x /= 12)
                                                                                    /\ x
                                                                                      /= 13)
                                                                                  /\ x
                                                                                    /= 14)
                                                                                /\ x
                                                                                  /= 15)
                                                                              /\ x
                                                                                /= 16)
                                                                            /\ x
                                                                              /= 17)
                                                                          /\ x
                                                                            /= 18)
                                                                        /\ x
                                                                          /= 19)
                                                                      /\ x /= 20)
                                                                    /\ x /= 21)
                                                                  /\ x /= 22)
                                                                /\ x /= 23)
                                                              /\ x /= 24)
                                                            /\ x /= 25)
                                                          /\ x /= 26)
                                                        /\ x /= 27)
                                                      /\ x /= 28)
                                                    /\ x /= 29)
                                                  /\ x /= 30)
                                                /\ x /= 31)
                                              /\ x /= 32)
                                            /\ x /= 33)
                                          /\ x /= 34)
                                        /\ x /= 35)
                                      /\ x /= 36)
                                    /\ x /= 37)
                                  /\ x /= 38)
                                /\ x /= 39)
                              /\ x /= 40)
                            /\ x /= 41)
                          /\ x /= 42)
                        /\ x /= 43)
                      /\ x /= 44)
                    /\ x /= 45)
                  /\ x /= 46)
                /\ x /= 47)
              /\ x /= 48)
            /\ x /= 49)
          /\ x /= 50)
        /\ x /= 51)
      /\ x /= 52)
    /\ x /= 53

(*
  @type: (() => Bool);
*)
broken ==
  ((((((((((((((((((((((((((((((((((((((((((x /= 10 /\ x /= 11) /\ x /= 12)
                                                                                    /\ x
                                                                                      /= 13)
                                                                                  /\ x
                                                                                    /= 14)
                                                                                /\ x
                                                                                  /= 15)
                                                                              /\ x
                                                                                /= 16)
                                                                            /\ x
                                                                              /= 17)
                                                                          /\ x
                                                                            /= 18)
                                                                        /\ x
                                                                          /= 19)
                                                                      /\ x /= 20)
                                                                    /\ x /= 21)
                                                                  /\ x /= 22)
                                                                /\ x /= 23)
                                                              /\ x /= 24)
                                                            /\ x /= 25)
                                                          /\ x /= 26)
                                                        /\ x /= 27)
                                                      /\ x /= 28)
                                                    /\ x /= 29)
                                                  /\ x /= 30)
                                                /\ x /= 31)
                                              /\ x /= 32)
                                            /\ x /= 33)
                                          /\ x /= 34)
                                        /\ x /= 35)
                                      /\ x /= 36)
                                    /\ x /= 37)
                                  /\ x /= 38)
                                /\ x /= 39)
                              /\ x /= 40)
                            /\ x /= 41)
                          /\ x /= 42)
                        /\ x /= 43)
                      /\ x /= 44)
                    /\ x /= 45)
                  /\ x /= 46)
                /\ x /= 47)
              /\ x /= 48)
            /\ x /= 49)
          /\ x /= 50)
        /\ x /= 51)
      /\ x /= 52)
    /\ x /= 4

(*
  @type: (() => Bool);
*)
init == x = 0

(*
  @type: (() => Bool);
*)
q_init == init

(*
  @type: (() => Bool);
*)
q_step == step

(*
  @type: (() => Bool);
*)
q_inv == safety /\ broken

================================================================================
