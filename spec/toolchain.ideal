vocabulary "tla-toolchain" {
  name = { ja: "TLA+ の処理系", en: "TLA+ toolchain" }

  term "tla" {
    kind = logic
    name = "TLA"
    description = {
      ja: "Temporal Logic of Actions。状態と状態間の変化を扱い、実行列全体について性質を記述する時相論理。",
      en: "Temporal Logic of Actions, a temporal logic for specifying states, transitions and properties of whole behaviors."
    }
  }

  term "tla-plus" {
    kind = language
    name = "TLA+"
    description = {
      ja: "TLA、集合論、一階述語論理を土台とする形式仕様言語。状態、次状態への遷移、実行列が満たす性質をモジュールに記述する。",
      en: "A formal specification language based on TLA, set theory and first-order logic. Its modules describe states, next-state transitions and properties of behaviors."
    }
  }

  term "sany" {
    kind = parser
    name = "SANY"
    input = ["tla-plus"]
    description = {
      ja: "TLA+ の公式ツール群の構文解析・意味解析器。Idealis では対応する構文や演算子の優先順位を照合する基準として使う。",
      en: "The syntax and semantic analyzer in the official TLA+ tools. Idealis uses it as a reference for supported syntax and operator precedence."
    }
  }

  term "tlc" {
    kind = checker
    name = "TLC"
    input = ["tla-plus", "tlc-config"]
    description = {
      ja: "実行可能な TLA+ 仕様を検査・シミュレーションする公式ツール。Idealis では、対応する入力でモデル検査の判定や反例を照合する基準として使う。",
      en: "The official model checker and simulator for executable TLA+ specifications. Idealis uses TLC as a reference for verdicts and counterexamples on supported inputs."
    }
  }

  term "rtla" {
    kind = parser
    name = "rtla"
    input = ["tla-plus", "tlc-config"]
    output = ["rtla-ast"]
    compared_with = ["sany"]
    description = {
      ja: "TLA+ ソースと TLC 設定を型付きの構文木へ変換する Idealis の Rust パーサー。",
      en: "The Idealis Rust parser for TLA+ source and TLC configuration, producing typed syntax trees."
    }
    code = { path: "crates/rtla/src/parser.rs", symbol: "parse_module" }
  }

  term "rtla-compiler" {
    kind = compiler
    name = "rtla-compiler"
    input = ["rtla-ast"]
    output = ["safety-program"]
    description = {
      ja: "rtla の TLA+ モジュールと TLC 設定から名前を解決し、対応する仕様を rtlc の SafetyProgram に変換する Rust コンパイラー。",
      en: "The Rust compiler that resolves names in rtla modules and TLC configurations and lowers the supported specifications to rtlc SafetyProgram inputs."
    }
    code = { path: "crates/rtla-compiler/src/source.rs", symbol: "compile_source_bundle" }
  }

  term "rtlc" {
    kind = checker
    name = "rtlc"
    input = ["safety-program"]
    compared_with = ["tlc"]
    description = {
      ja: "SafetyProgram を入力に状態を列挙し、対応する有限モデルの不変条件・デッドロック・時相性質を調べる Idealis の Rust モデル検査ライブラリ。",
      en: "The Idealis Rust model-checking library that explores states from a SafetyProgram and checks invariants, deadlocks and temporal properties of supported finite models."
    }
    code = { path: "crates/rtlc/src/ir.rs", symbol: "SafetyProgram" }
  }

  term "tlc-config" {
    kind = artifact
    name = { ja: "TLC 設定", en: "TLC configuration" }
    description = {
      ja: "初期条件、遷移、定数、検査する性質などを選ぶ TLC の設定ファイル。",
      en: "TLC configuration selecting initial conditions, transitions, constants and properties to check."
    }
  }

  term "rtla-ast" {
    kind = artifact
    name = "rtla AST"
    description = {
      ja: "rtla が解析した TLA+ のモジュールと TLC 設定の型付き構文木。",
      en: "The typed syntax trees for TLA+ modules and TLC configuration parsed by rtla."
    }
  }

  term "safety-program" {
    kind = artifact
    name = "SafetyProgram"
    description = {
      ja: "状態の生成、遷移、検査する性質を rtlc に渡す型付きの中間表現。",
      en: "A typed intermediate representation carrying state generation, transitions and properties to rtlc."
    }
  }
}
