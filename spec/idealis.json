    "rules": [
      {
        "id": "ORACLE-NO-FALSE-MATCH",
        "text": {
          "ja": "報告が一致になるのは、比較が 1 つ以上あり、そのすべてが一致したときだけ。未確定の比較があれば一致にならない。",
          "en": "A report is matched only when there is at least one comparison and every one matched; an unknown comparison keeps it from being matched."
        },
        "terms": [
          "compare.report",
          "compare.matched",
          "search.unknown"
        ],
        "claims": [
          {
            "model": "spec/models/roracle-report.model",
            "check": "MatchedOnlyIfAllMatched",
            "expect": "holds"
          },
          {
            "model": "spec/models/roracle-report.model",
            "check": "UnknownNeverMatched",
            "expect": "holds"
          }
        ]
      },
      {
        "id": "ORACLE-HEAVIEST-WINS",
        "text": {
          "ja": "報告は最も重い比較の結果を示す。不一致があれば、無効の比較があっても不一致になり、エラーと不一致がなければ未確定が無効より重い。",
          "en": "A report shows the heaviest comparison status: a mismatch wins over an invalid comparison, and without errors or mismatches unknown wins over invalid."
        },
        "terms": [
          "compare.report",
          "compare.mismatch",
          "compare.invalid",
          "search.unknown"
        ],
        "claims": [
          {
            "model": "spec/models/roracle-report.model",
            "check": "InvalidHiddenByMismatch",
            "expect": "reachable"
          },
          {
            "model": "spec/models/roracle-report.model",
            "check": "UnknownOverInvalid",
            "expect": "holds"
          }
        ]
      },
      {
        "id": "ORACLE-INVALID-IS-NOT-MISMATCH",
        "text": {
          "ja": "無効の比較は、不一致の比較がない限り、報告を不一致にしない。",
          "en": "An invalid comparison does not make the report a mismatch unless some comparison mismatched."
        },
        "terms": [
          "compare.invalid",
          "compare.mismatch",
          "compare.report"
        ],
        "claims": [
          {
            "model": "spec/models/roracle-report.model",
            "check": "InvalidNotMismatch",
            "expect": "holds"
          }
        ]
      },
      {
        "id": "ORACLE-FAILURES-FIRST",
        "text": {
          "ja": "基準か実装の観測が未確定・無効・エラーなら、比較は一致にならず、エラーがあれば必ずエラーになる。",
          "en": "If the reference or actual observation is unknown, invalid or an error, the comparison never matches, and any error makes it an error."
        },
        "terms": [
          "compare.observation",
          "compare.error",
          "search.unknown",
          "compare.invalid"
        ],
        "claims": [
          {
            "model": "spec/models/roracle-compare.model",
            "check": "FailureNeverMatched",
            "expect": "holds"
          },
          {
            "model": "spec/models/roracle-compare.model",
            "check": "ErrorDominates",
            "expect": "holds"
          }
        ]
      },
      {
        "id": "ORACLE-ACTUAL-IS-A-VALUE",
        "text": {
          "ja": "一致するのは実装の観測が値のときだけ。どちらの観測も未確定・無効・エラーでないとき、実装が許容値の集合を返したら、比較は無効。",
          "en": "A comparison matches only when the actual observation is a value. When neither observation is unknown, invalid or an error, an actual allowed set makes it invalid."
        },
        "terms": [
          "compare.actual",
          "compare.value",
          "compare.allowed",
          "compare.invalid"
        ],
        "claims": [
          {
            "model": "spec/models/roracle-compare.model",
            "check": "MatchedNeedsActualValue",
            "expect": "holds"
          },
          {
            "model": "spec/models/roracle-compare.model",
            "check": "ActualAllowedIsInvalid",
            "expect": "holds"
          }
        ]
      },
      {
        "id": "ORACLE-ALLOWED-SETS",
        "text": {
          "ja": "どちらの観測も未確定・無効・エラーでないとき、基準が許容値の集合なら、含まれる値は一致、含まれない値は不一致で、空の集合との比較は無効。",
          "en": "When neither observation is unknown, invalid or an error, a member of a reference allowed set matches, a non-member mismatches, and comparing with an empty set is invalid."
        },
        "terms": [
          "compare.allowed",
          "compare.reference",
          "compare.mismatch",
          "compare.invalid"
        ],
        "claims": [
          {
            "model": "spec/models/roracle-compare.model",
            "check": "EmptyAllowedIsInvalid",
            "expect": "reachable"
          },
          {
            "model": "spec/models/roracle-compare.model",
            "check": "AllowedMismatch",
            "expect": "reachable"
          }
        ]
      },
      {
        "id": "ORACLE-EMPTY-IS-INVALID",
        "text": {
          "ja": "比較が 1 つもない報告は無効。",
          "en": "A report without comparisons is invalid."
        },
        "terms": [
          "compare.report",
          "compare.invalid"
        ],
        "claims": [
          {
            "model": "spec/models/roracle-report.model",
            "check": "EmptyIsInvalid",
            "expect": "reachable"
          }
        ]
      }
    ],
