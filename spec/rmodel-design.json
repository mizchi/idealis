    "rules": [
      {
        "id": "RMODEL-SEMANTICS",
        "text": {
          "ja": "採用した版には意味の一致が必要。差異、空、探索未完了、比較相手の欠落は、ゴールが改善しても一致として扱わない。",
          "en": "Adoption requires semantic equivalence. Divergence, an empty check, incomplete search and a missing comparison do not count as equivalence even when the goal improves."
        },
        "terms": [
          "adoption",
          "semantic-evidence",
          "goal-evidence",
          "adopt"
        ],
        "claims": [
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "AdoptionNeedsEquivalence",
            "expect": "holds"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "ImprovedButDiverges",
            "expect": "reachable"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "ImprovedButEmpty",
            "expect": "reachable"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "ImprovedButIncomplete",
            "expect": "reachable"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "ImprovedButMissingComparison",
            "expect": "reachable"
          }
        ]
      },
      {
        "id": "RMODEL-GOAL",
        "text": {
          "ja": "採用した版にはゴールの改善が必要。意味だけが一致した版は評価中にでき、意味の一致とゴールの改善がそろった版は採用に進める。",
          "en": "Adoption requires goal improvement. Equivalence alone can leave a trial open, and a trial with both kinds of favorable evidence can be adopted."
        },
        "terms": [
          "adoption",
          "goal-evidence",
          "semantic-evidence",
          "adopt"
        ],
        "claims": [
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "AdoptionNeedsImprovement",
            "expect": "holds"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "EquivalentButUnmeasured",
            "expect": "reachable"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "SupportedAdoption",
            "expect": "reachable"
          }
        ]
      },
      {
        "id": "RMODEL-REVISION",
        "text": {
          "ja": "改版した候補は評価中になり、旧版で集めた意味とゴールの証拠を取り直す。",
          "en": "A new revision re-enters trial status and requires fresh semantic and goal evidence."
        },
        "terms": [
          "adoption",
          "semantic-evidence",
          "goal-evidence",
          "revise"
        ],
        "claims": [],
        "unformalized": "遷移の前後を比較する条件は、calibration.rs の the_next_revision_must_collect_new_evidence が参照評価器で検査する。"
      },
      {
        "id": "RMODEL-SWAP",
        "text": {
          "ja": "入れ替え例では左と右を遷移前の値から同時に更新する。二つの値は異なり続け、入れ替え後の状態に到達でき、両方が On の状態には到達しない。代入しない変数 update は Off のままにする。",
          "en": "The example swaps left and right simultaneously using the old state. The values remain distinct, the swapped state is reachable, both On is unreachable, and the unassigned variable update stays Off."
        },
        "terms": [
          "swap",
          "toggle-value",
          "toggle-state"
        ],
        "claims": [
          {
            "model": "spec/models/rmodel-behavior.model",
            "check": "Distinct",
            "expect": "holds"
          },
          {
            "model": "spec/models/rmodel-behavior.model",
            "check": "Swapped",
            "expect": "reachable"
          },
          {
            "model": "spec/models/rmodel-behavior.model",
            "check": "BothOn",
            "expect": "unreachable"
          },
          {
            "model": "spec/models/rmodel-behavior.model",
            "check": "PreservesUpdate",
            "expect": "holds"
          }
        ]
      },
      {
        "id": "RMODEL-ENTITY",
        "text": {
          "ja": "個体型の宣言を型と用語の正本とする。同じ名前を二重に宣言した場合や存在しない型を参照した場合は拒否する。用語の説明は IR、Rust と TypeScript の型、用語集へ引き継ぐ。",
          "en": "The entity declaration defines both its type and its term. Duplicate names and unknown type references are rejected. The definition carries through the IR, the Rust and TypeScript types, and the glossary."
        },
        "terms": [
          "entity"
        ],
        "claims": [],
        "unformalized": "名前解決と生成物は rmodel の entity.rs、IR の往復は rcheck の ir.rs、生成した型を使う入出金の照合は rcheck の domain.rs と typescript.rs で検査する。"
      },
      {
        "id": "RMODEL-DEAD-CODE",
        "text": {
          "ja": "ガードの成立例があれば到達可能とする。成立例なしをデッドと呼べるのは、初期状態が存在し、探索が完了したとき。探索の予算切れや範囲逸脱、初期状態なしは区別する。",
          "en": "A guard witness makes an action reachable. An action with no witness is dead only after a complete search with an initial state. Exhausted budgets, scope exits and empty models have distinct treatment."
        },
        "terms": [
          "dead-behavior"
        ],
        "claims": [],
        "unformalized": "操作の到達結果と完了状態の区別は rcheck の CLI テスト dead_code.rs で実行する。"
      },
      {
        "id": "RMODEL-LEAN-ORACLE",
        "text": {
          "ja": "完全探索した非空の範囲に限り、各設定・状態に Lean の命題を照合できる。偽ならその観測を返し、探索が未完了または Lean の出力が不正なら区別して扱う。",
          "en": "A Lean proposition can be checked over each configuration and state after a complete nonempty search. A false result identifies the observation, separately from incomplete exploration or an invalid response."
        },
        "terms": [
          "snapshot-oracle"
        ],
        "claims": [],
        "unformalized": "別プロセスとの照合と失敗の区別を rcheck の lean_oracle.rs で検査する。"
      }
    ],
