    "rules": [
      {
        "id": "RMODEL-SEMANTICS",
        "text": {
          "ja": "採用した版には意味の一致が必要。差異、空、探索未完了、比較相手の欠落は、ゴールが改善しても一致として扱わない。",
          "en": "Adoption requires semantic equivalence. Divergence, an empty check, incomplete search and a missing comparison do not count as equivalence even when the goal improves."
        },
        "terms": [
          "adoption",
          "semantic-evidence",
          "goal-evidence",
          "adopt"
        ],
        "claims": [
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "AdoptionNeedsEquivalence",
            "expect": "holds"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "ImprovedButDiverges",
            "expect": "reachable"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "ImprovedButEmpty",
            "expect": "reachable"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "ImprovedButIncomplete",
            "expect": "reachable"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "ImprovedButMissingComparison",
            "expect": "reachable"
          }
        ]
      },
      {
        "id": "RMODEL-GOAL",
        "text": {
          "ja": "採用した版にはゴールの改善が必要。意味だけが一致した版は評価中にでき、意味の一致とゴールの改善がそろった版は採用に進める。",
          "en": "Adoption requires goal improvement. Equivalence alone can leave a trial open, and a trial with both kinds of favorable evidence can be adopted."
        },
        "terms": [
          "adoption",
          "goal-evidence",
          "semantic-evidence",
          "adopt"
        ],
        "claims": [
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "AdoptionNeedsImprovement",
            "expect": "holds"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "EquivalentButUnmeasured",
            "expect": "reachable"
          },
          {
            "model": "spec/models/rmodel-calibration.model",
            "check": "SupportedAdoption",
            "expect": "reachable"
          }
        ]
      },
      {
        "id": "RMODEL-REVISION",
        "text": {
          "ja": "改版した候補は評価中になり、旧版で集めた意味とゴールの証拠を取り直す。",
          "en": "A new revision re-enters trial status and requires fresh semantic and goal evidence."
        },
        "terms": [
          "adoption",
          "semantic-evidence",
          "goal-evidence",
          "revise"
        ],
        "claims": [],
