// The ubiquitous language of idealis itself: what its engines report and
// how its models are built (plan 0092). Each term lists the symbols the
// crates use for it, so a crate that drifts from the shared meaning is
// found against one definition.
import "Schema.pkl" as s

local ralloy = "crates/ralloy/src/lib.rs"
local rtlc = "crates/rtlc/src/safety.rs"
local roracle = "crates/roracle/src/report.rs"
local rmodel = "crates/rmodel/src/syntax.rs"
local report = "spec/models/roracle-report.model"
local compare = "spec/models/roracle-compare.model"

spec: s.Spec = new {
  id = "idealis"
  name = s.text("idealis の語彙", "The idealis vocabulary")
  groups { "探索の範囲"; "判定"; "比較"; "モデル" }
  terms {
    new {
      id = "search.complete"
      kind = "result"
      group = "探索の範囲"
      name = s.text("完全", "complete")
      definition = s.text(
        "宣言した scope と上限の中で、到達できる状態や候補をすべて調べ終えたこと。その範囲の外については何も示さない。",
        "Every reachable state or candidate within the declared scope and bounds was examined. It says nothing outside that range.",
      )
      avoid { "証明済み"; "proved" }
      code { s.code(rtlc, "complete") }
    }
    new {
      id = "search.bounded"
      kind = "result"
      group = "探索の範囲"
      name = s.text("有界", "bounded")
      definition = s.text(
        "深さ・steps・状態数・work などの上限で探索を打ち切り、調べた部分に違反がなかったこと。どの上限かは理由（rtlc の reason）で示す。上限の外は調べていないので、完全な検査として扱わない。",
        "The search stopped at a depth, step, state-count, work or similar bound with no violation in the part examined; the reason (rtlc's reason) names the bound. Nothing beyond it was examined, so it is not a complete check.",
      )
      avoid { "完全"; "網羅"; "exhaustive" }
      code { s.code(rtlc, "bounded"); s.code(ralloy, "steps") }
    }
    new {
      id = "search.empty"
      kind = "result"
      group = "探索の範囲"
      name = s.text("空", "empty")
      definition = s.text(
        "初期状態や候補が 1 つもなく、検査する対象がなかったこと。合格ではない。",
        "There was no initial state or candidate, so nothing was checked. It is not a pass.",
      )
      code { s.code(rtlc, "empty") }
    }
    new {
      id = "search.unknown"
      kind = "result"
      group = "探索の範囲"
      name = s.text("未確定", "unknown")
      definition = s.text(
        "予算が尽きて、実例・反例の有無という判定そのものを出せなかったこと。合格にも不合格にも読み替えない。work の予算切れは、ralloy では unknown、rtlc では理由 work の bounded になる（0092 で記録した語の違い）。",
        "A budget ran out before the verdict itself, whether an instance or counterexample exists, could be given. It is read as neither a pass nor a failure. Running out of work is unknown in ralloy and bounded with reason work in rtlc (a difference in wording recorded in 0092).",
      )
      model { s.model(report, "Unknown"); s.model(compare, "Unknown"); s.model(compare, "UnknownObservation") }
      code { s.code(ralloy, "Unknown"); s.code(roracle, "Unknown") }
    }
    new {
      id = "verdict.instance"
      kind = "verdict"
      group = "判定"
      name = s.text("実例", "instance")
      definition = s.text(
        "run の条件と事実を満たす構造（時相モデルでは trace）が scope の中に見つかったこと。",
        "A structure, or a trace in a temporal model, within the scope satisfies the facts and the run's condition.",
      )
      code { s.code(ralloy, "Instance") }
    }
    new {
      id = "verdict.counterexample"
      kind = "verdict"
      group = "判定"
      name = s.text("反例", "counterexample")
      definition = s.text(
        "事実を満たしながら、検査する性質を破る構造または trace が scope の中に見つかったこと。",
        "A structure or trace within the scope satisfies the facts and violates the checked property.",
      )
      code { s.code(ralloy, "Counterexample") }
    }
    new {
      id = "verdict.no-counterexample"
      kind = "verdict"
      group = "判定"
      name = s.text("反例なし", "no counterexample")
      definition = s.text(
        "scope の中に反例がなかったこと。scope の外で性質が成り立つことの証明ではない。",
        "No counterexample exists within the scope. It does not prove the property beyond the scope.",
      )
      avoid { "正しい"; "検証済み"; "verified" }
      code { s.code(ralloy, "NoCounterexample") }
    }
    new {
      id = "verdict.holds"
      kind = "verdict"
      group = "判定"
      name = s.text("成り立つ", "holds")
      definition = s.text(
        "invariant が、検査した範囲で到達できるすべての状態で成り立つこと。範囲が有界か完全かを併せて示す。",
        "An invariant is true in every reachable state within the checked range, which is stated as bounded or complete.",
      )
    }
    new {
      id = "verdict.violated"
      kind = "verdict"
      group = "判定"
      name = s.text("破れる", "violated")
      definition = s.text(
        "invariant が偽になる状態に到達できること。到達する trace が witness になる。",
        "A state where an invariant is false is reachable; the trace reaching it is the witness.",
      )
    }
    new {
      id = "verdict.reachable"
      kind = "verdict"
      group = "判定"
      name = s.text("到達できる", "reachable")
      definition = s.text(
        "reachable の条件を満たす状態に、初期状態から到達できること。",
        "A state satisfying a reachable check's condition can be reached from an initial state.",
      )
    }
    new {
      id = "verdict.unreachable"
      kind = "verdict"
      group = "判定"
      name = s.text("到達できない", "unreachable")
      definition = s.text(
        "検査した範囲では、reachable の条件を満たす状態に到達できないこと。範囲が有界か完全かを併せて示す。",
        "Within the checked range no state satisfying a reachable check's condition is reachable; the range is stated as bounded or complete.",
      )
    }
    new {
      id = "compare.matched"
      kind = "result"
      group = "比較"
      name = s.text("一致", "matched")
      definition = s.text(
        "実装や engine の観測が、基準（oracle やモデル）の答えと同じだったこと。",
        "An observation of an implementation or engine equals the reference answer of an oracle or model.",
      )
      model { s.model(report, "Matched"); s.model(compare, "Matched") }
      code { s.code(roracle, "Matched"); s.code(ralloy, "Matched") }
    }
    new {
      id = "compare.mismatch"
      kind = "result"
      group = "比較"
      name = s.text("不一致", "mismatch")
      definition = s.text(
        "観測は正しく取れたうえで、基準の答えと異なったこと。",
        "The observation was obtained correctly and differs from the reference answer.",
      )
      model { s.model(report, "Mismatch"); s.model(compare, "Mismatch") }
      code { s.code(roracle, "Mismatch"); s.code(ralloy, "Mismatch") }
    }
    new {
      id = "compare.invalid"
      kind = "result"
      group = "比較"
      name = s.text("無効", "invalid")
      definition = s.text(
        "入力や観測が契約を満たさず、比較そのものが成立しなかったこと。不一致とは区別する。",
        "An input or observation breaks its contract, so no comparison took place. It is distinct from a mismatch.",
      )
      model { s.model(report, "Invalid"); s.model(compare, "Invalid"); s.model(compare, "InvalidObservation") }
      code { s.code(roracle, "Invalid"); s.code(ralloy, "Invalid") }
    }
    new {
      id = "compare.error"
      kind = "result"
      group = "比較"
      name = s.text("エラー", "error")
      definition = s.text(
        "実装・oracle・基盤が失敗して、比較する観測そのものが得られなかったこと。不一致とも未確定とも区別する。",
        "The implementation, oracle or infrastructure failed, so there was no observation to compare. It is distinct from a mismatch and from unknown.",
      )
      model { s.model(report, "Error"); s.model(compare, "Error"); s.model(compare, "ErrorObservation") }
      code { s.code(roracle, "Error") }
    }
    new {
      id = "compare.status"
      kind = "concept"
      group = "比較"
      name = s.text("比較の結果", "comparison status")
      definition = s.text(
        "1 つの比較が一致・不一致・無効・未確定・エラーのどれだったか。",
        "Whether one comparison matched, mismatched, was invalid, unknown or an error.",
      )
      model {
        s.model(report, "Status")
        s.model(report, "status")
        s.model(compare, "Outcome")
        s.model(compare, "outcome")
      }
      code { s.code(roracle, "Status") }
    }
    new {
      id = "compare.observation"
      kind = "concept"
      group = "比較"
      name = s.text("観測", "observation")
      definition = s.text(
        "実装や oracle から得た 1 回分の答え。値・許容値の集合・未確定・無効・エラーのいずれか。",
        "One answer from an implementation or oracle: a value, an allowed set, unknown, invalid or an error.",
      )
      model { s.model(compare, "Observed") }
      code { s.code(roracle, "Observation") }
    }
    new {
      id = "compare.value"
      kind = "concept"
      group = "比較"
      name = s.text("値", "value")
      definition = s.text(
        "正しく得られた観測の中身。基準の値とは等しさで比べる。",
        "The content of an observation obtained correctly, compared with a reference value for equality.",
      )
      model { s.model(compare, "ValueOf"); s.model(compare, "Value") }
      code { s.code(roracle, "Value") }
    }
    new {
      id = "compare.allowed"
      kind = "concept"
      group = "比較"
      name = s.text("許容値の集合", "allowed set")
      definition = s.text(
        "基準が 1 つの値に決まらないときに、受け入れる値をすべて並べたもの。空の集合とは比較が成立しない。",
        "Every value accepted when the reference is not a single value. Nothing can be compared with an empty set.",
      )
      model { s.model(compare, "AllowedSet") }
      code { s.code(roracle, "Allowed") }
    }
    new {
      id = "compare.reference"
      kind = "concept"
      group = "比較"
      name = s.text("基準の観測", "reference observation")
      definition = s.text(
        "比較の基準になる、oracle やモデルの観測。",
        "The observation of an oracle or model that a comparison is measured against.",
      )
      model {
        s.model(compare, "referenceKind")
        s.model(compare, "referenceValue")
        s.model(compare, "referenceAllowed")
      }
      code { s.code(roracle, "reference") }
    }
    new {
      id = "compare.actual"
      kind = "concept"
      group = "比較"
      name = s.text("実装の観測", "actual observation")
      definition = s.text(
        "検査する実装から得た観測。値でなければ一致にならない。",
        "The observation from the implementation under test. It never matches unless it is a value.",
      )
      model {
        s.model(compare, "actualKind")
        s.model(compare, "actualValue")
        s.model(compare, "actualAllowed")
      }
      code { s.code(roracle, "actual") }
    }
    new {
      id = "compare.slot"
      kind = "concept"
      group = "比較"
      name = s.text("比較の枠", "comparison slot")
      definition = s.text(
        "モデルで比較の数を変えるための枠。結果を持つ枠だけが比較になる。",
        "A slot that lets a model vary the number of comparisons; only slots with a status are comparisons.",
      )
      model { s.model(report, "Slot") }
    }
    new {
      id = "compare.report"
      kind = "concept"
      group = "比較"
      name = s.text("報告の結果", "report status")
      definition = s.text(
        "比較の結果を 1 つにまとめた結果。最も重いものを示し、重い順にエラー・不一致・未確定・無効・一致。比較が 1 つもなければ無効。",
        "The comparison statuses folded into one: the heaviest, in the order error, mismatch, unknown, invalid, matched. With no comparison it is invalid.",
      )
      model { s.model(report, "report") }
      code { s.code(roracle, "CheckReport"); s.code(roracle, "aggregate") }
    }
    new {
      id = "compare.oracle"
      kind = "concept"
      group = "比較"
      name = s.text("oracle", "oracle")
      definition = s.text(
        "比較の基準にする、別の道具（Alloy・TLC・Z3 など）の答え。記録して再生し、記録時の版と入力の digest を残す。",
        "The reference answer from another tool such as Alloy, TLC or Z3, recorded and replayed with the tool version and input digests.",
      )
      code { s.code(roracle, "Status") }
    }
    new {
      id = "model.configuration"
      kind = "concept"
      group = "モデル"
      name = s.text("設定", "configuration")
      definition = s.text(
        "状態とともに変わらない関係（rmodel の rel）。solver はすべての候補を考え、明示状態の探索は初期状態で列挙する。",
        "Relations that do not change with the state (rel in rmodel). A solver considers every candidate; the explicit search enumerates them in the initial states.",
      )
      code { s.code(rmodel, "Relation") }
    }
    new {
      id = "model.state"
      kind = "concept"
      group = "モデル"
      name = s.text("状態", "state")
      definition = s.text(
        "action によって変わる関係（rmodel の var、Alloy の var field）の、ある時点の値。",
        "The value at one point in time of the relations actions change (var in rmodel, var fields in Alloy).",
      )
      code { s.code(rmodel, "var") }
    }
    new {
      id = "model.action"
      kind = "concept"
      group = "モデル"
      name = s.text("action", "action")
      definition = s.text(
        "状態を変える遷移。条件と代入を持ち、代入しない状態は変わらない（暗黙の frame）。",
        "A transition that changes the state, with guards and assignments; state it does not assign is unchanged (the implicit frame).",
      )
      code { s.code(rmodel, "Action") }
    }
    new {
      id = "model.trace"
      kind = "concept"
      group = "モデル"
      name = s.text("trace", "trace")
      definition = s.text(
        "初期状態から始まる状態の列。有界な検査では、最後の状態から戻る位置を持つ lasso として表す。",
        "A sequence of states from an initial one. Bounded checks represent it as a lasso whose last state goes back to an earlier position.",
      )
      aliases { "lasso" }
      code { s.code(ralloy, "trace"); s.code(ralloy, "back") }
    }
    new {
      id = "model.witness"
      kind = "concept"
      group = "モデル"
      name = s.text("witness", "witness")
      definition = s.text(
        "判定を裏付ける具体的な実例・反例・trace。engine とは独立した評価器で検査し直せるもの。",
        "A concrete instance, counterexample or trace backing a verdict, which an evaluator independent of the engine can check again.",
      )
      code { s.code(ralloy, "check_instance") }
    }
    new {
      id = "model.scope"
      kind = "concept"
      group = "モデル"
      name = s.text("scope", "scope")
      definition = s.text(
        "検査する atom の数・整数の bit 幅・steps などの範囲。判定はすべてこの範囲についてのもの。",
        "The range checked: atom counts, integer bit width, steps. Every verdict is about this range.",
      )
      code { s.code(ralloy, "Scope"); s.code(rmodel, "Scope") }
    }
  }
  rules {
    new {
      id = "ORACLE-NO-FALSE-MATCH"
      text = s.text(
        "報告が一致になるのは、比較が 1 つ以上あり、そのすべてが一致したときだけ。未確定の比較があれば一致にならない。",
        "A report is matched only when there is at least one comparison and every one matched; an unknown comparison keeps it from being matched.",
      )
      terms { "compare.report"; "compare.matched"; "search.unknown" }
      claims { s.claim(report, "MatchedOnlyIfAllMatched", "holds"); s.claim(report, "UnknownNeverMatched", "holds") }
    }
    new {
      id = "ORACLE-HEAVIEST-WINS"
      text = s.text(
        "報告は最も重い比較の結果を示す。不一致があれば、無効の比較があっても不一致になり、エラーと不一致がなければ未確定が無効より重い。",
        "A report shows the heaviest comparison status: a mismatch wins over an invalid comparison, and without errors or mismatches unknown wins over invalid.",
      )
      terms { "compare.report"; "compare.mismatch"; "compare.invalid"; "search.unknown" }
      claims { s.claim(report, "InvalidHiddenByMismatch", "reachable"); s.claim(report, "UnknownOverInvalid", "holds") }
    }
    new {
      id = "ORACLE-INVALID-IS-NOT-MISMATCH"
      text = s.text(
        "無効の比較は、不一致の比較がない限り、報告を不一致にしない。",
        "An invalid comparison does not make the report a mismatch unless some comparison mismatched.",
      )
      terms { "compare.invalid"; "compare.mismatch"; "compare.report" }
      claims { s.claim(report, "InvalidNotMismatch", "holds") }
    }
    new {
      id = "ORACLE-FAILURES-FIRST"
      text = s.text(
        "基準か実装の観測が未確定・無効・エラーなら、比較は一致にならず、エラーがあれば必ずエラーになる。",
        "If the reference or actual observation is unknown, invalid or an error, the comparison never matches, and any error makes it an error.",
      )
      terms { "compare.observation"; "compare.error"; "search.unknown"; "compare.invalid" }
      claims { s.claim(compare, "FailureNeverMatched", "holds"); s.claim(compare, "ErrorDominates", "holds") }
    }
    new {
      id = "ORACLE-ACTUAL-IS-A-VALUE"
      text = s.text(
        "一致するのは実装の観測が値のときだけ。実装が許容値の集合を返したら、比較は無効。",
        "A comparison matches only when the actual observation is a value; an actual allowed set makes it invalid.",
      )
      terms { "compare.actual"; "compare.value"; "compare.allowed"; "compare.invalid" }
      claims { s.claim(compare, "MatchedNeedsActualValue", "holds"); s.claim(compare, "ActualAllowedIsInvalid", "holds") }
    }
    new {
      id = "ORACLE-ALLOWED-SETS"
      text = s.text(
        "基準が許容値の集合なら、含まれる値は一致、含まれない値は不一致。空の集合との比較は無効。",
        "Against an allowed set, a member matches and a non-member mismatches; comparing with an empty set is invalid.",
      )
      terms { "compare.allowed"; "compare.reference"; "compare.mismatch"; "compare.invalid" }
      claims { s.claim(compare, "EmptyAllowedIsInvalid", "reachable"); s.claim(compare, "AllowedMismatch", "reachable") }
    }
    new {
      id = "ORACLE-EMPTY-IS-INVALID"
      text = s.text("比較が 1 つもない報告は無効。", "A report without comparisons is invalid.")
      terms { "compare.report"; "compare.invalid" }
      claims { s.claim(report, "EmptyIsInvalid", "reachable") }
    }
  }
  groundings {
    new {
      model = compare
      implementation = s.code(roracle, "compare")
      test = s.code("crates/rspec/tests/grounding.rs", "compare_conforms_to_the_compare_model")
    }
    new {
      model = report
      implementation = s.code(roracle, "aggregate")
      test = s.code("crates/rspec/tests/grounding.rs", "aggregate_conforms_to_the_report_model")
    }
  }
}
