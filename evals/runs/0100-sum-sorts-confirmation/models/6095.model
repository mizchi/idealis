model G6095
sig S0
sig S1
rel r0: one S0
rel r1: some S1
var v2: S1 -> set S1
fact { ((some (S0 - S0) and some r1) or (some ((r1 -> r0).((r0 -> r1).r1)) implies one (r1.((S1 -> r1).(S1 -> S1))))) }
init { (all q3: S0 | (v2 - v2) = v2) }
action a0() {
  (all q4: S1 | #((q4 -> S0).r0) >= 3)
  (some (r0.(r0 -> r1)) or #(S0 + S0) != 2)
  v2' = (((S1 -> S0).r0) -> S1)
}
action a1(p1_0: S1) {
  some ((S1 -> r0).r0)
  v2' = v2
}
action a2() {
  (all q5: S1 | ((r0 -> r1).(S1 -> r0)) in (r0 -> S0))
  v2' = (((r1 -> S0).r0) -> (v2.S1))
}
invariant Inv { (not (((r0 -> S0) in (r0 -> r0) implies (r1 -> r1) in (S1 -> S1))) implies (((v2.r1) - ((r1 -> S0).r0)) != S1 and S1 = (S1.v2))) }
reachable Goal { ((some q6: S1 | #((r1 -> r0).S0) < 1) and some ((v2.(S1 -> r1)).r1)) }
scope S0 = 2, S1 = 3, steps = 6
