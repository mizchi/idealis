model G6083
sig S0
rel r0: S0 -> lone S0
var v1: S0 -> one S0
var v2: lone S0
fact { some ((S0.r0).(r0.r0)) }
init { not (((S0.r0).v1) != S0) }
action a0() {
  some (v1.S0)
  no (r0.((v2 -> v2).S0))
  v2' = ((v2.r0) - (none + v2))
}
action a1() {
  r0 = ((S0 -> S0).(S0 -> v2))
  ((v2 -> S0) = (S0 -> S0) implies some v2)
  v2' = ((r0 & r0).S0)
}
invariant Inv { (v2 in S0 and some ((r0 + v1).S0)) }
reachable Goal { (all q1: S0 | (all q2: S0 | (v1 = ((v2 -> S0) - v1) and q2 = S0))) }
scope S0 = 3, steps = 6
