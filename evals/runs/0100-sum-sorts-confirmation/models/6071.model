model G6071
sig S0
sig S1
type P = S0 + S1
var v0: lone P
var v1: P -> some S0
init { (some v0 and (P -> S0) = (P -> S0)) }
action a0(p0_0: S0, p0_1: S1) {
  (#(P & S0) < 1 or one S1)
  v1' = v1
}
invariant Inv { (((some (S1.(S1 -> S1)) or one ((S0.(S0 -> S1)).((S1 -> S0).(S0 -> S1)))) or S0 not in S0) or ((S1 = ((S1 + S1).((S1 -> S1) - (S1 -> S1))) and #v0 >= 1) or (S1 != ((S1 -> S1).S1) implies some v0))) }
reachable Goal { #v0 >= 2 }
scope S0 = 3, S1 = 3, steps = 6
