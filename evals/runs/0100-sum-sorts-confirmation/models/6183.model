model G6183
sig S0
enum E = Ea | Eb
rel r0: S0 -> set S0
rel r1: lone S0
var v2: S0 -> set S0
init { some (S0.v2) }
action a0(p0_0: E, p0_1: E) {
  (#S0 < 0 implies ((r1 -> Eb).(p0_1 -> p0_0)) in (r1 -> E))
  v2' = (v2.r0)
}
action a1(p1_0: S0, p1_1: S0) {
  (((v2.r1) & (E.(E -> p1_0))) != p1_0 or Ea not in ((Ea -> E).((E -> r1).p1_1)))
  v2' = ((r1 -> p1_1) - ((p1_1 -> p1_0) + v2))
}
invariant Inv { ((v2 = r0 or ((((r1 -> E).E) + S0) = none implies ((Ea -> r1) - (E -> S0)) in ((Ea -> S0) - (Ea -> r1)))) and some ((Eb -> Eb).Eb)) }
reachable Goal { (((((v2.r1) + (r1.r0)) not in S0 implies #(E.(Ea -> r1)) < 3) or (((S0 -> Eb).E) in ((v2.S0).((S0 -> S0).v2)) implies no (((S0 -> E).Ea).(r0.(S0 -> r1))))) and (all q5: S0 | no (q5.((q5 -> S0).(S0 -> Eb))))) }
scope S0 = 3, steps = 6
