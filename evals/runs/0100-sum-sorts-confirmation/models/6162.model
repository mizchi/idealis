model G6162
sig S0
rel r0: S0 -> one S0
var v1: S0 -> lone S0
fact { (all q1: S0 | not (q1 != (S0 + S0))) }
init { (S0.v1) != ((r0 + v1).S0) }
action a0(p0_0: S0, p0_1: S0) {
  v1' = r0
}
action a1() {
  v1' = (S0 -> (S0.(S0 -> S0)))
}
invariant Inv { (v1 & (S0 -> S0)) in ((S0 -> S0).r0) }
reachable Goal { (((one ((S0.r0) + (S0 & S0)) and ((S0 -> S0).v1) in v1) or (v1.(S0 + none)) = (S0.v1)) or (((S0 -> S0) = (r0 + r0) or ((v1.S0).(r0.v1)) != S0) or one S0)) }
scope S0 = 3, steps = 6
