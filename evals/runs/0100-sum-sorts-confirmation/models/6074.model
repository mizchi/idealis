model G6074
sig S0
enum E = Ea | Eb
type P = S0 + E
rel r0: S0 -> one P
var v1: one S0
var v2: E -> one S0
fact { #P > 2 }
init { ((E -> P) = ((Eb -> P) + (Ea -> P)) or some v1) }
action a0(p0_0: S0, p0_1: P) {
  v2' = (Eb -> (v1.(p0_0 -> p0_0)))
}
invariant Inv { v1 = (E.v2) }
reachable Goal { ((not ((((E -> P).P).((Ea -> S0).(v1 -> S0))) != ((v1.(S0 -> E)).(v2.(S0 -> v1)))) or not (#(v1.(v1 -> Eb)) >= 1)) or not (not ((Eb + (P.(P -> Eb))) not in ((E -> Eb).Eb)))) }
scope S0 = 2, steps = 6
