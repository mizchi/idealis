model G6082
sig S0
enum E = Ea | Eb
type P = S0 + E
var v0: P -> set S0
init { (lone (P.v0) implies some (E.(E -> S0))) }
action a0() {
  v0' = (((P -> P) - (P -> P)).(P -> S0))
}
action a1(p1_0: E, p1_1: E) {
  ((((Ea -> P) + (E -> P)).P) in p1_1 or some (P & E))
  v0' = ((P -> E).((Ea -> E).(E -> S0)))
}
action a2() {
  v0' = (P -> (Eb.(Ea -> S0)))
}
invariant Inv { (no ((E.(E -> P)) & E) or (((E - Ea) in (Eb - (Ea & Eb)) and #S0 < 2) or (one none or #(v0.S0) = 3))) }
reachable Goal { (((#S0 > 3 implies #S0 = 1) and not (lone E)) and ((some ((S0 -> S0).S0) and (v0.(S0 -> S0)) = v0) or (((S0 -> P).(P -> P)) in (S0 -> P) and ((S0 -> P).P) in S0))) }
scope S0 = 2, steps = 6
