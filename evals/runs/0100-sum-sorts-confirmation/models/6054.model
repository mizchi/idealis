model G6054
sig S0
rel r0: set S0
rel r1: some S0
var v2: S0 -> some S0
var v3: one S0
fact { (not (one ((S0 - S0).((S0 -> S0).(S0 -> r0)))) and ((S0 -> r1) = (S0 -> r0) implies some S0)) }
init { (v2 in (v2.(r0 -> S0)) and #r1 = 3) }
action a0(p0_0: S0, p0_1: S0) {
  v2' = (p0_1 -> p0_0)
}
action a1() {
  v3' = r0
}
invariant Inv { ((((r0 -> v3) = v2 implies some S0) implies (some q1: S0 | some S0)) and (not (((r0 + v3).(v2.v2)) in ((v2.S0).v2)) and (S0 & S0) = (r0.(r1 -> r1)))) }
reachable Goal { ((#(r1.(r0 -> r1)) <= 1 or (v2 + v2) = (S0 -> r0)) implies (#(v2.S0) <= 0 implies not ((v3 + r1) not in v3))) }
scope S0 = 3, steps = 6
