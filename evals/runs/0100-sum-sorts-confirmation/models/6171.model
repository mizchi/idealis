model G6171
sig S0
sig S1
rel r0: S1 -> set S0
rel r1: set S1
var v2: S0 -> some S1
fact { (all q1: S0 | ((r1 -> r1) in (r1 -> r1) and lone (S0.(q1 -> r1)))) }
init { not (v2 in v2) }
action a0(p0_0: S0, p0_1: S1) {
  S0 in ((p0_0 -> p0_0).S0)
  (lone r1 implies #S1 > 0)
  v2' = ((v2.r1) -> ((S1 -> p0_0).S0))
}
action a1(p1_0: S0, p1_1: S0) {
  v2' = v2
}
action a2(p2_0: S0) {
  (p2_0 = ((v2.S1).(S0 -> S0)) and no r1)
  (((p2_0 -> p2_0) - (S0 -> S0)) = (S0 -> S0) and p2_0 = p2_0)
  v2' = (p2_0 -> S1)
}
invariant Inv { ((all q6: S1 | one (r1.(r0 + r0))) implies ((some (S0.(S0 -> S1)) or some (S0 + S0)) or some ((r0.v2).((r1 -> S1).S1)))) }
reachable Goal { (((r1 -> S0) & r0) in (r0 - (r1 -> S0)) and not (((v2.r0) = ((S0 -> S0) + (S0 -> S0)) and lone (none & ((S0 -> S0).S0))))) }
scope S0 = 2, S1 = 1, steps = 6
