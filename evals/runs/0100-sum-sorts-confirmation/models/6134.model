model G6134
sig S0
rel r0: S0 -> lone S0
var v1: S0 -> lone S0
var v2: S0 -> one S0
fact { (some (r0.S0) implies (some q1: S0 | (q1 -> q1) in (q1 -> S0))) }
init { (((S0 -> S0) + v2).((S0 -> S0).S0)) in none }
action a0() {
  (lone (r0.S0) or #(S0 & S0) > 3)
  v2' = r0
}
action a1(p1_0: S0, p1_1: S0) {
  (some p1_1 or some (p1_1.v1))
  some p1_1
  v1' = r0
}
action a2(p2_0: S0, p2_1: S0) {
  #p2_1 != 1
  v2' = v1
}
invariant Inv { ((((S0 -> S0).(S0.v1)) in ((S0.v2).((S0 -> S0).(S0 -> S0))) or (#(r0.S0) > 3 or (r0.r0) = (S0 -> S0))) implies not (some ((v2.S0).(S0 -> S0)))) }
reachable Goal { (((some ((S0 - S0).v2) or no S0) implies (lone S0 and some (S0.(S0 -> S0)))) and S0 in ((v2.S0).v1)) }
scope S0 = 3, steps = 6
