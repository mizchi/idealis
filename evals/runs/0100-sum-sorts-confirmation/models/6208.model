model G6208
sig S0
rel r0: one S0
var v1: S0 -> some S0
var v2: S0 -> one S0
fact { (#S0 < 3 or (some (r0.(S0 -> S0)) implies some (r0.(r0 -> r0)))) }
init { not (v2 = (v1 - v2)) }
action a0() {
  ((S0 -> r0) - (r0 -> S0)) = (S0 -> r0)
  (#S0 = 0 or some (v1.S0))
  v2' = (v1 + (v1.v1))
}
action a1(p1_0: S0, p1_1: S0) {
  not (#r0 = 0)
  not (#p1_1 != 2)
  v1' = v2
}
invariant Inv { not ((some q1: S0 | (q1 in (v2.q1) or (((S0 -> q1).S0) + (v2.S0)) = r0))) }
reachable Goal { not (((#r0 < 3 or v2 = ((r0 -> S0) - v1)) and ((v1 + (S0 -> S0)) = (v1 - v1) and lone ((S0 - r0) - none)))) }
scope S0 = 3, steps = 6
