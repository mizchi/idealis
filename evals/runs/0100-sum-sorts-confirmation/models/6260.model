model G6260
sig S0
sig S1
enum E = Ea | Eb
rel r0: S1 -> some S0
rel r1: some S0
var v2: S0 -> lone S0
init { (some (S1.(S1 -> S1)) or v2 in (S0 -> r1)) }
action a0() {
  not ((S1 -> S1) in (S1 -> S1))
  v2' = (v2 - (r1 -> S0))
}
action a1() {
  (((S1 -> Eb) + (S1 -> Ea)) = (S1 -> Ea) and #r1 != 2)
  #S1 = 3
  v2' = (((r1 -> S1).r0) - (S0 -> S0))
}
invariant Inv { r1 != (((S0 -> S1).S1).v2) }
reachable Goal { (some q9: E | (((S0 -> S0) in v2 implies lone S0) implies (((q9 -> r1).(S0 -> S0)) in (q9 -> S0) implies #(S0.(r1 -> S1)) <= 1))) }
scope S0 = 3, S1 = 3, steps = 6
