model G6024
sig S0
sig S1
rel r0: S1 -> lone S1
var v1: S0 -> one S1
var v2: S1 -> set S1
fact { some (S0.(S0 -> S1)) }
init { (some q1: S1 | (S0 -> q1) in (v1 & (S0 -> q1))) }
action a0(p0_0: S1, p0_1: S1) {
  v1' = v1
}
invariant Inv { ((S1 -> S0) & (S1 -> S0)) = (v2.(S1 -> S0)) }
reachable Goal { not (((#(v1.S1) = 1 implies some ((S0 -> S1).S1)) or #S0 > 1)) }
scope S0 = 3, S1 = 3, steps = 6
