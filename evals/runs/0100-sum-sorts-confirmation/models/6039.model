model G6039
sig S0
sig S1
enum E = Ea | Eb
rel r0: one S1
rel r1: lone E
var v2: E -> some S1
fact { ((S1 -> Eb).r1) not in (((S0 -> S0).S0).(S0 -> r0)) }
init { (some (Ea.v2) or some S0) }
action a0() {
  (all q3: S1 | one S1)
  (no (((S0 -> S1).(S1 -> r0)).((r0 -> r0).r0)) and #((S1 -> S1).r0) != 0)
  v2' = (v2 + (v2 - v2))
}
action a1(p1_0: S1, p1_1: E) {
  not (no (((r0 -> p1_1).Ea).(r0 -> S0)))
  v2' = (((r1 -> p1_1).E) -> ((p1_0 -> S0).S0))
}
action a2(p2_0: S1, p2_1: E) {
  ((r1 -> r0) = v2 implies #((Ea -> S0).S0) > 1)
  v2' = v2
}
invariant Inv { (((some none and #(S1 + S1) != 1) implies (Eb -> r0) in (v2.(r0 -> r0))) implies (one (((Eb -> Ea).Eb).((Eb -> Eb) - (r1 -> Ea))) implies ((S0.(S0 -> S1)) - (S1 - S1)) = (S1.((r0 -> r0) - (S1 -> S1))))) }
reachable Goal { not (not (some (v2.(r0 - S1)))) }
scope S0 = 2, S1 = 2, steps = 6
