model G6285
sig S0
rel r0: S0 -> set S0
rel r1: S0 -> one S0
var v2: set S0
init { (some v2 or some (S0 & S0)) }
action a0(p0_0: S0, p0_1: S0) {
  v2' = S0
}
action a1() {
  v2' = (r0.(r0.S0))
}
action a2(p2_0: S0) {
  v2' = (r0.v2)
}
invariant Inv { ((r1 + (S0 -> v2)) = (S0 -> S0) or not ((no S0 and ((v2.r0).((v2 -> S0) & r1)) not in v2))) }
reachable Goal { (some v2 or ((S0 = ((S0.r1) - ((S0 -> S0).S0)) or (r1.(S0 -> S0)) = (v2 -> v2)) or ((v2 -> S0) in r0 implies ((S0 & S0).r1) not in ((r0.v2).(r1.r1))))) }
scope S0 = 3, steps = 6
