model G6123
sig S0
sig S1
enum E = Ea | Eb
rel r0: E -> some S0
rel r1: E -> some S0
var v2: set S0
var v3: E -> some S0
fact { ((E - E).r1) = ((S0 -> S1).(S1 + S1)) }
init { (some q2: S1 | (E.((Eb -> S1) & (E -> q2))) not in (v2.(S0 -> S1))) }
action a0(p0_0: S1) {
  v3' = v3
}
invariant Inv { ((((S0 -> Eb).(E -> S0)).v2) != (((v2 -> S1).(S1 -> S1)).((S1 -> E).E)) or (S1 - S1) != S1) }
reachable Goal { (some (v2.(S0 -> S1)) and not ((some q3: E | some (S1 & S1)))) }
scope S0 = 3, S1 = 2, steps = 6
