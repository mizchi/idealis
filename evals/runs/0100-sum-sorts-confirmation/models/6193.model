model G6193
sig S0
rel r0: some S0
rel r1: S0 -> set S0
var v2: S0 -> set S0
var v3: some S0
fact { some ((S0 -> S0).r0) }
init { r0 in (((S0 -> v3).v3) & (S0.r1)) }
action a0(p0_0: S0, p0_1: S0) {
  #p0_0 <= 1
  v3' = ((none & p0_0) + S0)
}
action a1(p1_0: S0) {
  not (v2 in ((v3 -> S0) + r1))
  (all q1: S0 | ((r0 & S0).v2) = ((q1 + S0) - (v2.p1_0)))
  v3' = v3
}
action a2() {
  lone ((v3 - v3).v2)
  v2' = (((r0 -> r0).S0) -> (v3.r1))
}
invariant Inv { (lone r0 or (((S0 + (v3.v2)) not in v3 and v2 = (r1 + v2)) and (v3 -> r0) in ((v3 -> r0) + v2))) }
reachable Goal { S0 not in ((v3 -> S0).(r0 - none)) }
scope S0 = 2, steps = 6
