model G6018
sig S0
sig S1
rel r0: lone S0
rel r1: set S1
var v2: S0 -> some S0
var v3: S0 -> lone S0
init { (#S1 > 3 implies (r0 + (r0.v3)) in ((r0 -> S1).(S1.(r1 -> r1)))) }
action a0(p0_0: S0, p0_1: S0) {
  (all q1: S0 | some S1)
  some (S1.(S1 -> S1))
  v2' = ((v2.v3) + (p0_0 -> p0_1))
}
action a1(p1_0: S1, p1_1: S0) {
  not (((v2 + (S0 -> S0)).(v3.S0)) not in p1_1)
  one r1
  v2' = (((r0 -> p1_0).(p1_0 -> S1)).(S1 -> r0))
}
action a2() {
  none = ((r0 -> S1).((r1 -> r1).r1))
  (all q2: S1 | ((r0 & r0) - (r0.v3)) != ((r0.v3).(v2.v3)))
  v3' = v2
}
invariant Inv { (v2.v2) in ((S0 -> S0).(S0 -> r0)) }
reachable Goal { ((v2.(S0 -> r1)) = (r0 -> r1) implies (v2 + v3) = (S0 -> S0)) }
scope S0 = 3, S1 = 3, steps = 6
