model G6177
sig S0
sig S1
var v0: S1 -> one S1
init { (v0.(none - S1)) not in ((S0.(S0 -> S0)).(S0 -> S1)) }
action a0() {
  v0' = ((S1 -> S1) + (v0.v0))
}
action a1(p1_0: S0) {
  no (S0.((S0 -> p1_0) + (p1_0 -> S0)))
  (one (S0.(p1_0 -> S1)) and #S1 <= 3)
  v0' = (S1 -> (v0.S1))
}
action a2(p2_0: S0, p2_1: S1) {
  (some S1 implies v0 = ((S1 -> S0).(S0 -> p2_1)))
  ((v0.(p2_1 -> S1)) in v0 and ((p2_1 -> S0).(p2_0 & p2_0)) != (((S0 -> p2_1).S1).(S0 -> S1)))
  v0' = ((p2_1 -> p2_0).(S0 -> p2_1))
}
invariant Inv { #(S1.v0) > 1 }
reachable Goal { ((S1 = S1 implies one ((S1.(S1 -> S0)).(S0 -> S0))) and not (some (v0.S1))) }
scope S0 = 1, S1 = 2, steps = 6
