model G6157
sig S0
var v0: S0 -> set S0
init { (v0 + (S0 -> S0)) in v0 }
action a0(p0_0: S0) {
  v0' = (p0_0 -> ((p0_0 -> p0_0).p0_0))
}
action a1() {
  not (v0 in (v0.v0))
  (all q1: S0 | lone ((v0.q1) & (S0 - q1)))
  v0' = (S0 -> S0)
}
action a2(p2_0: S0) {
  #(S0.(S0 -> p2_0)) != 1
  (#((p2_0 -> S0).S0) = 0 and some none)
  v0' = v0
}
invariant Inv { not ((S0 not in (S0.(v0 - (S0 -> S0))) implies S0 in (S0 & S0))) }
reachable Goal { ((one ((S0 -> S0).S0) or (#S0 != 2 and S0 != ((v0.v0).(S0.v0)))) or ((some S0 or v0 = (v0.v0)) and (S0 -> S0) in v0)) }
scope S0 = 2, steps = 6
