model G6295
sig S0
sig S1
enum E = Ea | Eb
type P = S0 + S1
rel r0: S1 -> lone S1
rel r1: some E
var v2: P -> lone S0
fact { (some q1: S0 | ((S0 -> E) = ((q1 -> r1) + (q1 -> Ea)) implies #(S1 - S1) > 0)) }
init { (some (((S1 -> P).v2).S0) and some ((S0 -> S1).S1)) }
action a0(p0_0: S0) {
  (p0_0 -> P) = (p0_0 -> P)
  (all q4: P | some S1)
  v2' = (P -> ((S0 -> E).Eb))
}
invariant Inv { ((some q5: S1 | (some ((S0 -> S1).S1) implies S0 in ((v2 + v2).((S0 -> q5).S1)))) or some (P.(P -> P))) }
reachable Goal { ((#((P -> r1).r1) < 3 implies not (#((S0 -> P).P) > 3)) implies (some S0 or S0 in ((P.v2) & S0))) }
scope S0 = 1, S1 = 2, steps = 6
