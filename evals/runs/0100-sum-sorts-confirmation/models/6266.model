model G6266
sig S0
rel r0: set S0
rel r1: S0 -> set S0
var v2: S0 -> set S0
var v3: set S0
fact { not (((r0 -> r0) = r1 and #(r0 + S0) != 0)) }
init { some v3 }
action a0(p0_0: S0, p0_1: S0) {
  v2' = v2
}
action a1(p1_0: S0) {
  v2' = r1
}
action a2(p2_0: S0, p2_1: S0) {
  one p2_0
  v2' = (p2_0 -> (v2.p2_1))
}
invariant Inv { ((not ((r0.(r0 -> S0)) != S0) and (one (r0.(v2.v2)) implies (v3 -> S0) = ((v3 -> v3).v2))) or not (not (some (r1.S0)))) }
reachable Goal { some (v3.(r0 -> r0)) }
scope S0 = 1, steps = 6
