model G6022
sig S0
sig S1
var v0: S0 -> set S0
var v1: S0 -> one S0
init { (lone (((S0 -> S1).(S1 -> S1)).(S1.(S1 -> S1))) implies no (S0 + (v0.S0))) }
action a0() {
  (some (S0.((S0 -> S0) - (S0 -> S0))) implies (S1 -> S0) = (S1 -> S0))
  ((none & none) & S1) != (S1 + ((S1 -> S0).S0))
  v1' = (S0 -> (S0.v1))
}
invariant Inv { ((all q2: S1 | ((q2.(q2 -> S0)) != ((S0 -> S0).S0) implies #(v0.S0) <= 3)) or (some q3: S1 | ((S1 -> q3).((q3 -> q3).q3)) != S1)) }
reachable Goal { ((some q4: S0 | one (S0.v0)) or (not (some (S0.v1)) implies #(S1 + S1) <= 0)) }
scope S0 = 2, S1 = 2, steps = 6
