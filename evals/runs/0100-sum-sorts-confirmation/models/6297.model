model G6297
sig S0
rel r0: S0 -> lone S0
rel r1: some S0
var v2: S0 -> one S0
init { (some q1: S0 | r1 = ((r1 -> r1).(q1.v2))) }
action a0() {
  (#(v2.r1) = 2 implies (v2.(r1 -> S0)) in (S0 -> r1))
  v2' = ((r0.(S0 -> r1)) - v2)
}
invariant Inv { (no ((S0 -> r1).(S0 + r1)) or ((((S0 -> S0) + r0) in r0 and some (S0.v2)) implies (some (v2.S0) implies some none))) }
reachable Goal { (v2.v2) in (v2.v2) }
scope S0 = 3, steps = 6
