model G6066
sig S0
sig S1
enum E = Ea | Eb
rel r0: S1 -> one E
rel r1: S0 -> set E
var v2: S0 -> lone S1
var v3: E -> lone E
fact { ((Eb.(Ea -> Eb)).(E -> S0)) in S0 }
init { (no ((E + Eb).v3) or #Eb > 3) }
action a0(p0_0: S0, p0_1: S1) {
  v2' = v2
}
action a1(p1_0: S0, p1_1: S0) {
  not (some Ea)
  v2' = ((p1_0 -> S0).(p1_0 -> S1))
}
action a2() {
  (some S1 implies (((S1 -> S1).(S1 -> S0)).(S0.(S0 -> S0))) != ((S1.(S1 -> S1)) + S1))
  (lone E and no ((none - S0) + S0))
  v3' = ((E -> Eb) + v3)
}
invariant Inv { (Eb -> Eb) = v3 }
reachable Goal { not (some (E.v3)) }
scope S0 = 3, S1 = 2, steps = 6
