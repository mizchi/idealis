@@ -27,3 +27,14 @@
 };
 pub use safety::{PreparedSafetyProgram, SafetyGraph};
 pub use value::{CoreError, Value};
+
+pub const PROBE_LIMIT: u16 = 4096;
+static PROBE_PEAK: std::sync::atomic::AtomicU16 = std::sync::atomic::AtomicU16::new(0);
+
+pub fn probe_peak() -> u16 {
+    PROBE_PEAK.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+pub(crate) fn probe_record(depth: u16) {
+    PROBE_PEAK.fetch_max(depth, std::sync::atomic::Ordering::Relaxed);
+}
