model G8287
sig S0
sig S1
enum E = Ea | Eb
type P = S0 + S1
rel r0: E -> some S1
rel r1: E -> set S0
var v2: E -> set S1
var v3: S0 -> one E
fact { ((S1 -> S0).S0) not in (((Ea -> P).P).(Eb -> S1)) }
init { some v2 }
action a0() {
  v2' = v2
}
action a1() {
  v2' = v2
}
action a2(p2_0: E) {
  S1 in S1
  v3' = (S0 -> Ea)
}
invariant Inv { ((P.(P -> S0)) = S0 or not ((#S1 != 2 implies ((S0 -> Ea).(Ea -> Eb)) in v3))) }
reachable Goal { ((r1 - r1).S0) != ((v2.S1) + (P.(P -> Ea))) }
scope S0 = 2, S1 = 3, steps = 6
