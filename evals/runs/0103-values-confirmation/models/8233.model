model G8233
sig S0
sig S1
rel r0: lone S1
var v1: S0 -> some S1
var v2: S0 -> one S0
record R { n: Int, b: Bool }
var w0: S0 -> one Bool
var w1: S0 -> one R
fact { (all q1: S1 | (((r0 - q1).(r0 -> r0)) = ((q1 -> S1).(S0.(S0 -> r0))) or #S0 < 1)) }
init { (S0 -> S1) in (v2.v1) }
init { all x: S0 | x.w0 = false }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (false)
}
action set1(x: S0, k: Int) {
  x.w1.n <= x.w1.n
  w1' = w1 - x -> x.w1 + x -> (R { n: x.w1.n, b: true })
}
action a0(p0_0: S0, p0_1: S1) {
  v1' = (S0 -> r0)
}
action a1(p1_0: S0) {
  lone (S1.(r0 -> S1))
  (#(p1_0.v2) != 2 implies no (((p1_0 -> r0).r0) + ((p1_0 -> r0).S1)))
  v1' = (p1_0 -> (S1.(r0 -> r0)))
}
invariant Inv { (lone (((S0 -> S1).S1).(v1 + (S0 -> r0))) implies not (((some q8: S0 | q8.w1.b) implies one ((S0.(S0 -> S1)) & r0)))) }
reachable Goal { (not ((some q10: S0 | (((S0 -> r0) & v1).(r0 & S1)) not in (S1.(S1 -> q10)))) and (some q11: S0 | q11.w1.b)) }
scope S0 = 2, S1 = 1, Int = 0..2, steps = 6
