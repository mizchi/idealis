model G8145
sig S0
sig S1
enum E = Ea | Eb
var v0: S0 -> lone S1
var w0: S0 -> one Int
var w1: S0 -> one Bool
init { (#Ea = 3 and (v0 & (S0 -> S1)) in (S0 -> S1)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
action set0(x: S0, k: Int) {
  x.w0 > k
  w0' = w0 - x -> x.w0 + x -> ((x.w0 - 1))
}
action set1(x: S0) {
  w1' = w1 - x -> x.w1 + x -> (false)
}
action a0(p0_0: S0) {
  #p0_0 > 0
  v0' = v0
}
invariant Inv { some v0 }
reachable Goal { (((some S1 or Ea not in (S1.((S1 -> Ea).(E -> Eb)))) implies (all q35: S0 | lone S0)) or ((#((S0 -> S0).S0) != 2 implies #(none - S1) > 1) or ((((S0 -> Ea).(Ea -> S0)).S0) != (S1.((S1 -> Ea).(E -> S0))) and v0 = ((S0 -> S1) & v0)))) }
scope S0 = 3, S1 = 2, Int = -1..2, steps = 6
