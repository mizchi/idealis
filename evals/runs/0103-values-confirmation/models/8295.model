model G8295
sig S0
var v0: some S0
var w0: S0 -> one Int
var w1: S0 -> one Bool
init { (v0 -> S0) = ((S0 -> S0).(v0 -> S0)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (#x)
}
action set1(x: S0) {
  w1' = w1 - x -> x.w1 + x -> (false)
}
action a0() {
  v0' = (S0 & (S0.(S0 -> v0)))
}
action a1(p1_0: S0, p1_1: S0) {
  v0' = v0
}
action a2() {
  v0' = S0
}
invariant Inv { (((S0.((S0 -> S0).(v0 -> v0))) not in (v0 & (v0 & v0)) or S0 not in (v0.(S0 -> S0))) implies (some q5: S0 | q5.w1)) }
reachable Goal { (one (((v0 -> S0).S0).(S0 -> S0)) and ((some q6: S0 | q6.w1) and (all q7: S0 | (q7.w0 + #v0) <= (#S0 * 1)))) }
scope S0 = 3, Int = -1..2, steps = 6
