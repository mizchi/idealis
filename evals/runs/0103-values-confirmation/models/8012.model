model G8012
sig S0
rel r0: one S0
var v1: set S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one R
init { (#v1 <= 3 implies ((v1 -> S0).v1) in (r0 & ((S0 -> r0).S0))) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((x.w0 + x.w1.n))
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: k, b: true })
}
action a0(p0_0: S0) {
  p0_0.w1.b
  v1' = (r0 - (S0.(S0 -> v1)))
}
invariant Inv { (lone v1 and ((some ((r0 -> S0).(S0.(S0 -> v1))) implies ((S0 -> r0).(v1 -> r0)) = (v1 -> S0)) or ((r0 -> S0) = (v1 -> S0) or (all q3: S0 | (q3.w1.n - q3.w0) < q3.w0)))) }
reachable Goal { (v1 + (v1.(v1 -> S0))) in (((r0 -> S0).(v1 -> r0)).r0) }
scope S0 = 3, Int = 0..2, steps = 6
