model G8275
sig S0
rel r0: S0 -> set S0
rel r1: some S0
var v2: one S0
var v3: S0 -> some S0
fact { (some q1: S0 | r1 != (r1 - (r1 + none))) }
init { (all q2: S0 | (r0 + v3) in r0) }
action a0(p0_0: S0) {
  (#S0 >= 0 or #p0_0 != 3)
  v2' = ((p0_0 & p0_0).(S0 -> r1))
}
invariant Inv { not ((#(S0.v3) > 2 or (some r1 and some S0))) }
reachable Goal { (not (((r1 + S0).((r1 -> S0) + v3)) = ((S0.(v2 -> r1)) & ((v2 -> v2).S0))) and one ((v3 - (S0 -> S0)).S0)) }
scope S0 = 3, steps = 6
