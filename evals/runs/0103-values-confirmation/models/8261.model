model G8261
sig S0
var v0: S0 -> some S0
record R { n: Int, b: Bool }
var w0: S0 -> one Bool
var w1: S0 -> one R
init { ((some q2: S0 | q2.w0) implies v0 in (v0 & v0)) }
init { all x: S0 | x.w0 = false }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0) {
  x.w0
  w0' = w0 - x -> x.w0 + x -> (true)
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: x.w1.n, b: false })
}
action a0(p0_0: S0) {
  p0_0.w1.n >= 1
  v0' = ((S0 -> S0) + v0)
}
action a1(p1_0: S0, p1_1: S0) {
  (((v0.(p1_1 -> S0)).(v0.p1_0)) not in p1_0 implies ((p1_1 + p1_0).v0) in p1_0)
  2 > (p1_1.w1.n + p1_1.w1.n)
  v0' = v0
}
action a2(p2_0: S0, p2_1: S0) {
  v0' = v0
}
invariant Inv { #(S0.v0) > 3 }
reachable Goal { (S0.v0) != S0 }
scope S0 = 3, Int = 0..2, steps = 6
