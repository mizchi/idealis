model G8101
sig S0
enum E = Ea | Eb
var v0: E -> set S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one R
init { ((all q4: S0 | (q4.w1.n - q4.w1.n) <= q4.w1.n) implies some ((S0.(S0 -> Ea)) & (v0.S0))) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  x.w0 = (x.w1.n * x.w0)
