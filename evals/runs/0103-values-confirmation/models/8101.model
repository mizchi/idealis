invariant Inv { (#(v0.S0) >= 2 and (some q17: S0 | q17.w1.b)) }
reachable Goal { (some (S0 - S0) implies (v0.(S0 -> E)) in (Ea -> Ea)) }
scope S0 = 2, Int = 0..2, steps = 6
