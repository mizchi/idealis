model G8146
sig S0
enum E = Ea | Eb
rel r0: some E
rel r1: S0 -> set E
var v2: E -> set E
var w0: S0 -> one Int
init { ((E -> Ea) in (v2.v2) and (v2.v2) in v2) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((k * #S0))
}
action a0() {
  v2' = ((v2.(r0 -> S0)).r1)
}
action a1() {
  (#Eb < 1 or r1 in (S0 -> Ea))
  (no ((r1.(E -> E)).Eb) and #E != 2)
  v2' = (Eb -> Ea)
}
action a2(p2_0: E) {
  some S0
  v2' = (p2_0 -> Ea)
}
invariant Inv { lone (v2.E) }
reachable Goal { ((not (some (Eb.(Ea -> r0))) implies some S0) and not ((((v2 - (r0 -> Eb)).(v2.Eb)) != Ea or (r1.(E -> E)) = r1))) }
scope S0 = 3, Int = -1..2, steps = 6
