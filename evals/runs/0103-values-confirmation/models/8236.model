model G8236
sig S0
sig S1
enum E = Ea | Eb
type P = S0 + S1
rel r0: one P
rel r1: P -> set S1
var v2: S1 -> set E
var w0: S0 -> one Int
init { some v2 }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (k)
}
action a0() {
  (some q26: S0 | 0 != q26.w0)
  v2' = v2
}
action a1() {
  ((((S0 -> S0).S0).((S0 -> E) + (S0 -> Eb))) = ((Ea.(E -> E)).(E -> E)) implies #(E.(Eb -> Eb)) != 2)
  v2' = v2
}
action a2() {
  v2' = (S1 -> E)
}
invariant Inv { ((((S1 + S1).(v2.(E -> S0))) != S0 and (all q28: S1 | ((Ea -> P) - (E -> P)) in (E -> P))) or (all q29: S0 | q29.w0 = q29.w0)) }
reachable Goal { ((((P -> Ea).(Eb + Eb)) in (Eb.(Ea -> P)) and (((S1 -> Eb) & v2).(Eb - none)) not in ((S1 -> P).P)) or (some q48: S0 | 0 < q48.w0)) }
scope S0 = 3, S1 = 3, Int = -1..2, steps = 6
