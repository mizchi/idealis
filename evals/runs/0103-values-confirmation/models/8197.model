model G8197
sig S0
sig S1
rel r0: S1 -> set S1
var v1: S0 -> some S1
var w0: S0 -> one Int
init { ((v1 - v1) in (S0 -> S1) implies ((S1 & S1) - ((S1 -> S0).S0)) not in S1) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  k <= (1 - #S0)
  w0' = w0 - x -> x.w0 + x -> ((x.w0 * k))
}
action a0(p0_0: S1, p0_1: S0) {
  some p0_1
  v1' = ((v1.r0).(r0 - r0))
}
invariant Inv { ((v1 - v1).(S1 - S1)) = ((S1.(S1 -> S1)).((S1 -> S0).(S0 -> S0))) }
reachable Goal { not ((((S1 -> S1).(r0.S1)) = ((S1.(S1 -> S0)).v1) implies (some S0 and (some q6: S0 | 0 > 2)))) }
scope S0 = 3, S1 = 2, Int = -1..2, steps = 6
