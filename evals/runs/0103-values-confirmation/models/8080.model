model G8080
sig S0
sig S1
enum E = Ea | Eb
rel r0: E -> set E
var v1: S0 -> some S1
var v2: S0 -> set S1
var w0: S0 -> one Int
init { (some S0 implies (v2 - v1) = ((S0 -> Ea).(Eb -> S1))) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((#x + k))
}
action a0() {
  v2' = ((S0 -> S0).(S0 -> S1))
}
action a1() {
  (#(Eb.r0) != 3 or no S1)
  lone none
  v1' = (S0 -> S1)
}
action a2(p2_0: S0) {
  (p2_0.w0 + 2) = 2
  S1 not in ((S1 -> S1).((S1 -> S0).p2_0))
  v2' = ((p2_0 + p2_0) -> (S1 - none))
}
invariant Inv { lone (S1 + (S0.v1)) }
reachable Goal { (some q16: S1 | (((Eb -> S1) in ((Eb -> q16) & (E -> S1)) implies #(S0.v1) <= 1) or not ((some q17: S0 | 1 <= q17.w0)))) }
scope S0 = 3, S1 = 3, Int = -1..2, steps = 6
