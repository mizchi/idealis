model G8208
sig S0
sig S1
enum E = Ea | Eb
var v0: S0 -> set E
var v1: E -> set S1
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one R
init { (some S0 implies v0 = v0) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((x.w0 - #x))
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: #S0, b: true })
}
action a0() {
  lone S0
  v1' = ((E -> S0).(S0 -> S1))
}
invariant Inv { ((one (S1 - (E.v1)) implies (some E and (some q20: S0 | q20.w1.n != q20.w0))) or (all q21: S0 | q21.w0 < (q21.w1.n - 0))) }
reachable Goal { ((Ea - (none - E)) = ((S0.v0) & ((Eb -> S0).S0)) and (lone Eb and some ((E -> S0).S0))) }
scope S0 = 3, S1 = 3, Int = 0..2, steps = 6
