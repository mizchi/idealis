model G8292
sig S0
var v0: S0 -> set S0
var v1: S0 -> set S0
var w0: S0 -> one Int
init { (S0 -> S0) = v1 }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  k = 1
  w0' = w0 - x -> x.w0 + x -> (k)
}
action a0(p0_0: S0) {
  ((p0_0.w0 * #S0) <= p0_0.w0 or (p0_0.w0 * p0_0.w0) != (2 * 0))
  v1' = (S0 -> (S0 & p0_0))
}
invariant Inv { (some (S0.v0) implies some S0) }
reachable Goal { (not ((v0.v0) in (v1.v1)) implies some ((v1.v1).S0)) }
scope S0 = 3, Int = -1..2, steps = 6
