model G8076
sig S0
rel r0: S0 -> set S0
rel r1: one S0
var v2: set S0
var v3: one S0
var w0: S0 -> one Int
var w1: S0 -> one Bool
init { (some q1: S0 | (q1.w0 + 2) > (#v3 + q1.w0)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = false }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (x.w0)
}
action set1(x: S0) {
  w1' = w1 - x -> x.w1 + x -> (false)
}
action a0() {
  ((all q2: S0 | not q2.w1) or some (v3 - S0))
  (all q3: S0 | lone (((q3 -> v3).S0) + q3))
  v2' = S0
}
action a1() {
  v2' = (((S0 -> v2) + r0).(r0.S0))
}
action a2(p2_0: S0, p2_1: S0) {
  not p2_0.w1
  v2' = (S0.((S0 -> r1) & r0))
}
invariant Inv { (all q4: S0 | 0 <= #v2) }
reachable Goal { not ((v3 -> v2) in (r0.r0)) }
scope S0 = 2, Int = -1..2, steps = 6
