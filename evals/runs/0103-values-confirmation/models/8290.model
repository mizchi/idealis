model G8290
sig S0
sig S1
rel r0: some S0
var v1: set S1
var w0: S0 -> one Int
fact { ((S0 -> S1) in ((S0 -> r0).(r0 -> S1)) or not ((S0.((S0 -> r0).(S0 -> S1))) not in S1)) }
init { (((S1.(v1 -> v1)).(S1 -> S0)) = S0 or (all q1: S0 | #S0 >= q1.w0)) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((#v1 + 1))
}
action a0(p0_0: S1) {
  v1' = (((S1 -> v1) - (v1 -> p0_0)).((p0_0 -> v1).p0_0))
}
action a1() {
  (some q2: S0 | #q2 <= 1)
  (some q3: S0 | (0 - q3.w0) <= #S0)
  v1' = ((S1 -> v1).(none - S1))
}
action a2() {
  (S0 -> S0) = (S0 -> S0)
  (all q4: S0 | 1 >= (q4.w0 * q4.w0))
  v1' = S1
}
invariant Inv { ((S0 -> S1) = (r0 -> S1) implies (v1 -> S0) = (v1 -> S0)) }
reachable Goal { ((v1 -> v1) = ((v1 -> v1) & (v1 -> v1)) and ((some S0 or ((S0 -> r0) + (S0 -> r0)) = (r0 -> S0)) and (((S1 -> r0).(S0 -> v1)).v1) in (((S1 -> S0).(S0 -> r0)).(S1.(S1 -> S0))))) }
scope S0 = 3, S1 = 2, Int = -1..2, steps = 6
