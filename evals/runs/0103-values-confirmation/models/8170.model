model G8170
sig S0
sig S1
rel r0: S0 -> one S1
rel r1: S1 -> set S0
var v2: some S0
var v3: S0 -> one S1
var w0: S0 -> one Bool
init { (((S1 -> S1).(S1 -> v2)) in ((S1 -> S0).(v2 -> v2)) or #(S1.(S1 -> v2)) >= 3) }
init { all x: S0 | x.w0 = true }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (true)
}
action a0() {
  not (#v2 < 3)
  (all q1: S0 | not q1.w0)
  v2' = ((S0 & v2) - v2)
}
action a1(p1_0: S0) {
  some (p1_0.r0)
  (all q2: S0 | q2 = q2)
  v2' = ((S0 -> v2).(p1_0 + v2))
}
action a2() {
  (some q3: S1 | ((v2 + v2) - v2) not in (((S0 -> v2).(S0 -> v2)).v2))
  no (r1.(S0 - S0))
  v2' = ((S0 & v2) & v2)
}
invariant Inv { ((S1 - S1) - (S1 & S1)) not in ((S0.v3) & S1) }
reachable Goal { (one ((r0.r1).(v2 - S0)) implies ((all q8: S1 | ((r1.(v2 -> q8)).q8) in (S1 + ((S1 -> q8).S1))) and r0 in v3)) }
scope S0 = 2, S1 = 3, steps = 6
