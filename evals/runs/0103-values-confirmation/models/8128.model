model G8128
sig S0
rel r0: S0 -> some S0
rel r1: S0 -> lone S0
var v2: S0 -> some S0
var v3: some S0
init { ((S0 + S0).r1) != (r0.(S0.v2)) }
action a0(p0_0: S0) {
  v3' = ((p0_0.r0) + (r0.p0_0))
}
action a1(p1_0: S0, p1_1: S0) {
  v3' = S0
}
invariant Inv { some (v3.(S0 -> S0)) }
reachable Goal { #(S0.v2) <= 2 }
scope S0 = 3, steps = 6
