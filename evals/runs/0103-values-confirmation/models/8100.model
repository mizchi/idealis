model G8100
sig S0
rel r0: set S0
rel r1: some S0
var v2: lone S0
var v3: set S0
var w0: S0 -> one Int
init { ((v2 - r1).(v2 -> S0)) not in r0 }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  (k + x.w0) <= 0
  w0' = w0 - x -> x.w0 + x -> (#v2)
}
action a0(p0_0: S0) {
  some S0
  (v2 in ((p0_0.(r1 -> v2)) - (v2.(v3 -> S0))) implies some ((r0 -> v3).r1))
  v3' = ((v2.(v3 -> S0)).(p0_0 -> r0))
}
action a1(p1_0: S0, p1_1: S0) {
  v3' = ((v3.(r0 -> p1_1)) - (S0.(S0 -> p1_1)))
}
action a2() {
  (S0 -> r0) in (r1 -> r0)
  (some q1: S0 | (q1.w0 + 1) < (0 - #r0))
  v3' = v3
}
invariant Inv { (some (v2.(r1 -> v3)) and ((S0 -> r0).(v2 -> r1)) = ((S0 -> r0).(v3 -> v3))) }
reachable Goal { not (not ((#(r0 + r0) <= 0 or (some q4: S0 | 2 != #v2)))) }
scope S0 = 3, Int = -1..2, steps = 6
