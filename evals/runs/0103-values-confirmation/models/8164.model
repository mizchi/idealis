model G8164
sig S0
sig S1
enum E = Ea | Eb
var v0: some S1
var v1: lone E
var w0: S0 -> one Int
init { not ((some q1: S0 | 0 >= (#v0 - #q1))) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  (k + k) != #S0
  w0' = w0 - x -> x.w0 + x -> ((1 + x.w0))
}
action a0(p0_0: S0, p0_1: S1) {
  (2 * 0) != 0
  v1' = ((Ea -> p0_1).(p0_0.(S0 -> v0)))
}
action a1() {
  v1' = v1
}
invariant Inv { ((not ((all q2: S0 | (#v1 + 1) <= (#v0 + 1))) and (#((S1 -> S1).S1) <= 0 implies some (S0.(S0 -> v1)))) and (some Ea implies (all q3: S0 | q3.w0 > #S1))) }
reachable Goal { ((#(v0.(S1 -> Ea)) = 1 or #(Ea & v1) <= 3) implies ((lone ((E -> S0).S0) or (all q4: S0 | 0 != (2 + q4.w0))) or not (S0 != (S0 - S0)))) }
scope S0 = 1, S1 = 3, Int = -1..2, steps = 6
