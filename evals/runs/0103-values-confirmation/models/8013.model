model G8013
sig S0
rel r0: S0 -> some S0
rel r1: set S0
var v2: S0 -> lone S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one R
fact { (all q1: S0 | (#(r1.r0) < 2 and ((r0.r0).(q1 & r1)) = (r0.(r1 + none)))) }
init { (((r1.r0).v2) not in ((r1 & r1) - (r0.S0)) implies #S0 < 0) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (2)
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: x.w0, b: false })
}
action a0(p0_0: S0, p0_1: S0) {
  v2' = ((v2 & v2).(p0_0 -> S0))
}
action a1(p1_0: S0, p1_1: S0) {
  v2' = (((S0 -> S0).(r1 -> p1_1)).r0)
}
invariant Inv { one (((S0 -> r1) & v2).r1) }
reachable Goal { #(S0.v2) = 0 }
scope S0 = 3, Int = 0..2, steps = 6
