model G8158
sig S0
var v0: S0 -> set S0
var w0: S0 -> one Int
init { (some (S0.v0) implies #(S0.v0) >= 2) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  (#x + 0) <= 1
  w0' = w0 - x -> x.w0 + x -> ((k + 0))
}
action a0() {
  v0' = ((v0.(S0 -> S0)) & (v0 + (S0 -> S0)))
}
action a1(p1_0: S0) {
  #(v0.p1_0) > 2
  ((p1_0.w0 + p1_0.w0) >= (#S0 - p1_0.w0) or some (none & p1_0))
  v0' = (v0.((S0 -> S0) + v0))
}
action a2() {
  ((S0 -> S0) = (v0.v0) and (all q1: S0 | q1.w0 = (q1.w0 + #S0)))
  v0' = v0
}
invariant Inv { #(S0.v0) < 0 }
reachable Goal { ((all q3: S0 | lone ((S0 -> S0).(q3.v0))) implies (((S0 -> S0) = v0 and (some q4: S0 | (q4.w0 * #q4) >= q4.w0)) implies (#S0 = 1 implies no S0))) }
scope S0 = 3, Int = -1..2, steps = 6
