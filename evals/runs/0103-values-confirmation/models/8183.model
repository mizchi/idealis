model G8183
sig S0
enum E = Ea | Eb
type P = S0 + E
rel r0: set S0
rel r1: P -> set P
var v2: E -> lone S0
record R { n: Int, b: Bool }
var w0: S0 -> one Bool
var w1: S0 -> one R
fact { (not (((S0.(r0 -> P)) + ((P -> r0).r0)) in (((P -> r0).(S0 -> Eb)).Eb)) implies ((((S0 -> P).P) & ((S0 -> r0).S0)) = r0 implies some (P.(P -> Ea)))) }
init { ((all q9: S0 | 0 <= 1) implies (E.v2) in (((S0 -> E).Ea).((S0 -> r0) - (S0 -> r0)))) }
init { all x: S0 | x.w0 = false }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (true)
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: 2, b: false })
}
action a0() {
  ((all q10: S0 | (q10.w1.n - 1) >= 1) implies ((S0.(r0 -> Ea)) - Ea) in ((E.(Eb -> Eb)).(Ea -> E)))
  (((E & none).(Ea -> E)) in Ea and (P -> r0) = (P -> r0))
  v2' = v2
}
action a1(p1_0: E) {
  #none < 1
  v2' = v2
}
action a2() {
  not ((some q11: S0 | not q11.w0))
  v2' = (v2 - (Eb -> r0))
}
invariant Inv { ((all q18: P | (some q19: E | (all q20: S0 | (q20.w1.n - q20.w1.n) >= q20.w1.n))) and ((some (E.v2) or #none <= 2) implies #(P.r1) <= 1)) }
reachable Goal { some v2 }
scope S0 = 1, Int = 0..2, steps = 6
