model G8035
sig S0
sig S1
enum E = Ea | Eb
type P = S0 + S1
rel r0: set E
var v1: P -> set P
var w0: S0 -> one Int
var w1: S0 -> one Bool
fact { not ((#S1 > 0 and (S0 -> S0) = ((S0 -> S0) - (S0 -> S0)))) }
init { ((some q10: S0 | (2 - #r0) <= (q10.w0 * 2)) and one (P.v1)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = false }
action set0(x: S0, k: Int) {
  x.w1
  w0' = w0 - x -> x.w0 + x -> (k)
}
action set1(x: S0) {
  x.w1
  w1' = w1 - x -> x.w1 + x -> (false)
}
action a0() {
  (all q11: S0 | q11.w0 > 2)
  not (some (((S0 -> S0).(S0 -> S0)).((S0 -> P).P)))
  v1' = (P -> P)
}
action a1(p1_0: E, p1_1: E) {
  v1' = (P -> P)
}
invariant Inv { (not (no (P.v1)) or lone (((P -> r0).E) & (S1.(S1 -> P)))) }
reachable Goal { ((some q34: S0 | not q34.w1) and (((S1 -> S1) = ((S1 -> S1) + (S1 -> S1)) or (v1 & v1) = v1) or some (S1.(S1 -> S0)))) }
scope S0 = 3, S1 = 2, Int = -1..2, steps = 6
