model G8096
sig S0
rel r0: lone S0
var v1: S0 -> set S0
var w0: S0 -> one Int
fact { (all q1: S0 | (some q2: S0 | some ((q1 -> q1).S0))) }
init { ((all q3: S0 | (1 + q3.w0) > (q3.w0 - 1)) and (S0 -> S0) in ((r0 -> r0) + v1)) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (0)
}
action a0() {
  v1' = (v1.(S0 -> r0))
}
invariant Inv { (((one ((v1.r0).(r0 -> r0)) and #S0 < 0) or (some q6: S0 | (1 - #S0) != 0)) and some none) }
reachable Goal { ((r0 -> S0).(S0 -> r0)) = (v1 + v1) }
scope S0 = 3, Int = -1..2, steps = 6
