model G8105
sig S0
var v0: lone S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one R
init { (S0 -> S0) = (v0 -> S0) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (0)
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: k, b: false })
}
action a0(p0_0: S0) {
  v0' = v0
}
action a1() {
  v0' = (v0.(S0 -> S0))
}
action a2(p2_0: S0) {
  ((p2_0.w1.n - #p2_0) >= (p2_0.w0 - p2_0.w0) or #p2_0 < 1)
  (some q2: S0 | (v0 -> v0) in ((S0 -> v0) + (S0 -> p2_0)))
  v0' = S0
}
invariant Inv { #((S0 -> v0).v0) >= 1 }
reachable Goal { ((all q5: S0 | q5.w1.b) and (some q6: S0 | (some (v0.(v0 -> v0)) and #(S0.(v0 -> S0)) < 0))) }
scope S0 = 3, Int = 0..2, steps = 6
