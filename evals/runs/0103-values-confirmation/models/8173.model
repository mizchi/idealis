model G8173
sig S0
sig S1
enum E = Ea | Eb
rel r0: E -> lone S0
rel r1: one S0
var v2: one E
var w0: S0 -> one Int
fact { (all q1: E | not (some S1)) }
init { Ea = v2 }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((k + 0))
}
action a0() {
  (#none < 0 or S1 in S1)
  v2' = Eb
}
action a1() {
  v2' = ((S1.(S1 -> S0)).((r1 -> E) & (r1 -> E)))
}
action a2(p2_0: S1, p2_1: S1) {
  (all q5: S0 | (q5.w0 - q5.w0) < 2)
  (all q6: S0 | #p2_0 = q6.w0)
  v2' = v2
}
invariant Inv { (S1 -> Ea) = ((S1 -> r1).(r1 -> v2)) }
reachable Goal { (((some (none + S0) and (all q7: S0 | q7.w0 = 1)) or ((some q8: S0 | (q8.w0 - 1) <= (0 * q8.w0)) and #((S0 -> v2).v2) < 2)) or ((all q9: E | #(S1.(S1 -> Ea)) != 0) and (Ea.((Ea -> S0) & r0)) in S0)) }
scope S0 = 3, S1 = 1, Int = -1..2, steps = 6
