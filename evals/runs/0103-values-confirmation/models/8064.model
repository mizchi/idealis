model G8064
sig S0
sig S1
enum E = Ea | Eb
rel r0: S1 -> set E
rel r1: one S1
var v2: S1 -> one E
record R { n: Int, b: Bool }
var w0: S0 -> one R
fact { one S0 }
init { no (v2.Eb) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  0 != k
  w0' = w0 - x -> x.w0 + x -> (R { n: (x.w0.n - k), b: true })
}
action a0() {
  ((all q8: S0 | 1 > q8.w0.n) implies (S0 - ((S0 -> S0).S0)) not in S0)
  v2' = (S1 -> Eb)
}
invariant Inv { (some q23: S0 | (some q24: E | (S1 -> Ea) in (v2 + (S1 -> E)))) }
reachable Goal { no ((r1.v2) & (Ea - Ea)) }
scope S0 = 3, S1 = 1, Int = 0..2, steps = 6
