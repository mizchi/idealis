model G8001
sig S0
sig S1
enum E = Ea | Eb
type P = S0 + S1
rel r0: P -> some S1
var v1: P -> some P
var v2: some S0
var w0: S0 -> one Int
var w1: S0 -> one Bool
init { ((P -> P) = (v1 & v1) and (Ea.((Eb -> E).(E -> P))) != ((r0 & r0).S1)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
action set0(x: S0, k: Int) {
  #P = (#S0 - #P)
  w0' = w0 - x -> x.w0 + x -> ((k + k))
}
action set1(x: S0) {
  x.w1
  w1' = w1 - x -> x.w1 + x -> (false)
}
action a0() {
  v2' = ((S1 + S1).((S1 -> v2) & (S1 -> S0)))
}
invariant Inv { S0 != (P.((P -> v2).(v2 -> S0))) }
reachable Goal { ((Ea -> v2).((S0 -> E).Ea)) not in Eb }
scope S0 = 1, S1 = 2, Int = -1..2, steps = 6
