model G8079
sig S0
enum E = Ea | Eb
rel r0: S0 -> lone S0
rel r1: E -> set E
var v2: lone E
var v3: S0 -> lone S0
var w0: S0 -> one Bool
init { (some (S0.(S0 -> E)) implies (Ea -> S0) = ((v2 -> S0).v3)) }
init { all x: S0 | x.w0 = false }
action set0(x: S0) {
  x.w0
  w0' = w0 - x -> x.w0 + x -> (true)
}
action a0(p0_0: E, p0_1: E) {
  (no S0 and (S0 -> Eb) = (S0 -> E))
  (some q5: S0 | not q5.w0)
  v2' = (p0_1 & p0_0)
}
invariant Inv { some (Ea.(v2 -> S0)) }
reachable Goal { ((v2 & E) - E) = ((v2 - Eb).((E -> S0).(S0 -> E))) }
scope S0 = 3, steps = 6
