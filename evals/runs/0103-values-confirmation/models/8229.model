model G8229
sig S0
enum E = Ea | Eb
type P = S0 + E
var v0: some S0
record R { n: Int, b: Bool }
var w0: S0 -> one Bool
var w1: S0 -> one R
init { not (#(v0 + S0) > 3) }
init { all x: S0 | x.w0 = true }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (false)
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: #Eb, b: false })
}
action a0() {
  (all q2: P | ((S0 -> P) & (S0 -> P)) in ((v0 -> P).(P -> P)))
  some (S0 - E)
  v0' = (P.(P -> v0))
}
action a1(p1_0: P) {
  (some q3: S0 | not q3.w0)
  (some q4: E | (some q5: S0 | (0 * q5.w1.n) = #E))
  v0' = ((S0 -> P).P)
}
invariant Inv { (v0 -> Eb) = ((v0 -> Ea) + (v0 -> E)) }
reachable Goal { ((P -> P) = (P -> P) and not ((some q11: S0 | lone ((q11 - v0) - (v0 - S0))))) }
scope S0 = 3, Int = 0..2, steps = 6
