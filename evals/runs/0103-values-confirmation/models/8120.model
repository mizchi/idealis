model G8120
sig S0
sig S1
rel r0: S0 -> set S1
var v1: S0 -> some S0
record R { n: Int, b: Bool }
var w0: S0 -> one R
init { (some q1: S1 | ((r0.q1).(S0 -> S0)) != ((S0.v1).(S0 -> S0))) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (R { n: k, b: false })
}
action a0() {
  v1' = (S0 -> S0)
}
action a1(p1_0: S1, p1_1: S0) {
  v1' = v1
}
action a2() {
  v1' = ((S0 & S0) -> (r0.S1))
}
invariant Inv { (all q3: S0 | ((some q3 and (S1 -> S1) = ((S1 -> q3).(S0 -> S1))) implies (#q3 > 2 and (S0.(v1.r0)) = (S1.(S1 -> S1))))) }
reachable Goal { (((#(S0.v1) != 3 implies lone (S1.(S1 -> S1))) and (all q10: S0 | #q10 != 0)) implies (all q11: S0 | q11.w0.n > q11.w0.n)) }
scope S0 = 3, S1 = 3, Int = 0..2, steps = 6
