model G8068
sig S0
rel r0: S0 -> one S0
rel r1: S0 -> some S0
var v2: S0 -> set S0
var v3: one S0
var w0: S0 -> one Int
fact { (not (some (r0.S0)) implies (some S0 and (r1 - r1) = (r0.r1))) }
init { (all q1: S0 | some (v3 + (S0.r0))) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  (1 - x.w0) != 1
  w0' = w0 - x -> x.w0 + x -> ((#x * 0))
}
action a0(p0_0: S0, p0_1: S0) {
  v3' = p0_0
}
invariant Inv { ((some q3: S0 | (some q3 or 2 = q3.w0)) implies #((v3 -> S0).v3) > 1) }
reachable Goal { (v3 -> S0) in r1 }
scope S0 = 3, Int = -1..2, steps = 6
