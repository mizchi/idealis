model G8115
sig S0
sig S1
type P = S0 + S1
rel r0: some P
rel r1: P -> one S0
var v2: S1 -> set S1
record R { n: Int, b: Bool }
var w0: S0 -> one R
fact { (not (some S1) implies (#(none - S1) < 2 and some S1)) }
init { (((S1 -> S1) + v2) in (S1 -> S1) or some (S1.((S1 -> P).(P -> P)))) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  (1 + k) < (k + 0)
  w0' = w0 - x -> x.w0 + x -> (R { n: 1, b: false })
}
action a0(p0_0: S1, p0_1: P) {
  v2' = (((p0_0 -> S0) - (S1 -> S0)).(S0 -> S1))
}
invariant Inv { ((some q5: S0 | 0 >= q5.w0.n) and (not (v2 = (v2.(S1 -> S1))) implies (some q6: S0 | q6.w0.n > q6.w0.n))) }
reachable Goal { (no none implies (((S1.((S1 -> P).(P -> S1))) = ((v2.(S1 -> S0)).S0) implies (some q15: S0 | q15.w0.n = q15.w0.n)) or one ((S1.(S1 -> P)) & (S0 - r0)))) }
scope S0 = 2, S1 = 3, Int = 0..2, steps = 6
