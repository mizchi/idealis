model G8095
sig S0
sig S1
enum E = Ea | Eb
rel r0: S0 -> one S0
rel r1: set E
var v2: lone S0
var w0: S0 -> one Bool
init { (some v2 or (all q7: S0 | not q7.w0)) }
init { all x: S0 | x.w0 = true }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (true)
}
action a0() {
  (all q8: S0 | q8.w0)
  (some q9: S0 | q9.w0)
  v2' = ((v2 -> Eb).Ea)
}
action a1(p1_0: E, p1_1: E) {
  v2' = none
}
invariant Inv { ((some q32: S0 | not q32.w0) implies ((r0.(v2 -> Eb)) in ((v2 -> Ea) + (v2 -> r1)) and ((((S0 -> S1) & (v2 -> S1)).S1) in (v2 + S0) or (all q33: S0 | q33.w0)))) }
reachable Goal { (some (Ea.(Eb -> E)) implies ((some S1 or ((Eb -> S0) - (Eb -> v2)) = (Eb -> v2)) or v2 = ((S0 -> Ea).((Eb -> S1).S1)))) }
scope S0 = 3, S1 = 2, steps = 6
