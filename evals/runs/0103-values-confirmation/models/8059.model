model G8059
sig S0
enum E = Ea | Eb
type P = S0 + E
rel r0: E -> one P
var v1: P -> lone S0
var v2: P -> one S0
fact { #(Eb & Eb) <= 1 }
init { (P -> P) in (v1.(S0 -> P)) }
action a0(p0_0: E, p0_1: S0) {
  v2' = (v1 + (v1 & v1))
}
action a1(p1_0: S0) {
  (some (P.(P -> P)) or r0 = ((Ea -> P) - r0))
  v1' = (P -> S0)
}
action a2(p2_0: S0, p2_1: S0) {
  no (P.v2)
  v2' = (P -> p2_0)
}
invariant Inv { (some ((S0 -> E).E) or (v1.((S0 -> P).P)) in ((P -> Ea).(E.(Ea -> Ea)))) }
reachable Goal { ((no ((v2.S0) & (v2.S0)) or ((S0 & (P.(P -> P))) != E and #(Eb + E) = 2)) and not ((Eb -> Ea) in (Eb -> Eb))) }
scope S0 = 2, steps = 6
