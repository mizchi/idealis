model G8259
sig S0
sig S1
type P = S0 + S1
rel r0: S0 -> lone P
var v1: S1 -> one S0
var v2: S1 -> set P
var w0: S0 -> one Bool
init { (no (P.((P -> S1).v2)) or (r0.(P -> S0)) in (S0 -> S0)) }
init { all x: S0 | x.w0 = true }
action set0(x: S0) {
  x.w0
  w0' = w0 - x -> x.w0 + x -> (true)
}
action a0() {
  (all q8: S1 | #q8 = 1)
  v1' = ((S1 -> S0) - v1)
}
invariant Inv { (#S1 <= 3 implies (some q13: S0 | ((P -> P) = ((P -> P).(P -> P)) or lone (S1.(v1.(q13 -> q13)))))) }
reachable Goal { ((S1 -> S1).v1) = (v2.(P -> S0)) }
scope S0 = 2, S1 = 3, steps = 6
