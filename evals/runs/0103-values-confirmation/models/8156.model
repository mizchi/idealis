model G8156
sig S0
rel r0: S0 -> one S0
var v1: set S0
var v2: S0 -> some S0
init { (((S0.(v1 -> S0)).((v1 -> S0).v2)) in v1 or some S0) }
action a0(p0_0: S0) {
  some (none - v1)
  v1' = (r0.v1)
}
action a1(p1_0: S0, p1_1: S0) {
  v1' = (((S0 -> S0).v2).(v2.v1))
}
action a2(p2_0: S0) {
  (#p2_0 != 0 or no ((r0.S0) + (v2.v1)))
  v2' = ((v1 -> p2_0).((S0 -> v1).r0))
}
invariant Inv { (all q1: S0 | not (lone ((S0 -> v1).(S0.r0)))) }
reachable Goal { (some q2: S0 | ((no (v1 & q2) and some (S0.(q2 -> S0))) or (some q3: S0 | #(S0 - v1) < 1))) }
scope S0 = 3, steps = 6
