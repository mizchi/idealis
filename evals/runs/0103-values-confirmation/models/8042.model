model G8042
sig S0
sig S1
enum E = Ea | Eb
rel r0: S0 -> set S0
rel r1: S1 -> set S1
var v2: S1 -> set S0
var v3: S1 -> some E
fact { S0 = S0 }
init { (some (S1.v2) implies ((S1 -> E) & v3) in v3) }
action a0(p0_0: E, p0_1: S0) {
  (S1 -> Eb) in (S1 -> E)
  (#S0 != 2 and S0 != none)
  v3' = v3
}
invariant Inv { ((#(S1.r1) = 1 implies (some q1: S1 | one S0)) implies ((all q2: S0 | no ((v2.S0) + (S1 + none))) implies (((Eb -> E).(E -> S0)) in (Ea -> S0) and one S0))) }
reachable Goal { not (((S1 -> S0) & v2) in (S1 -> S0)) }
scope S0 = 3, S1 = 2, steps = 6
