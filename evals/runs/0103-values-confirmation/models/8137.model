model G8137
sig S0
rel r0: S0 -> lone S0
rel r1: S0 -> set S0
var v2: set S0
var v3: set S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one Bool
var w2: S0 -> one R
fact { #(r0.S0) <= 3 }
init { (all q2: S0 | no (r1.v3)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = false }
init { all x: S0 | x.w2 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((x.w0 * #v2))
}
action set1(x: S0) {
  w1' = w1 - x -> x.w1 + x -> (false)
}
action set2(x: S0, k: Int) {
  w2' = w2 - x -> x.w2 + x -> (R { n: x.w2.n, b: true })
}
action a0() {
  v3' = ((r0.S0) - (v3 - v2))
}
action a1() {
  #((v3 -> v2).S0) = 3
  v3' = none
}
action a2() {
  v2' = S0
}
invariant Inv { ((not ((v3 + S0) = ((v3.(v3 -> v3)).(r1 + r0))) and some ((r0.v2) + S0)) or #(r1.v3) != 1) }
reachable Goal { (((some q6: S0 | q6.w1) or one ((r1.v3) & v2)) or (((((S0 -> v2).S0) - (v2.r1)) != S0 and no ((v2 + v2).(v2 -> v2))) implies (#(v3 & S0) < 0 implies some (v2 & v3)))) }
scope S0 = 3, Int = 0..2, steps = 6
