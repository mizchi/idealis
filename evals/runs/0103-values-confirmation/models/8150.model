model G8150
sig S0
rel r0: S0 -> one S0
rel r1: S0 -> one S0
var v2: S0 -> one S0
var w0: S0 -> one Bool
init { (((v2.S0) - (S0 & S0)) in S0 and r1 in (S0 -> S0)) }
init { all x: S0 | x.w0 = false }
action set0(x: S0) {
  x.w0
  w0' = w0 - x -> x.w0 + x -> (false)
}
action a0() {
  some (S0.r0)
  ((all q6: S0 | not q6.w0) implies some none)
  v2' = (S0 -> S0)
}
invariant Inv { ((S0.(v2 - v2)) != ((v2.S0).r1) and ((all q9: S0 | no (q9.(q9 -> S0))) and some S0)) }
