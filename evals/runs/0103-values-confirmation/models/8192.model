model G8192
sig S0
sig S1
enum E = Ea | Eb
type P = S0 + S1
rel r0: S0 -> lone S1
var v1: set S1
var v2: some P
init { (v1 -> P) = (v1 -> P) }
action a0() {
  not (#((Eb -> Eb).Eb) <= 0)
  ((((P -> S0).S0) + (E.(Ea -> P))) not in ((S1 - none).((v1 -> v1).(S1 -> P))) and some S0)
  v1' = v1
}
action a1(p1_0: S0, p1_1: S1) {
  v2' = (v2 - (v2 & P))
}
invariant Inv { (all q1: S0 | (one (P.((P -> S1).(v1 -> P))) implies (some S1 implies some (S0.r0)))) }
reachable Goal { (#v1 != 2 or ((none + (none + Eb)) in ((v1.(v1 -> S0)).((S0 -> v1).(v1 -> Eb))) or ((S1.(S1 -> S0)).(S0 -> P)) != ((P -> E).((E -> S1).v1)))) }
scope S0 = 3, S1 = 3, steps = 6
