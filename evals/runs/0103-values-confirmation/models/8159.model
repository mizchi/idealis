model G8159
sig S0
enum E = Ea | Eb
rel r0: set S0
var v1: lone S0
var v2: E -> lone S0
record R { n: Int, b: Bool }
var w0: S0 -> one R
init { (E -> S0) in v2 }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  k = #x
  w0' = w0 - x -> x.w0 + x -> (R { n: 2, b: true })
}
action a0(p0_0: S0) {
  (some Eb or #(E + Ea) != 2)
  (all q3: E | #S0 >= 2)
  v1' = ((v1 & v1) + (S0 + S0))
}
invariant Inv { (((S0 -> Eb) - (v1 -> Eb)) in ((v1 -> E) & (S0 -> Ea)) or (((some q7: S0 | q7.w0.n < (2 * q7.w0.n)) and (some q8: S0 | (q8.w0.n + 0) > (2 + q8.w0.n))) or ((all q9: S0 | (#S0 + q9.w0.n) = 2) implies (((S0 -> S0).r0) - (r0 + v1)) != v1))) }
reachable Goal { ((v1 -> Eb) & (S0 -> E)) in (S0 -> Ea) }
scope S0 = 3, Int = 0..2, steps = 6
