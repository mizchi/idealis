model G8103
sig S0
rel r0: lone S0
var v1: one S0
var v2: S0 -> lone S0
var w0: S0 -> one Int
var w1: S0 -> one Bool
fact { (((r0 -> r0).r0).(r0 -> S0)) != (((S0 -> S0).r0) - r0) }
init { ((some q3: S0 | q3.w1) implies #(S0.v2) <= 1) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
action set0(x: S0, k: Int) {
  (x.w0 * x.w0) = (#S0 * x.w0)
  w0' = w0 - x -> x.w0 + x -> ((x.w0 * k))
}
action set1(x: S0) {
  w1' = w1 - x -> x.w1 + x -> (true)
}
action a0(p0_0: S0, p0_1: S0) {
  v1' = ((r0.v2) - (p0_1 - r0))
}
action a1(p1_0: S0) {
  (p1_0.w1 and (v2 & v2) in v2)
  v2' = (((S0 -> p1_0).v2) - (v2 - v2))
}
action a2(p2_0: S0) {
  v2' = (v2.(v2.(r0 -> v1)))
}
invariant Inv { ((all q4: S0 | q4.w0 != (2 - 1)) and ((S0 = (v1 & (none - r0)) or (all q5: S0 | not q5.w1)) implies (all q6: S0 | not q6.w1))) }
reachable Goal { some (v1.v2) }
scope S0 = 3, Int = -1..2, steps = 6
