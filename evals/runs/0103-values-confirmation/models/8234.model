model G8234
sig S0
sig S1
rel r0: lone S1
var v1: S0 -> one S1
var v2: S0 -> set S0
var w0: S0 -> one Bool
fact { (((S0 -> S0) in (S0 -> S0) implies #r0 = 2) or #((S0 -> r0).S1) = 2) }
init { (#(S0.v1) = 2 implies (some q2: S0 | q2.w0)) }
init { all x: S0 | x.w0 = false }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (true)
}
action a0() {
  v2' = (v1.((r0 -> S0).v2))
}
action a1() {
  v1' = (v1.(S1 -> S1))
}
invariant Inv { (all q6: S1 | S0 = (v2.(none & S0))) }
reachable Goal { #(S0.v2) = 2 }
scope S0 = 3, S1 = 2, steps = 6
