model G8246
sig S0
var v0: S0 -> one S0
record R { n: Int, b: Bool }
var w0: S0 -> one Bool
var w1: S0 -> one R
init { (S0.(S0 -> S0)) != ((v0.(S0 -> S0)).S0) }
init { all x: S0 | x.w0 = true }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0) {
  not x.w0
  w0' = w0 - x -> x.w0 + x -> (true)
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: x.w1.n, b: true })
}
action a0(p0_0: S0) {
  p0_0.w1.b
  #S0 = 3
  v0' = v0
}
action a1(p1_0: S0) {
  (v0 - v0) = (S0 -> p1_0)
  v0' = (p1_0 -> (S0 & none))
}
invariant Inv { some (S0.v0) }
reachable Goal { no (((S0 -> S0) + v0).(S0.v0)) }
scope S0 = 2, Int = 0..2, steps = 6
