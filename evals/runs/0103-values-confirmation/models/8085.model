model G8085
sig S0
sig S1
type P = S0 + S1
rel r0: P -> one S1
var v1: P -> one P
var v2: one S0
var w0: S0 -> one Int
fact { ((some ((S1 -> S0).S0) implies (S0 -> S1) in (S0 -> S1)) and (some q1: S0 | (S1 -> S0) in ((S1 -> S0).(q1 -> q1)))) }
init { (some q2: S1 | some v2) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  k < (x.w0 * x.w0)
  w0' = w0 - x -> x.w0 + x -> ((x.w0 - k))
}
action a0() {
  (((S1 -> S1).(S0.(S0 -> S1))) = (((S1 -> v2) & (S1 -> v2)).v2) implies (v2 & (S0 + S0)) = (((v2 -> P).(P -> S1)).((S1 -> v2).S0)))
  (some q3: S0 | (q3.w0 - q3.w0) = 1)
  v1' = v1
}
invariant Inv { ((some q4: P | ((some q5: S0 | 2 = 0) or ((P -> S0) + (P -> v2)) in ((P -> v2) & (P -> S0)))) and (some q6: S0 | (#q6 + q6.w0) > q6.w0)) }
reachable Goal { ((((S1 -> P) in ((S1 -> P).v1) and ((S1 -> P).(P -> S0)) = ((S1 -> S0) - (S1 -> v2))) and ((all q7: S0 | (2 + 0) = (0 + q7.w0)) implies some (S1 - S1))) or (all q8: S0 | #q8 != (q8.w0 * q8.w0))) }
scope S0 = 3, S1 = 1, Int = -1..2, steps = 6
