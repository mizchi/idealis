model G8111
sig S0
var v0: S0 -> one S0
var w0: S0 -> one Int
init { (v0 & v0) = (v0.v0) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((#S0 + x.w0))
}
action a0(p0_0: S0, p0_1: S0) {
  v0' = v0
}
invariant Inv { (v0.(v0.S0)) in S0 }
reachable Goal { (v0.v0) = (S0 -> S0) }
scope S0 = 2, Int = -1..2, steps = 6
