model G8155
sig S0
rel r0: S0 -> some S0
var v1: S0 -> lone S0
var v2: S0 -> one S0
fact { (some q1: S0 | ((r0.r0).(q1 - S0)) not in q1) }
init { v1 in (S0 -> S0) }
action a0() {
  (#S0 != 0 and (S0 -> S0) = (S0 -> S0))
  v2' = ((r0 & (S0 -> S0)) - (v1 + v2))
}
action a1(p1_0: S0, p1_1: S0) {
  (#S0 = 1 implies some (S0 + p1_1))
  (((p1_0 -> p1_0).(p1_0 -> p1_1)) = v1 or ((p1_1 -> p1_1).p1_1) not in (none - none))
  v1' = (v1 & (v2 + (p1_0 -> p1_0)))
}
invariant Inv { (r0.v1) in v2 }
reachable Goal { (all q3: S0 | (no S0 and ((v2 & r0) in v1 and lone (q3 & (q3 - none))))) }
scope S0 = 3, steps = 6
