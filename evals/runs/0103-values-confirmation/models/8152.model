model G8152
sig S0
enum E = Ea | Eb
rel r0: E -> set E
var v1: set S0
var v2: some E
var w0: S0 -> one Int
var w1: S0 -> one Bool
fact { (some q1: E | (S0 not in (((S0 -> S0).S0).((S0 -> S0) + (S0 -> S0))) and (S0 -> S0) in (S0 -> S0))) }
init { ((S0 -> E) = ((v1 -> Eb) - (v1 -> E)) implies (v1 -> v2) = (S0 -> v2)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((0 - k))
}
action set1(x: S0) {
  w1' = w1 - x -> x.w1 + x -> (false)
}
action a0(p0_0: S0, p0_1: E) {
  v2' = (((v2 -> v1).v1) - (p0_1 & p0_1))
}
action a1(p1_0: S0, p1_1: E) {
  (all q2: E | v1 not in ((r0.v2).(v2 -> v1)))
  v2' = ((Ea -> S0).(Ea.(Eb -> p1_0)))
}
invariant Inv { ((v1 -> v1) + (S0 -> S0)) in (v1 -> v1) }
reachable Goal { (no (v1.(v1 -> Eb)) implies ((some q3: S0 | q3.w1) implies one (v2 - (v2 + v2)))) }
scope S0 = 3, Int = -1..2, steps = 6
