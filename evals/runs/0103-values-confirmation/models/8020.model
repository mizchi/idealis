model G8020
sig S0
enum E = Ea | Eb
rel r0: some E
var v1: S0 -> some S0
record R { n: Int, b: Bool }
var w0: S0 -> one R
fact { some (S0.(S0 -> S0)) }
init { #(S0.v1) = 3 }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  (x.w0.n * 0) < x.w0.n
  w0' = w0 - x -> x.w0 + x -> (R { n: (x.w0.n * 1), b: false })
}
action a0(p0_0: S0) {
  (lone (((E -> Eb).Ea).(Ea -> r0)) or some r0)
  v1' = ((v1.p0_0) -> (E.(Eb -> S0)))
}
action a1(p1_0: E) {
  (some none and (some q7: S0 | q7.w0.n != 0))
  some S0
  v1' = v1
}
action a2() {
  (all q8: E | (S0 -> E) = (S0 -> E))
  v1' = (((S0 -> S0) - v1).(S0 -> S0))
}
invariant Inv { not (not ((some (v1.S0) and lone r0))) }
reachable Goal { ((S0.(S0 -> S0)).(v1 - v1)) in ((E - Eb).(r0 -> S0)) }
scope S0 = 3, Int = 0..2, steps = 6
