model G8253
sig S0
enum E = Ea | Eb
rel r0: S0 -> some S0
var v1: lone S0
record R { n: Int, b: Bool }
var w0: S0 -> one R
init { (((S0 -> Ea).(Ea -> v1)) = (v1 -> S0) or (S0 -> Eb) in (S0 -> E)) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (R { n: x.w0.n, b: true })
}
action a0(p0_0: S0) {
  (some q1: S0 | #(E - Ea) < 3)
  v1' = p0_0
}
action a1() {
  v1' = ((v1 - S0) - S0)
}
action a2(p2_0: E) {
  (all q2: S0 | some p2_0)
  v1' = S0
}
invariant Inv { (((some ((v1 -> S0).S0) or #(E.(Ea -> S0)) = 2) and (((Ea -> Ea).(Eb -> v1)) = (Eb -> v1) or S0 in ((r0.S0) + (S0.r0)))) or (((Ea -> S0) - (Ea -> v1)) in (Eb -> v1) and not ((some q3: S0 | (q3.w0.n * #S0) = q3.w0.n)))) }
reachable Goal { (v1 -> E) = ((v1 -> Ea) + (v1 -> Ea)) }
scope S0 = 3, Int = 0..2, steps = 6
