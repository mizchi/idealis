model G8144
sig S0
sig S1
enum E = Ea | Eb
rel r0: set E
var v1: E -> one S0
var v2: S1 -> set S0
var w0: S0 -> one Int
init { ((some q1: S0 | #E >= q1.w0) and S1 in ((v2.(S0 -> S0)).((S0 -> S1).S1))) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((k - x.w0))
}
action a0() {
  (some q2: S1 | some q2)
  (some q3: S0 | (2 + 1) >= #Eb)
  v1' = (Eb -> S0)
}
invariant Inv { some (S1.v2) }
reachable Goal { not ((not (some S1) implies (v2 - v2) = (v2.(S0 -> S0)))) }
scope S0 = 2, S1 = 2, Int = -1..2, steps = 6
