model G8225
sig S0
sig S1
rel r0: some S0
rel r1: set S1
var v2: set S1
var v3: S0 -> one S0
var w0: S0 -> one Int
fact { r1 != ((S1 -> S1).(S1.(r1 -> S1))) }
init { ((some q4: S0 | 2 >= (0 + q4.w0)) implies #(v3.r0) >= 3) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  0 = 0
  w0' = w0 - x -> x.w0 + x -> ((#v2 - k))
}
action a0(p0_0: S1, p0_1: S0) {
  ((p0_1.w0 - 1) < (0 + 0) implies some v2)
  v2' = none
}
action a1(p1_0: S1) {
  S0 != S0
  v2' = v2
}
invariant Inv { one ((S1 -> r1).(S0.(S0 -> v2))) }
reachable Goal { lone (((S1 -> S1).r1) - ((S1 -> v2).r1)) }
scope S0 = 3, S1 = 3, Int = -1..2, steps = 6
