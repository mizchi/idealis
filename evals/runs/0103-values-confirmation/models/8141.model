model G8141
sig S0
sig S1
rel r0: set S0
rel r1: set S0
var v2: set S1
var v3: S1 -> set S1
var w0: S0 -> one Bool
fact { (some q1: S1 | one (q1.(S1 -> r1))) }
init { (all q2: S0 | none = v2) }
init { all x: S0 | x.w0 = false }
action set0(x: S0) {
  not x.w0
  w0' = w0 - x -> x.w0 + x -> (false)
}
action a0(p0_0: S0, p0_1: S1) {
  p0_0.w0
  v3' = ((S1 -> S0).((r1 -> v2).v3))
}
action a1(p1_0: S0, p1_1: S1) {
  v3' = (v2 -> S1)
}
invariant Inv { (not ((some q4: S0 | q4.w0)) and #(v2 & S1) = 0) }
reachable Goal { ((some q9: S0 | not q9.w0) implies (#r0 = 2 and lone (((S0 -> S1) + (S0 -> v2)).v2))) }
scope S0 = 3, S1 = 3, steps = 6
