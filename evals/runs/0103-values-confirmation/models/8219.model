model G8219
sig S0
rel r0: set S0
var v1: S0 -> set S0
var v2: S0 -> set S0
init { ((r0 -> r0).v2) in (S0 -> S0) }
action a0() {
  v2' = v1
}
action a1(p1_0: S0, p1_1: S0) {
  v1' = v2
}
action a2() {
  (some (v2.r0) or no (v1.(r0.v2)))
  v2' = ((v1.v1).(r0 -> r0))
}
invariant Inv { r0 != ((S0 + r0) - (v1.r0)) }
reachable Goal { (some q1: S0 | (all q2: S0 | (#(r0.v2) >= 1 or one ((S0.v1).(S0 -> q2))))) }
scope S0 = 3, steps = 6
