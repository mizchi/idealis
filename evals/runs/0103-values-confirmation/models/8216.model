model G8216
sig S0
sig S1
rel r0: one S1
var v1: S0 -> set S0
var v2: S0 -> set S0
var w0: S0 -> one Int
fact { #(S1 + S1) <= 0 }
init { ((((r0 -> S0) - (r0 -> S0)).(v2.S0)) not in (r0.(S1 -> S1)) implies #(r0.(S1 -> S0)) <= 3) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  #r0 >= (0 + x.w0)
  w0' = w0 - x -> x.w0 + x -> (2)
}
action a0(p0_0: S1, p0_1: S1) {
  v1' = v2
}
action a1(p1_0: S1) {
  (some ((S1 + none).((r0 -> S0) + (r0 -> S0))) implies no (S0.((S0 -> S1).(r0 -> S0))))
  some (S0 & S0)
  v1' = (S0 -> S0)
}
invariant Inv { not ((some q4: S0 | (some (S0.v2) and some r0))) }
reachable Goal { (some q8: S1 | (not ((S0 -> r0) in (v1.(S0 -> S1))) and (some S0 or (some q9: S0 | q9.w0 >= (q9.w0 * #S0))))) }
scope S0 = 3, S1 = 2, Int = -1..2, steps = 6
