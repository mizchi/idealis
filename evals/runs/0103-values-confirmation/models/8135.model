model G8135
sig S0
rel r0: S0 -> some S0
var v1: S0 -> lone S0
var v2: some S0
fact { lone S0 }
init { (some q1: S0 | ((r0.(v2 -> q1)).(S0.v1)) not in S0) }
action a0(p0_0: S0) {
  v1' = (p0_0 -> v2)
}
action a1(p1_0: S0, p1_1: S0) {
  v2' = (((p1_0 -> p1_1).p1_1).(r0.r0))
}
invariant Inv { not (#((v2 -> S0).S0) != 2) }
reachable Goal { not ((not (some ((S0 -> S0).v2)) and not (one S0))) }
scope S0 = 3, steps = 6
