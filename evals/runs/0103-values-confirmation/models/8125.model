model G8125
sig S0
var v0: S0 -> one S0
var v1: S0 -> set S0
var w0: S0 -> one Int
init { (((v1 & v1).(v0.S0)) != ((S0 -> S0).S0) and #(none + S0) = 1) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  k = x.w0
  w0' = w0 - x -> x.w0 + x -> (x.w0)
}
action a0(p0_0: S0, p0_1: S0) {
  v1' = ((p0_1 -> S0).(p0_0 -> p0_1))
}
action a1() {
  v1' = (S0 -> S0)
}
action a2(p2_0: S0, p2_1: S0) {
  not (p2_1.w0 < p2_0.w0)
  v1' = (S0 -> S0)
}
invariant Inv { #(S0.v0) != 2 }
reachable Goal { S0 not in ((v0.(S0 -> S0)).S0) }
scope S0 = 3, Int = -1..2, steps = 6
