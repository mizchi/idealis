model G8282
sig S0
sig S1
enum E = Ea | Eb
rel r0: S0 -> lone E
var v1: S0 -> one S1
var v2: E -> some E
var w0: S0 -> one Bool
fact { (some q1: S1 | (one S0 implies one ((E -> S0).S0))) }
init { (one ((Eb.(E -> S1)) & (S0.v1)) or ((S0 -> Ea).(Ea -> S0)) = ((S0 -> S0).(S0 -> S0))) }
init { all x: S0 | x.w0 = true }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (false)
}
action a0(p0_0: E) {
  v1' = ((v1.S1) -> S1)
}
action a1(p1_0: S1, p1_1: E) {
  lone E
  v2' = (E -> p1_1)
}
action a2(p2_0: S0) {
  (some S0 or lone S0)
  (#S0 > 1 or #S1 <= 0)
  v1' = (((S0 -> S0).(p2_0 -> S0)).(p2_0 -> S1))
}
invariant Inv { ((v1 - v1).((S1 -> S1).S1)) in (S0 & ((S0 -> Eb).E)) }
reachable Goal { ((all q12: S1 | ((q12 -> q12) = (S1 -> q12) implies Ea != ((v2.Eb) + (q12.(S1 -> E))))) and (some q13: S0 | (E in (q13.(r0 - r0)) or ((Eb -> S1) & (E -> S1)) in ((E -> S1).(S1 -> S1))))) }
scope S0 = 3, S1 = 2, steps = 6
