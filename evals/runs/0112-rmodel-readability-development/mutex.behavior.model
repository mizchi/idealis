model Mutex
sig Proc
sig Lock
var holder: Lock -> lone Proc
init { no holder }
behavior acquire(p: Proc, l: Lock) {
  guard {
    no l.holder
  }
  update {
    holder= holder + l -> p
  }
}
behavior release(p: Proc, l: Lock) {
  guard {
    p in l.holder
  }
  update {
    holder= holder - l -> p
  }
}
invariant OneHolder { all l: Lock | lone l.holder }
invariant NeverHeld { no holder }
reachable Handover { all l: Lock | some l.holder }
reachable TwoLocksOneProc { some p: Proc | #(holder.p) = 2 }
scope Proc = 2, Lock = 2, steps = 6
