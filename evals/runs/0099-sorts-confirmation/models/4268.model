model G4268
sig S0
rel r0: set S0
var v1: S0 -> set S0
var v2: S0 -> some S0
fact { (S0 -> r0) in (S0 -> r0) }
init { (((r0 & S0) & S0) = ((S0 - r0).v1) or one S0) }
action a0(p0_0: S0, p0_1: S0) {
  (some q2: S0 | one ((r0 -> r0).(p0_1 - S0)))
  v2' = ((S0 + S0) -> (S0.v1))
}
action a1(p1_0: S0, p1_1: S0) {
  v2' = (p1_0 -> r0)
}
invariant Inv { (all q3: S0 | (some q4: S0 | (#(q4.v2) > 1 or #(v2.r0) != 0))) }
reachable Goal { (some S0 implies some (S0.v2)) }
scope S0 = 2, steps = 6
