model G4140
sig S0
rel r0: one S0
rel r1: set S0
var v2: S0 -> one S0
var v3: S0 -> one S0
fact { (all q1: S0 | (r0.(q1 -> r0)) in r1) }
init { (some q3: S0 | v3 = (q3 -> r1)) }
action a0(p0_0: S0, p0_1: S0) {
  lone p0_0
  v3' = (r0 -> p0_1)
}
action a1(p1_0: S0, p1_1: S0) {
  (some p1_1 implies #(v2.p1_1) < 0)
  v2' = ((S0 -> r1).(v2.(p1_0 -> p1_0)))
}
action a2(p2_0: S0) {
  not (lone S0)
  v3' = ((v3.v2).v3)
}
invariant Inv { (all q4: S0 | #(r1.v3) < 2) }
reachable Goal { (not (some (v2.r0)) and some r0) }
scope S0 = 3, steps = 6
