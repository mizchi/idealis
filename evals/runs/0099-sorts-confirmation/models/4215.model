  #(S0 - S0) = 1
  v1' = (((S1 -> S1).S1) -> (S0.(S0 -> S0)))
}
invariant Inv { ((S1.(S1 -> S0)) not in (S0.((S0 -> S1).(S1 -> S0))) and ((some ((S0 -> S0).S0) or #(S1 + S1) < 1) and (#(S1.v1) != 1 implies #S0 <= 3))) }
reachable Goal { not (((one ((S1.v1) - (S1.r0)) and ((S1 -> S0) - v1) = v1) and (one S1 implies #(S0.(S0 -> S0)) != 2))) }
scope S0 = 1, S1 = 2, steps = 6
