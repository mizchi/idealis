model G4127
sig S0
sig S1
rel r0: S1 -> set S0
rel r1: S1 -> set S1
var v2: S1 -> lone S0
var v3: S0 -> set S0
init { (#(S1.r1) = 2 implies lone (S1.v2)) }
action a0(p0_0: S0) {
  (((S0 -> S0).((p0_0 -> S1).S1)) = (p0_0 - (v3.S0)) or ((p0_0 -> S1) + (p0_0 -> S1)) in (S0 -> S1))
  (((S0 -> S1).S1) + (p0_0 + S0)) = p0_0
  v2' = (v2 & (S1 -> S0))
}
invariant Inv { ((((S0 -> S0).(S1.(S1 -> S0))) in ((S0 & S0).((S0 -> S0) + v3)) and (some ((S0 -> S1).S1) and some S1)) and ((((S1 -> S1).S1).(S1 -> S0)) = S0 implies (some (S0 + S0) and ((S0 -> S1).(S1 -> S1)) = (S0 -> S1)))) }
reachable Goal { not (not ((((S0 + S0) - (S1.r0)) in (((S0 -> S1).S1) & S0) or #(S1.v2) != 1))) }
scope S0 = 3, S1 = 1, steps = 6
