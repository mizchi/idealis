model G4130
sig S0
rel r0: S0 -> one S0
rel r1: S0 -> set S0
var v2: S0 -> one S0
init { ((S0.r1) not in ((S0.v2).(r1 + r0)) and #(r1.S0) <= 1) }
action a0() {
  (r1 = r0 or S0 not in S0)
  (some q1: S0 | ((r0.r1).S0) != (((q1 -> S0).S0).(S0 -> S0)))
  v2' = (r1.(v2 & (S0 -> S0)))
}
invariant Inv { ((some (r1.S0) and (all q2: S0 | some (r1.(S0.r1)))) or ((some q3: S0 | q3 = ((r1.q3) + (v2.S0))) implies lone S0)) }
reachable Goal { ((#(r0.S0) >= 1 implies (S0 not in S0 and some S0)) and (not (some S0) and some (v2.S0))) }
scope S0 = 3, steps = 6
