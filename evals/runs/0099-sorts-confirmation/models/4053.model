model G4053
sig S0
enum E = Ea | Eb
rel r0: E -> set S0
rel r1: set S0
var v2: some E
var v3: S0 -> some E
init { (all q1: S0 | (Eb.(v2 -> r1)) in ((S0 -> q1).S0)) }
action a0(p0_0: E) {
  (S0 not in ((r0.r1).(Ea -> S0)) and ((S0.(S0 -> S0)) & (S0 + S0)) != (S0 + (v3.E)))
  v3' = ((r1 & none) -> (p0_0.(Ea -> p0_0)))
}
invariant Inv { (((some q4: S0 | #(Ea.(v2 -> E)) >= 2) implies #((S0 -> r1).S0) <= 3) or #((Eb -> Eb).E) = 1) }
reachable Goal { (((some ((S0 -> v2).Ea) or (S0.((S0 -> E).(Eb -> Eb))) in E) or ((S0 -> S0).v3) = ((S0 -> r1).v3)) or ((some q5: S0 | one (S0 - q5)) implies not (lone (((Ea -> S0).r1).(v2 -> S0))))) }
scope S0 = 2, steps = 6
