model G4216
sig S0
rel r0: one S0
rel r1: set S0
var v2: S0 -> set S0
fact { ((S0 -> r1).r1) in (S0.(S0 -> S0)) }
init { (all q2: S0 | q2 in (r0.((q2 -> r0).v2))) }
action a0(p0_0: S0) {
  v2' = (((r0 -> p0_0).r1) -> ((r0 -> r1).S0))
}
invariant Inv { not ((v2.v2) in ((r1 -> r1).v2)) }
reachable Goal { (#S0 >= 3 implies ((one ((v2 + (r1 -> S0)).r0) implies #none <= 0) or (some r1 or some (S0 - S0)))) }
scope S0 = 2, steps = 6
