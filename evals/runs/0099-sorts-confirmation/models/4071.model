model G4071
sig S0
rel r0: some S0
var v1: S0 -> one S0
var v2: S0 -> one S0
fact { (S0 -> r0) = ((S0 -> r0) & (r0 -> S0)) }
init { (r0.((S0 -> r0).v1)) not in ((r0.v2).v1) }
action a0() {
  no ((r0.v1) & r0)
  v1' = ((S0.v2) -> (r0.v2))
}
action a1() {
  (((S0 -> S0).v1) in (r0 -> r0) implies some (none - r0))
  not (no (r0 - (S0.v2)))
  v2' = ((S0.(S0 -> S0)) -> S0)
}
action a2(p2_0: S0) {
  (some r0 or (p2_0 -> r0) in ((p2_0 -> S0) & v2))
  v2' = (r0 -> p2_0)
}
invariant Inv { ((some q1: S0 | (all q2: S0 | some r0)) implies (#r0 > 1 and (#(S0 + S0) != 2 and (r0 -> r0) in v1))) }
reachable Goal { (((no r0 and #(S0 + r0) != 0) and not (#(r0 - r0) = 2)) implies some (r0.v2)) }
scope S0 = 1, steps = 6
