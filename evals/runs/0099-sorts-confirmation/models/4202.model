model G4202
sig S0
rel r0: S0 -> lone S0
var v1: S0 -> set S0
fact { ((all q1: S0 | #q1 != 2) and (some (S0 + S0) and (S0 -> S0) = (S0 -> S0))) }
init { (some S0 or v1 in (r0.r0)) }
action a0(p0_0: S0) {
  (some q2: S0 | #S0 < 0)
  v1' = ((S0 -> S0) + (v1 - v1))
}
action a1() {
  v1' = ((S0 -> S0) - ((S0 -> S0).r0))
}
invariant Inv { ((some (S0.v1) implies (some q3: S0 | (v1.r0) in ((S0 -> q3).v1))) implies (no S0 and (some (S0 - S0) or some S0))) }
reachable Goal { (((S0 -> S0).(S0.(S0 -> S0))) in ((r0.v1).S0) or (S0 not in ((v1.S0) - (S0 & S0)) implies no S0)) }
scope S0 = 3, steps = 6
