model G4272
sig S0
sig S1
var v0: S0 -> set S1
init { (((S0 & S0) & (v0.S1)) in (S0 - (S0.(S0 -> S0))) implies (S0 -> S0) in (S0 -> S0)) }
action a0(p0_0: S1, p0_1: S1) {
  (some q1: S0 | ((p0_1 + S1).(S1 -> S1)) in none)
  v0' = ((S0 - S0) -> (p0_0.(S1 -> p0_0)))
}
action a1(p1_0: S1) {
  some (S1.(S1 -> S0))
  (all q2: S0 | (q2 -> p1_0) in v0)
  v0' = v0
}
invariant Inv { not ((((S0 -> S0).(S0 & S0)) not in S0 implies (some (v0.(S1 + S1)) and some S1))) }
reachable Goal { not (((S1 -> S1) in (S1 -> S1) and ((((S0 -> S0).v0).S1) not in (S0 - none) or some (S0 + S0)))) }
scope S0 = 1, S1 = 3, steps = 6
