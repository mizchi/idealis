model G4210
sig S0
sig S1
var v0: S0 -> set S1
init { not (S1 = (S0.v0)) }
action a0(p0_0: S0, p0_1: S0) {
  ((S1 -> S1).(S1 -> S1)) = ((S1 -> p0_0).v0)
  (((S1 -> S1).(S1 -> S1)) = ((S1 -> S0).v0) or some (S1 - S1))
  v0' = (p0_0 -> ((S1 -> S1).S1))
}
action a1(p1_0: S1) {
  ((p1_0 -> S0) in (p1_0 -> S0) implies S0 not in (((S0 -> S1).(S1 -> S1)).S1))
  v0' = v0
}
action a2(p2_0: S0, p2_1: S0) {
  v0' = v0
}
invariant Inv { ((((S1 -> S1).(S1 -> S1)) = (S1 -> S1) implies not (S0 = ((v0.(S1 -> S0)).S0))) and some (S0.((S0 -> S0).v0))) }
reachable Goal { some (S0.v0) }
scope S0 = 1, S1 = 2, steps = 6
