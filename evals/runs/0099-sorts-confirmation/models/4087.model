model G4087
sig S0
enum E = Ea | Eb
rel r0: set S0
var v1: E -> set S0
var v2: S0 -> some S0
init { (#(Ea & Ea) >= 0 implies (v2.(S0 -> E)) in (S0 -> Eb)) }
action a0() {
  v2' = (S0 -> (v2.S0))
}
action a1(p1_0: S0, p1_1: E) {
  one ((p1_0 -> E).E)
  #p1_0 < 1
  v1' = (Eb -> p1_0)
}
action a2(p2_0: S0) {
  (some ((Eb -> Ea).E) or ((Ea -> E).v1) = (E -> r0))
  #(r0 & S0) != 1
  v1' = (v1 - ((E -> Eb).v1))
}
invariant Inv { (((Ea -> Ea).(v1.S0)) != (r0.(v2.(r0 -> Ea))) implies ((((r0 -> E).(Eb -> E)).(Eb.(Eb -> Eb))) != r0 implies (#none = 3 and ((Eb.(E -> Ea)).(Eb -> Eb)) != ((Ea -> S0).(r0 + r0))))) }
reachable Goal { (((some Ea implies some (v1.r0)) or ((r0 -> Eb) in ((r0 -> E) - (S0 -> E)) and r0 in ((Ea.(Eb -> S0)).v2))) or (#(Ea + E) <= 0 implies #(Ea + E) > 2)) }
scope S0 = 3, steps = 6
