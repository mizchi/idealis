model G4244
sig S0
sig S1
rel r0: lone S1
rel r1: S1 -> set S0
var v2: S1 -> lone S0
var v3: S0 -> some S1
fact { some S0 }
init { (some q1: S0 | no (((q1 -> S0).q1).((S0 -> r0) & v3))) }
action a0() {
  (r0.((r0 -> S1) + (r0 -> S1))) = ((S1 -> r0).((r0 -> r0).S1))
  v3' = v3
}
action a1(p1_0: S1) {
  #r0 <= 3
  (some (r1.S0) or (((p1_0 -> S0) + (p1_0 -> S0)).S0) in (((r0 -> S1).S1) - r0))
  v2' = ((S0.v3) -> S0)
}
action a2(p2_0: S0, p2_1: S1) {
  v3' = (p2_0 -> S1)
}
invariant Inv { ((some q2: S0 | (some (v3.r0) implies (v2.(q2 -> S0)) in v2)) or some r0) }
reachable Goal { ((((S0.(S0 -> S1)) = ((S0.v3) & r0) or (r0.(r0 -> r0)) not in ((none + S1) + r0)) implies ((((S0 -> S0).S0).((S0 -> r0).r1)) in ((S0 -> S0).((S0 -> S0).S0)) and no ((v3.S1).((S0 -> S0).(S0 -> S0))))) and (not ((S0 -> S1) = v3) and some S0)) }
scope S0 = 3, S1 = 2, steps = 6
