model G4151
sig S0
rel r0: S0 -> some S0
var v1: S0 -> some S0
fact { ((#(S0 & S0) = 2 and #(r0.S0) >= 0) and (#S0 != 2 or (S0 -> S0) in (r0 - (S0 -> S0)))) }
init { (all q1: S0 | (q1 -> q1) = (v1 & r0)) }
action a0(p0_0: S0) {
  #p0_0 > 3
  some p0_0
  v1' = ((p0_0.(p0_0 -> S0)) -> (p0_0 - p0_0))
}
invariant Inv { #(S0.v1) < 1 }
reachable Goal { (((some none implies some S0) implies (some q2: S0 | some ((S0.(S0 -> q2)).v1))) and ((no S0 or some (v1.S0)) and not (lone ((S0 & S0).(v1 & (S0 -> S0)))))) }
scope S0 = 3, steps = 6
