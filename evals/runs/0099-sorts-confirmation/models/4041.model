model G4041
sig S0
sig S1
enum E = Ea | Eb
rel r0: S0 -> some S0
var v1: S0 -> one S1
var v2: S1 -> one S1
init { (#(S0.v1) != 3 and ((v2.(S1 -> Eb)).Eb) != (Ea.(Ea -> S1))) }
action a0(p0_0: E) {
  some (S0 - S0)
  one (S0 & (none + S0))
  v1' = ((r0.S0) -> (Ea.(p0_0 -> S1)))
}
action a1(p1_0: E, p1_1: S1) {
  (no (((S0 -> S0).v1).(S1 + p1_1)) implies S0 = ((S0 -> S1).(S1.(S1 -> p1_1))))
  v2' = ((v2 + v2).v2)
}
action a2() {
  not (Ea != Eb)
  not (((S1 -> Ea).(Eb -> S1)) = (S1 -> S1))
  v1' = v1
}
invariant Inv { ((((S0.(S0 -> Ea)) != E implies (S1.(S1 -> S1)) = (((Eb -> S1).S1).(Ea -> S1))) or (v1.S1) = S0) or (S1 -> Eb) = (S1 -> Eb)) }
reachable Goal { (all q1: S0 | some (S1.v2)) }
scope S0 = 3, S1 = 1, steps = 6
