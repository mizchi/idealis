model G4098
sig S0
enum E = Ea | Eb
var v0: S0 -> some S0
init { (((S0 -> Ea).E).v0) in S0 }
action a0(p0_0: S0) {
  (S0 in (v0.S0) implies #Ea < 0)
  (some (S0.(p0_0 -> Ea)) implies p0_0 not in ((v0 - v0).S0))
  v0' = v0
}
action a1(p1_0: S0, p1_1: S0) {
  v0' = (((S0 -> Ea).Eb) -> (E.(Ea -> p1_0)))
}
invariant Inv { not (v0 = ((S0 -> Ea).(Ea -> S0))) }
reachable Goal { ((not (no (Ea.(Ea -> S0))) or (#(E.(Eb -> E)) = 3 implies ((v0.S0).(S0 -> S0)) not in S0)) or ((S0 -> E).(Ea -> Ea)) in ((S0 -> Eb) - (S0 -> E))) }
scope S0 = 3, steps = 6
