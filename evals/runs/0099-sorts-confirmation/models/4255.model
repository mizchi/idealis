model G4255
sig S0
rel r0: one S0
var v1: S0 -> lone S0
init { (all q1: S0 | (S0 -> r0) = (v1 - v1)) }
action a0(p0_0: S0, p0_1: S0) {
  some (r0.v1)
  v1' = ((v1.(S0 -> p0_0)) + v1)
}
action a1() {
  ((S0 -> r0) = v1 and some S0)
  v1' = ((S0.(S0 -> S0)) -> ((r0 -> r0).S0))
}
action a2(p2_0: S0, p2_1: S0) {
  (all q2: S0 | some ((S0 -> S0).p2_0))
  v1' = v1
}
invariant Inv { not ((all q3: S0 | some (S0.v1))) }
reachable Goal { v1 = v1 }
scope S0 = 1, steps = 6
