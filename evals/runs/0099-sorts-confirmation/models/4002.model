model G4002
sig S0
rel r0: S0 -> one S0
var v1: S0 -> lone S0
var v2: S0 -> set S0
fact { some ((S0 -> S0).S0) }
init { (some S0 and v1 = (v1.v1)) }
action a0(p0_0: S0) {
  v1' = v1
}
action a1(p1_0: S0) {
  not ((r0.v1) = v1)
  (#p1_0 < 2 implies one S0)
  v1' = (v1 & (S0 -> S0))
}
action a2(p2_0: S0, p2_1: S0) {
  ((p2_1 & S0).(p2_1 -> S0)) in (S0 & p2_1)
  v2' = ((r0.S0) -> (r0.p2_0))
}
invariant Inv { ((r0.r0) = v2 and ((#(S0.(S0 -> S0)) <= 2 and S0 = (S0 - S0)) implies not (no S0))) }
reachable Goal { not ((S0 -> S0) = (v2 & (S0 -> S0))) }
scope S0 = 3, steps = 6
