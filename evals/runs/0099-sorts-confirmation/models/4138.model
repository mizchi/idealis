model G4138
sig S0
rel r0: some S0
rel r1: S0 -> one S0
var v2: S0 -> some S0
init { (r0 -> S0) = v2 }
action a0(p0_0: S0) {
  (r1 in ((r0 -> r0) - r1) and S0 in (((r0 -> r0).S0) - (r0.v2)))
  v2' = (((S0 -> S0).v2).(S0 -> r0))
}
action a1() {
  (one ((r0 - S0) & ((S0 -> r0).r0)) implies lone r0)
  v2' = (((S0 -> r0) + v2).(S0 -> S0))
}
action a2(p2_0: S0, p2_1: S0) {
  #(v2.p2_1) < 2
  v2' = ((S0 & p2_1) -> r0)
}
invariant Inv { r1 in ((r0 -> r0) + v2) }
reachable Goal { some (r0.v2) }
scope S0 = 3, steps = 6
