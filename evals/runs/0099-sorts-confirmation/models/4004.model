model G4004
sig S0
rel r0: S0 -> set S0
var v1: S0 -> one S0
fact { ((#((S0 -> S0).S0) < 0 or some ((S0 -> S0).S0)) and (lone (S0.(r0.(S0 -> S0))) implies #(r0.S0) > 0)) }
init { (r0.v1) = v1 }
action a0(p0_0: S0, p0_1: S0) {
  v1' = (p0_1 -> p0_1)
}
action a1() {
  v1' = r0
}
invariant Inv { (some (v1.S0) or some (S0 + S0)) }
reachable Goal { (no S0 implies (some q4: S0 | (#(q4.v1) < 3 or one S0))) }
scope S0 = 3, steps = 6
