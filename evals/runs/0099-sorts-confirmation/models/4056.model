model G4056
sig S0
sig S1
rel r0: S1 -> some S0
rel r1: S0 -> some S1
var v2: S1 -> set S0
var v3: S0 -> set S0
fact { not (S1 = S1) }
init { (no ((S1 -> S1).S1) and some (S1 + (v2.S0))) }
action a0(p0_0: S1) {
  not ((S0 -> p0_0) in (S0 -> S1))
  v2' = ((S1 -> S1).((S1 -> p0_0).v2))
}
action a1(p1_0: S0, p1_1: S1) {
  (no p1_1 or some S0)
  not (#(S1.(S1 -> S1)) <= 1)
  v3' = ((v3 - v3).v3)
}
action a2() {
  v2' = ((S1.(S1 -> S1)) -> (S1.(S1 -> S0)))
}
invariant Inv { ((S1 -> S1) = (S1 -> S1) or ((lone ((r1.S1) & (S0.v3)) and lone ((r0 & v2).(S0.v3))) or ((S0 -> S0).r1) = (S0 -> S1))) }
reachable Goal { (((#(S0.(S0 -> S0)) >= 3 or #(S1.r0) < 2) or (no S0 or some S1)) and ((all q2: S0 | (q2 & (q2 - S0)) in S0) implies (#(v3.S0) >= 3 or S0 = S0))) }
scope S0 = 1, S1 = 1, steps = 6
