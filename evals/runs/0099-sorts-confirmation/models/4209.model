model G4209
sig S0
rel r0: some S0
var v1: S0 -> some S0
var v2: S0 -> set S0
init { (all q1: S0 | some (S0.v2)) }
action a0() {
  (((r0 -> r0) + (S0 -> r0)) in ((S0 -> S0) - v2) or some (r0 + r0))
  v2' = ((r0 -> r0).(v2.v2))
}
action a1(p1_0: S0) {
  (some (r0.v2) implies some (r0 - r0))
  v2' = ((v2.v2) - ((p1_0 -> S0).v1))
}
action a2(p2_0: S0, p2_1: S0) {
  v2' = ((S0 -> p2_1) - (p2_1 -> p2_0))
}
invariant Inv { (r0 -> r0) in (v2 - (S0 -> r0)) }
reachable Goal { (S0 -> r0) = v1 }
scope S0 = 3, steps = 6
