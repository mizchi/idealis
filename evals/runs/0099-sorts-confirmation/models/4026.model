model G4026
sig S0
sig S1
rel r0: S0 -> one S0
rel r1: some S0
var v2: S1 -> set S1
var v3: set S0
fact { (S0 -> r1) in ((S0 -> S1).(S1 -> r1)) }
init { some ((S1.v2).(S1 -> v3)) }
action a0(p0_0: S1) {
  v2' = ((p0_0 -> r1).(v3 -> p0_0))
}
invariant Inv { some (S1.v2) }
reachable Goal { one ((r1 - v3).(S0 -> v3)) }
scope S0 = 3, S1 = 3, steps = 6
