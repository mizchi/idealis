model G3036
sig S0
sig S1
enum E = Ea | Eb
rel r0: S0 -> set E
rel r1: set S0
var v2: S1 -> set E
fact { (#S0 < 1 or (#r1 < 3 or #((S1 -> Eb).E) < 2)) }
init { (#(S0 + S0) = 0 or #(S1.v2) != 1) }
action a0() {
  (Eb -> S1) in ((E -> S1) & (Eb -> S1))
  (r1 -> r1) in (r1 -> r1)
  v2' = ((S0.(r1 -> S1)) -> (S1.v2))
}
action a1(p1_0: S1) {
  (no Eb or #r1 <= 3)
  v2' = ((S1 -> r1).((S0 -> E).(Eb -> Eb)))
}
invariant Inv { (lone ((S1 & S1).((S1 -> Ea) & v2)) and (some (E & Ea) and (one (S1.v2) implies (((E -> Ea).Eb).((E -> S0) & (Ea -> r1))) not in (E.((Eb -> r1) - (Ea -> r1)))))) }
reachable Goal { no ((Ea -> S1).(v2.E)) }
scope S0 = 2, S1 = 3, steps = 6
