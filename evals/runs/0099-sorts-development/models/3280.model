model G3280
sig S0
enum E = Ea | Eb
var v0: E -> lone E
init { no (((S0 -> Eb).v0).(Eb + Eb)) }
action a0() {
  (some q1: S0 | one ((q1 - S0).((q1 -> S0).(q1 -> S0))))
  #(S0.(S0 -> S0)) = 0
  v0' = (((Ea -> S0).S0) -> ((E -> S0).S0))
}
action a1(p1_0: E, p1_1: S0) {
  v0' = v0
}
action a2(p2_0: S0, p2_1: S0) {
  v0' = ((E -> Ea) & v0)
}
invariant Inv { Ea not in (v0.(Eb.(Eb -> Ea))) }
reachable Goal { one ((E.v0) + (S0.(S0 -> E))) }
scope S0 = 3, steps = 6
