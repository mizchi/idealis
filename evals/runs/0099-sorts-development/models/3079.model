model G3079
sig S0
sig S1
rel r0: one S0
rel r1: S1 -> set S1
var v2: S0 -> some S0
var v3: set S0
fact { (not (#S1 <= 1) or S0 != S0) }
init { (all q1: S1 | one ((v3.(S0 -> S0)).(S0 -> q1))) }
action a0() {
  v3' = (((r0 -> S1).S1) - r0)
}
invariant Inv { not ((((S0 -> S1).S1) not in ((S0.v2) + (v3.v2)) or not (one ((S1.(S1 -> S0)).v2)))) }
reachable Goal { ((all q2: S1 | not ((v3 -> S1) = (v3 -> q2))) or not (not (some ((S1 -> r0).(S1.(S1 -> r0)))))) }
scope S0 = 3, S1 = 2, steps = 6
