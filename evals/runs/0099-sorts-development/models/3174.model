model G3174
sig S0
var v0: one S0
var v1: S0 -> set S0
init { (#(S0.(S0 -> v0)) <= 1 and (((v0 -> S0).v0) - v0) = (v1.(S0 - v0))) }
action a0(p0_0: S0, p0_1: S0) {
  v0' = ((S0 + v0) + p0_0)
}
action a1(p1_0: S0, p1_1: S0) {
  not (v0 = ((v1 - (p1_1 -> S0)).(S0 + v0)))
  v1' = ((v1.p1_0) -> (v1.S0))
}
invariant Inv { (some q1: S0 | (#q1 < 2 implies (q1 -> S0) in v1)) }
reachable Goal { (some q2: S0 | ((one none and no (((S0 -> v0) + v1).v0)) and #S0 >= 1)) }
scope S0 = 1, steps = 6
