model G3290
sig S0
rel r0: S0 -> some S0
rel r1: S0 -> set S0
var v2: S0 -> set S0
init { v2 in (S0 -> S0) }
action a0(p0_0: S0, p0_1: S0) {
  v2' = (p0_1 -> p0_1)
}
invariant Inv { (((some (S0.(S0 -> S0)) or r1 in (v2 + (S0 -> S0))) or (some (S0.r1) and (S0 & S0) = ((r0.S0).r0))) and ((some q1: S0 | some S0) and (some q2: S0 | some (S0.r0)))) }
reachable Goal { (((S0 -> S0) = (S0 -> S0) and (v2 - (S0 -> S0)) = (r0.r0)) and ((some S0 and v2 in (S0 -> S0)) implies (S0 -> S0) = (r1.r0))) }
scope S0 = 3, steps = 6
