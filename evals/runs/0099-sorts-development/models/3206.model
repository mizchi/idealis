invariant Inv { (((#S0 <= 0 implies ((r0.r1).r1) != ((Eb -> S0).S0)) and (some ((S0 -> r0).r0) and (v3.(S0 -> r0)) = ((S0 -> r0).v2))) and ((S0 -> r0) + (S0 -> r0)) in ((S0 -> Ea) & (S0 -> E))) }
reachable Goal { (all q5: S0 | (#((E -> r0).Ea) > 1 or (some (((Eb -> q5).v3).(q5.v3)) or #(v2.r0) != 2))) }
scope S0 = 3, steps = 6
