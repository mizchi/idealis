model G3206
sig S0
enum E = Ea | Eb
rel r0: set E
rel r1: E -> lone E
var v2: E -> one E
var v3: S0 -> some S0
fact { (not ((Ea -> E) = ((Eb -> S0).(S0 -> E))) and (#(r0 - E) != 3 implies (S0 -> Eb) = (S0 -> Eb))) }
