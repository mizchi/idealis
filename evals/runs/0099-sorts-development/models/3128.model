model G3128
sig S0
rel r0: one S0
var v1: S0 -> some S0
fact { (#r0 = 2 implies ((S0 -> S0) + (r0 -> r0)) in ((r0 -> r0) - (S0 -> S0))) }
init { (((r0.v1) & none) != ((S0.(r0 -> S0)).(r0 -> r0)) implies (r0 - (r0.v1)) != ((none + r0) & r0)) }
action a0() {
  (#S0 <= 3 or #(S0.v1) > 2)
  (one S0 or #(S0 & S0) >= 1)
  v1' = (r0 -> ((S0 -> r0).S0))
}
invariant Inv { ((S0 -> S0) - v1) = (v1.(S0 -> r0)) }
reachable Goal { one (r0.v1) }
scope S0 = 2, steps = 6
