model G3249
sig S0
sig S1
rel r0: set S1
rel r1: S1 -> lone S1
var v2: S1 -> some S1
var v3: S0 -> some S0
fact { not ((((r0 - r0).((r0 -> S0) & (S1 -> S0))) not in ((S0 -> S1).(S1 - r0)) implies (r1.((S1 -> S0).S0)) = (((r0 -> r0).r0).(r1 & (S1 -> S1))))) }
init { (all q1: S0 | #(v3.S0) > 3) }
action a0(p0_0: S1) {
  v3' = v3
}
invariant Inv { ((v3.S0).(v3 & v3)) != ((S0 -> S1).r0) }
reachable Goal { (((r0 -> S0) & (r0 -> S0)) = (S1 -> S0) or (((S0 -> S1).r0).(S0 -> S0)) in ((S0.v3) - (S0.v3))) }
scope S0 = 2, S1 = 3, steps = 6
