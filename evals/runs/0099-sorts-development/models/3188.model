model G3188
sig S0
rel r0: S0 -> set S0
rel r1: S0 -> lone S0
var v2: one S0
var v3: S0 -> lone S0
fact { ((all q1: S0 | ((S0 -> S0) + (q1 -> S0)) = (q1 -> q1)) implies (S0 != S0 or some (S0.(S0 -> S0)))) }
init { (((v2 -> v2).(S0 - none)) = S0 implies lone S0) }
action a0(p0_0: S0) {
  v2' = v2
}
invariant Inv { not (not ((((r0.(v2 -> v2)).((S0 -> S0).v2)) not in S0 and #(v2.r0) = 1))) }
reachable Goal { ((r1 in (v2 -> S0) implies (some ((v2 -> S0).v2) or some ((S0.r0) + (r1.v2)))) or (all q2: S0 | (no q2 or no (v2 - (S0.r0))))) }
scope S0 = 3, steps = 6
