model G3121
sig S0
var v0: S0 -> set S0
var v1: S0 -> set S0
init { not ((v1.(S0 -> S0)) in (v0.v1)) }
action a0(p0_0: S0) {
  v1' = (v0.(v0 & (S0 -> p0_0)))
}
action a1(p1_0: S0) {
  (no ((v0.S0).(v0 + v0)) implies ((v0.S0).(S0 -> S0)) in ((p1_0.(S0 -> S0)).((S0 -> p1_0).v1)))
  not (some (p1_0 + S0))
  v0' = (((S0 -> p1_0).p1_0) -> ((p1_0 -> p1_0).S0))
}
action a2(p2_0: S0) {
  (v1.S0) != S0
  some (v0.p2_0)
  v1' = (v1.(p2_0 -> S0))
}
invariant Inv { (all q1: S0 | (some q2: S0 | (#q2 >= 2 and one ((q1 + S0) + (q1.v0))))) }
reachable Goal { ((some q3: S0 | (lone ((q3 -> q3).(q3 + S0)) and no (v1.(S0.v1)))) or not (((S0 -> S0) = (S0 -> S0) or some (v0.S0)))) }
scope S0 = 1, steps = 6
