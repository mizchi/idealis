model G3122
sig S0
sig S1
var v0: S0 -> set S1
init { not (no (none & (S0.v0))) }
action a0(p0_0: S1) {
  (((S0 -> S0).v0) = (S0 -> p0_0) and #(S0.(S0 -> S0)) = 1)
  v0' = (S0 -> (S1.(p0_0 -> p0_0)))
}
invariant Inv { (S0 in S0 or (((S1 -> S1) & (S1 -> S1)) = ((S1 -> S1).(S1 -> S1)) and ((S1 -> S1).((S1 -> S1).S1)) = ((S0.(S0 -> S0)).((S0 -> S1) - v0)))) }
reachable Goal { not (((some S0 or #none < 3) and (some q2: S1 | ((q2 -> S0).v0) in ((S1 -> S1).(q2 -> S1))))) }
scope S0 = 3, S1 = 2, steps = 6
