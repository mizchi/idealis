model G3001
sig S0
rel r0: S0 -> one S0
var v1: S0 -> lone S0
var v2: one S0
fact { (not ((r0 + r0) = (S0 -> S0)) or (#S0 = 0 and lone S0)) }
init { (v1 + v1) in r0 }
action a0() {
  not (no (r0.v2))
  (some v2 or (((v2 -> v2).r0).(S0.(v2 -> S0))) != S0)
  v1' = (v2 -> v2)
}
action a1(p1_0: S0) {
  (some q1: S0 | (v2 -> q1) = (p1_0 -> p1_0))
  v2' = ((p1_0 & p1_0) - none)
}
action a2(p2_0: S0, p2_1: S0) {
  #(v1.S0) < 0
  (r0 + (p2_1 -> S0)) = (v1 - r0)
  v2' = v2
}
invariant Inv { not (not ((v2 -> S0) = (v2 -> v2))) }
reachable Goal { #(S0 + v2) > 2 }
scope S0 = 3, steps = 6
