model G3064
sig S0
enum E = Ea | Eb
rel r0: E -> one E
rel r1: E -> set S0
var v2: S0 -> set E
var v3: set S0
init { (((S0 -> v3) - (S0 -> S0)) = (S0 -> S0) implies some v3) }
action a0(p0_0: E, p0_1: S0) {
  (all q1: S0 | some (E & Ea))
  v2' = v2
}
action a1(p1_0: S0) {
  (((Ea -> v3).S0).(Ea -> E)) != Eb
  v2' = ((v3 -> v3).((S0 -> v3).v2))
}
action a2(p2_0: S0, p2_1: S0) {
  v2' = (p2_0 -> Ea)
}
invariant Inv { (E -> v3) in ((E -> v3) + r1) }
reachable Goal { (#(none - v3) < 3 and (Eb -> v3) in (r0.r1)) }
scope S0 = 3, steps = 6
