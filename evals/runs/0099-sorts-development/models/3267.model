model G3267
sig S0
rel r0: S0 -> lone S0
rel r1: S0 -> some S0
var v2: S0 -> set S0
var v3: set S0
init { lone (((S0 -> v3).v2).(v3.v2)) }
action a0(p0_0: S0, p0_1: S0) {
  (p0_1 -> S0) in (v3 -> p0_1)
  v2' = ((v2.(p0_1 -> p0_1)) - v2)
}
invariant Inv { some (S0 & v3) }
reachable Goal { ((not (#(v3 - v3) != 3) and r1 in ((S0 -> S0).r1)) implies ((lone v3 implies #(none + v3) > 3) and not ((S0 -> v3) = (r0.v2)))) }
scope S0 = 3, steps = 6
