model G3245
sig S0
sig S1
enum E = Ea | Eb
rel r0: S0 -> lone S1
var v1: S1 -> some E
var v2: E -> set S0
fact { not ((E -> S0) = ((Eb -> E).(Ea -> S0))) }
init { some (S1.v1) }
action a0(p0_0: S0, p0_1: S1) {
  ((E -> Eb) = ((E -> Eb) - (E -> Ea)) implies #S1 > 3)
  v1' = ((v1.(E -> p0_0)).((p0_0 -> E) & (p0_0 -> Eb)))
}
action a1() {
  (((Ea -> E) & (E -> Eb)).(S0.(S0 -> E))) = (Eb.(Eb -> Eb))
  (#S0 = 0 and some ((S0 -> Ea).E))
  v1' = ((v1 & (S1 -> Eb)) + v1)
}
action a2(p2_0: E) {
  (some q1: E | (Eb -> S1) in (p2_0 -> S1))
  (S0 -> S0) in (S0 -> S0)
  v2' = (((p2_0 -> S1).(S1 -> S1)).(S1 -> S0))
}
invariant Inv { ((all q2: E | lone ((r0.v1).Ea)) implies (((E.(Eb -> S1)) in ((S1 + S1) - (S1 + S1)) or v1 = v1) implies (all q3: S0 | #Eb >= 2))) }
reachable Goal { (((S1 -> Eb) - (S1 -> E)) = v1 and #S1 >= 0) }
scope S0 = 3, S1 = 3, steps = 6
