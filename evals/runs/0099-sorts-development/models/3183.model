model G3183
sig S0
sig S1
rel r0: some S0
rel r1: one S1
var v2: S0 -> set S0
var v3: S0 -> some S1
fact { (S1 -> S1) = (S1 -> S1) }
init { (some r1 or some (r0.v3)) }
action a0() {
  one ((S0 - r0).((r0 -> S0).(S0 -> S0)))
  (v3 = (v3 + v3) implies #(S0 - S0) = 2)
  v2' = ((v3.(r1 -> r0)) + ((S0 -> S0) & (r0 -> S0)))
}
action a1(p1_0: S0, p1_1: S1) {
  (all q2: S1 | ((p1_0 & p1_0) + (S0 - r0)) = (p1_0 + p1_0))
  v3' = (v3 & v3)
}
action a2(p2_0: S0, p2_1: S0) {
  lone r1
  ((v2 & (S0 -> S0)) = (v2 + (p2_1 -> p2_1)) or (S1 -> r1) = (r1 -> S1))
  v2' = ((v2.v2).(p2_0 -> p2_1))
}
invariant Inv { not (not (((((r0 -> S1).(S1 -> S0)).(r0.v2)) != S0 implies ((r1.(S1 -> S0)) + r0) not in ((v2.S0) - r0)))) }
reachable Goal { ((r1 -> r0) in (S1 -> r0) or (not (r0 not in ((v2.S0).((r0 -> S0) & v2))) implies not (((v2.(S0 -> r1)).((S1 -> S1).r1)) in S0))) }
scope S0 = 3, S1 = 2, steps = 6
