model G3011
sig S0
sig S1
rel r0: one S0
rel r1: S1 -> lone S0
var v2: S0 -> some S1
var v3: some S1
fact { (some q1: S0 | #none > 3) }
init { (#S1 > 3 and (S1 - v3) not in ((S1 -> r0).(v2.v3))) }
action a0(p0_0: S0, p0_1: S0) {
  (all q2: S0 | (p0_0 -> r0) = (p0_0 -> S0))
  some p0_1
  v2' = (((p0_1 -> r0).v2) - (p0_1 -> v3))
}
action a1(p1_0: S1) {
  v3' = (((S0 -> S0).S0).(v2 + v2))
}
invariant Inv { (all q3: S1 | not ((S0 not in (r0 - r0) and some (v3 - q3)))) }
reachable Goal { ((v3.(S1 -> v3)).(r1.(S0 -> S0))) != ((S1.r1) - ((r0 -> r0).S0)) }
scope S0 = 3, S1 = 3, steps = 6
