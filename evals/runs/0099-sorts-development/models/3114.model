model G3114
sig S0
sig S1
enum E = Ea | Eb
rel r0: S0 -> set S1
var v1: S1 -> some S1
var v2: lone E
init { (lone ((S0 - none).(S0 -> Ea)) or (v2 -> E) = (E -> E)) }
action a0(p0_0: E, p0_1: S0) {
  v1' = v1
}
action a1() {
  (S0 -> S0) in (S0 -> S0)
  v1' = (v1 + (S1 -> S1))
}
invariant Inv { ((S1 -> v2).((Eb -> S0).S0)) not in S1 }
reachable Goal { (some (S0.(S0 -> S0)) and #v2 <= 1) }
scope S0 = 3, S1 = 3, steps = 6
