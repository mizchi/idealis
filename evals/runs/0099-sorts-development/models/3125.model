model G3125
sig S0
enum E = Ea | Eb
rel r0: S0 -> some S0
rel r1: S0 -> set S0
var v2: set S0
fact { (no ((Eb & E) & (Ea.(Eb -> E))) and (Ea -> S0) = (E -> S0)) }
init { #(v2.(v2 -> Eb)) != 1 }
action a0() {
  v2' = (((v2 -> v2) - r1).S0)
}
action a1() {
  ((r1 & (S0 -> S0)) in (r0 & r0) or some (S0 + v2))
  ((v2 -> E).((E -> S0).v2)) = none
  v2' = (S0.r0)
}
action a2() {
  #(E + E) >= 3
  v2' = (((S0 -> S0).S0).(v2 -> S0))
}
invariant Inv { (not ((some v2 and ((v2 -> E).((E -> E).E)) not in (Ea.((Eb -> S0) & (Ea -> v2))))) implies (not (some S0) implies (some q1: S0 | some ((E -> E).E)))) }
reachable Goal { ((S0 -> Ea) = (v2 -> E) or ((all q2: E | ((E -> Eb) & (q2 -> Ea)) = (E -> Eb)) implies (all q3: E | no (q3 & (E.(Eb -> E)))))) }
scope S0 = 3, steps = 6
