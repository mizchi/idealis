model G3179
sig S0
var v0: S0 -> some S0
init { (v0.(S0 - S0)) not in (S0.(v0 - (S0 -> S0))) }
action a0() {
  v0' = (S0 -> (v0.S0))
}
action a1() {
  (some S0 and ((S0 -> S0) - (S0 -> S0)) = (S0 -> S0))
  (#(v0.S0) = 0 implies (v0 & v0) = (S0 -> S0))
  v0' = ((v0.v0) + (S0 -> S0))
}
invariant Inv { v0 in (S0 -> S0) }
reachable Goal { ((all q1: S0 | (some q2: S0 | ((S0 -> q1).q1) = ((v0 & (q2 -> q1)).S0))) and ((#(S0 & S0) > 0 or some (S0 & S0)) implies ((v0.(S0 -> S0)) in (v0 - v0) implies S0 not in ((S0 & S0) - (S0.(S0 -> S0)))))) }
scope S0 = 1, steps = 6
