model G3135
sig S0
enum E = Ea | Eb
rel r0: some S0
rel r1: S0 -> some S0
var v2: set E
var v3: E -> some E
fact { (#((E -> Eb).E) = 3 or some ((S0 -> E).E)) }
init { ((E -> v2).(S0.(r0 -> v2))) in E }
action a0() {
  v2' = v2
}
action a1(p1_0: S0, p1_1: E) {
  v3' = (v2 -> (Eb.v3))
}
invariant Inv { (not ((some q1: S0 | ((v3 & v3).(none - E)) in Ea)) and ((Ea -> r0) & (Eb -> S0)) = (Eb -> S0)) }
reachable Goal { ((some ((S0 -> v2).v2) and #(S0.(r0 -> Eb)) > 0) and #E > 3) }
scope S0 = 3, steps = 6
