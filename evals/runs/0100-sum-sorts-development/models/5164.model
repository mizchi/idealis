action a0() {
  lone S1
  v1' = (((S1 -> S0).(S0 -> S1)).(v1.v1))
}
invariant Inv { ((((S0 -> S1) in (S0 -> S1) implies some ((S1 -> S0).S0)) or not (#S1 = 3)) or ((some S1 implies (v1.(S1 -> S0)) in ((S1 -> S0) & (S1 -> S0))) and #S1 > 1)) }
reachable Goal { (((S1 -> S1).v1).(S1.r0)) = (S1.((S1 -> S1).r0)) }
scope S0 = 3, S1 = 3, steps = 6
