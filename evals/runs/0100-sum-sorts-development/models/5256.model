model G5256
sig S0
sig S1
rel r0: S1 -> some S1
rel r1: S0 -> one S1
var v2: S0 -> set S0
fact { S1 = ((S1.(S1 -> S1)) + S1) }
init { (((S0.v2).v2) not in ((v2 - (S0 -> S0)).(v2.S0)) implies (r1 & (S0 -> S1)) = (S0 -> S1)) }
action a0(p0_0: S1) {
  (((S0 + S0).(S0 -> S0)) not in ((r1.S1) & ((S0 -> p0_0).S1)) and (((S0 -> S0).r1).p0_0) != S0)
  ((((S1 -> S1).p0_0) - S1) not in (((S1 -> S0).S0).((S1 -> p0_0).(p0_0 -> S1))) implies lone ((none - S0) - S0))
  v2' = (v2 & (v2.v2))
}
action a1() {
  v2' = ((v2 & (S0 -> S0)) & (S0 -> S0))
}
invariant Inv { not ((((S0 -> S0) = (S0 -> S0) or ((S0.(S0 -> S1)) & (S1 & S1)) != (S1 - S1)) and v2 in (v2.v2))) }
reachable Goal { (((#S0 < 3 or ((S0 -> S0).(none + S0)) != (S0.v2)) implies (some none implies some S0)) and #(S0.r1) > 3) }
scope S0 = 2, S1 = 3, steps = 6
