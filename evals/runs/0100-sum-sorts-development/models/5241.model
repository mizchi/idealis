model G5241
sig S0
sig S1
enum E = Ea | Eb
rel r0: S0 -> set S0
var v1: some S0
var v2: S0 -> set S0
fact { lone ((S0 -> Eb).(E - Ea)) }
init { (some Eb or (E -> v1) in ((E -> v1) + (E -> S0))) }
action a0() {
  #(S0 & v1) > 2
  v1' = S0
}
invariant Inv { not ((((Ea -> S1).S1) = ((Eb -> S1).(S1.(S1 -> S1))) and (lone (S0.(r0 - r0)) and some ((v1 -> Ea).E)))) }
reachable Goal { (lone ((S0 -> v1).((v1 -> S1).S1)) or ((Eb.(E -> v1)).(v1 -> S1)) not in S1) }
scope S0 = 3, S1 = 2, steps = 6
