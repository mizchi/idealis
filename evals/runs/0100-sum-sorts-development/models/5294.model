model G5294
sig S0
rel r0: S0 -> set S0
rel r1: set S0
var v2: S0 -> set S0
var v3: S0 -> set S0
init { (#(r1.r0) >= 2 implies some (v3.S0)) }
action a0() {
  v2' = (r0.(r1 -> S0))
}
action a1(p1_0: S0, p1_1: S0) {
  (some q2: S0 | r1 != ((p1_0 -> r1).p1_0))
  some (r1.(p1_1 -> S0))
  v3' = v3
}
action a2(p2_0: S0, p2_1: S0) {
  v3' = ((S0 -> S0).v3)
}
invariant Inv { (((some ((S0 - S0).v2) implies #(S0.(S0 -> S0)) != 1) or (some none implies lone (S0.v3))) and not (some S0)) }
reachable Goal { ((r1 + r1).((S0 -> S0) - v3)) not in ((S0.(S0 -> r1)) + r1) }
scope S0 = 3, steps = 6
