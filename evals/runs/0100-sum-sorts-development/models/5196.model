model G5196
sig S0
sig S1
type P = S0 + S1
rel r0: S1 -> one S1
var v1: S1 -> one P
var v2: S0 -> set S1
init { (#(v1.P) >= 1 and (v2.r0) = (S0 -> S1)) }
action a0(p0_0: S0, p0_1: S1) {
  (some S1 implies some S0)
  (some p0_1 or ((P -> P) - (P -> P)) in (P -> P))
  v1' = (((S1 -> P) & v1) + (p0_1 -> P))
}
action a1() {
  (some P and #(S0.(S0 -> S0)) > 2)
  v2' = ((v2 & v2).(r0 - (S1 -> S1)))
}
invariant Inv { ((all q4: S1 | (some q5: S1 | some ((P -> P).P))) implies ((((S0 -> S1) & (S0 -> S1)) = (v2.r0) implies one S1) and (((S1 -> P) & v1) in (S1 -> P) or one S1))) }
reachable Goal { (some q10: S1 | (((q10.v1) not in ((S0.(S0 -> S1)).v1) or #(q10.(S1 -> S0)) <= 1) and some ((P.(P -> P)) + ((P -> S0).S0)))) }
scope S0 = 2, S1 = 3, steps = 6
