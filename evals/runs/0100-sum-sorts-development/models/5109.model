model G5109
sig S0
enum E = Ea | Eb
rel r0: one E
var v1: S0 -> one E
init { (all q1: E | E not in ((S0 & none).((S0 -> r0) - v1))) }
action a0(p0_0: E) {
  (one S0 implies some S0)
  some p0_0
  v1' = ((S0 -> S0).((S0 -> S0).v1))
}
action a1(p1_0: E, p1_1: E) {
  (some ((E -> S0).S0) implies lone Ea)
  (some q2: E | #(S0.(S0 -> S0)) >= 1)
  v1' = (S0 -> ((p1_0 -> S0).S0))
}
invariant Inv { (one ((S0 - S0).v1) or some (r0 + Eb)) }
reachable Goal { (((some r0 and lone (S0.(S0 -> S0))) implies #(S0.v1) <= 2) and (#((Ea -> S0).S0) = 1 and r0 in ((E.(r0 -> Eb)) & (Ea - none)))) }
scope S0 = 3, steps = 6
