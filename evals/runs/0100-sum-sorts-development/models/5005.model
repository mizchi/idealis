model G5005
sig S0
sig S1
enum E = Ea | Eb
type P = S0 + S1
rel r0: S0 -> set S0
rel r1: E -> some S1
var v2: lone S0
var v3: one P
fact { ((all q1: E | (P -> E) = (P -> Ea)) or (all q2: S1 | ((Eb -> P).(P -> P)) in (E -> P))) }
init { (#S1 > 0 and one v2) }
action a0(p0_0: S1, p0_1: S0) {
  (some q3: S1 | one none)
  ((S0 - P) & (v3 & none)) = none
  v2' = ((v2 -> p0_1).(p0_1 - p0_1))
}
action a1() {
  v2' = v2
}
action a2(p2_0: E) {
  (some none and (P -> E) in (P -> Ea))
  some S0
  v2' = (((S0 -> S1).(S1 -> S1)).S1)
}
invariant Inv { ((((S0 -> P).(P -> v2)) in (v2 -> S0) or not (some v2)) implies #(v2 + v2) >= 1) }
reachable Goal { some ((Ea -> v2).v2) }
scope S0 = 2, S1 = 3, steps = 6
