model G5095
sig S0
rel r0: S0 -> some S0
var v1: S0 -> one S0
var v2: some S0
fact { (((S0 -> S0) in (S0 -> S0) and none not in none) and not (some S0)) }
init { (S0 -> S0) = v1 }
action a0(p0_0: S0, p0_1: S0) {
  v2' = p0_0
}
invariant Inv { not (S0 in ((v2 -> v2).v2)) }
reachable Goal { some ((S0 -> S0).v2) }
scope S0 = 3, steps = 6
