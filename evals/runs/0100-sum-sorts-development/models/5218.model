model G5218
sig S0
sig S1
rel r0: lone S1
rel r1: some S0
var v2: S1 -> set S1
var v3: S1 -> set S0
fact { (#(S1.(r0 -> S0)) < 0 or (#((r0 -> r1).r1) != 1 implies (r0 -> S1) in ((S1 -> r0) + (S1 -> S1)))) }
init { not (((r0 -> S1) - v2) = (r0 -> S1)) }
action a0(p0_0: S1, p0_1: S0) {
  some (p0_0 - r0)
  v3' = (r0 -> p0_1)
}
action a1(p1_0: S0, p1_1: S1) {
  v2' = (r0 -> S1)
}
invariant Inv { ((some q2: S1 | (some S0 implies some (((r1 -> S0).S0).(S0 -> r1)))) implies S1 in (((S1 -> r0).v3).((r1 -> S0).r1))) }
reachable Goal { (((some ((r1 -> S0).S0) implies v2 = v2) or not ((S0 -> S0) in (r1 -> r1))) or (r1 -> r0) = ((r1 -> S1) + (S0 -> S1))) }
scope S0 = 2, S1 = 3, steps = 6
