model G5146
sig S0
rel r0: S0 -> some S0
rel r1: S0 -> set S0
var v2: S0 -> some S0
fact { ((some S0 and (S0 -> S0) in r0) or (r0 - r0) in ((S0 -> S0).r1)) }
init { (some (v2.(S0.(S0 -> S0))) and some S0) }
action a0(p0_0: S0) {
  v2' = (r0 + (r0 + r1))
}
invariant Inv { ((some q2: S0 | (lone q2 or ((S0 -> S0) + r1) in (S0 -> S0))) and (not (((r0.S0) + (v2.S0)) in ((S0 -> S0).((S0 -> S0).S0))) and (all q3: S0 | (S0 -> q3) = (q3 -> S0)))) }
reachable Goal { (all q5: S0 | no ((q5.v2) - (S0 & S0))) }
scope S0 = 3, steps = 6
