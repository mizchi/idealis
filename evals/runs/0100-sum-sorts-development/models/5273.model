model G5273
sig S0
enum E = Ea | Eb
rel r0: E -> some E
var v1: S0 -> one S0
var v2: E -> set S0
fact { ((#(S0 - S0) != 2 or some (E.((Ea -> S0) & (Eb -> S0)))) or not (((Ea -> S0) & (Ea -> S0)) = (E -> S0))) }
init { #(v2.S0) != 2 }
action a0(p0_0: E, p0_1: S0) {
  one E
  v2' = ((E -> p0_1) - (E -> S0))
}
invariant Inv { ((v1.(S0 -> Ea)).(Ea - Ea)) in (((S0 -> Eb).(Ea -> S0)).((S0 -> E).Eb)) }
reachable Goal { ((some ((E -> Ea).Eb) or not ((v1.S0) not in S0)) or (some q1: E | (some q2: E | #(r0.Ea) >= 0))) }
scope S0 = 3, steps = 6
