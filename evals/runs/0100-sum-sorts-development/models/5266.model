model G5266
sig S0
var v0: S0 -> lone S0
init { (v0 = (S0 -> S0) and some S0) }
action a0(p0_0: S0, p0_1: S0) {
  v0 in v0
  (v0.v0) in ((S0 -> p0_1).(S0 -> S0))
  v0' = v0
}
action a1() {
  v0' = ((v0.(S0 -> S0)) & (S0 -> S0))
}
action a2(p2_0: S0) {
  (p2_0 = S0 implies (S0.(S0 -> p2_0)) in ((v0.p2_0) - (p2_0 - S0)))
  v0' = (p2_0 -> (S0.(S0 -> S0)))
}
invariant Inv { (all q1: S0 | some (q1.v0)) }
reachable Goal { v0 = ((S0 -> S0) - v0) }
scope S0 = 1, steps = 6
