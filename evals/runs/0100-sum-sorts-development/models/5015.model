model G5015
sig S0
rel r0: S0 -> one S0
rel r1: one S0
var v2: S0 -> one S0
var v3: set S0
init { (all q1: S0 | (r1 -> v3) = (r0 + r0)) }
action a0(p0_0: S0, p0_1: S0) {
  (no v3 or #(v2.S0) >= 1)
  #r1 = 3
  v2' = ((r1 -> S0) + (r0.(p0_0 -> r1)))
}
invariant Inv { (((r1 -> v3).r1).(S0 -> S0)) != (S0 - (r0.S0)) }
reachable Goal { ((((none - v3).(v3 -> S0)) not in (r1 & (v2.v3)) and (some q2: S0 | #q2 <= 1)) and (some q3: S0 | #(q3 + S0) = 0)) }
scope S0 = 3, steps = 6
