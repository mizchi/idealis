model G5062
sig S0
rel r0: S0 -> set S0
var v1: S0 -> one S0
var v2: S0 -> set S0
init { ((v1.(S0.r0)) != S0 and S0 in S0) }
action a0(p0_0: S0) {
  (all q1: S0 | lone ((v2 & r0).(q1.v1)))
  v1' = (v2 + v1)
}
invariant Inv { (((some none and #(S0 + S0) <= 0) and ((v2.v2) in v1 or #S0 < 0)) or not ((some (S0 + none) and S0 = (S0 - (S0.v1))))) }
reachable Goal { none in ((v1 - v2).(S0 - S0)) }
scope S0 = 3, steps = 6
