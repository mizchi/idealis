model G5299
sig S0
rel r0: one S0
rel r1: S0 -> some S0
var v2: S0 -> one S0
fact { ((r1.r1) in (r0 -> S0) implies no (r0 - (S0.r1))) }
init { (all q1: S0 | (v2.(S0 -> S0)) in (r0 -> q1)) }
action a0(p0_0: S0, p0_1: S0) {
  (some p0_1 and one ((S0.v2).r1))
  (r0 -> S0) in (p0_1 -> S0)
  v2' = (S0 -> p0_0)
}
action a1(p1_0: S0, p1_1: S0) {
  not (some none)
  (#(p1_0 - p1_1) >= 0 or r0 = ((p1_0 & S0).(v2.v2)))
  v2' = r1
}
invariant Inv { ((r0.r1).(v2 + r1)) != ((v2.S0).(r1.(r0 -> r0))) }
reachable Goal { ((not (lone ((S0 -> r0).S0)) and (#(r0.v2) <= 3 implies #(S0 - S0) >= 1)) and some (S0.v2)) }
scope S0 = 3, steps = 6
