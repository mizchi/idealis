model G5048
sig S0
sig S1
type P = S0 + S1
rel r0: P -> set S0
rel r1: S1 -> set S0
var v2: set S1
var v3: lone S1
init { (one (P.(P -> v2)) or (S1 -> S0) = r1) }
action a0() {
  (lone (((P -> S1).S1) + (S1 + none)) or some S1)
  some (v2.(v3 -> P))
  v3' = v3
}
action a1(p1_0: P, p1_1: S0) {
  v3' = v2
}
action a2(p2_0: P, p2_1: S1) {
  ((P -> P) = ((P -> v3).(v3 -> P)) and some (S1 - none))
  not (some P)
  v2' = ((S0.(S0 -> S0)).(S0 -> v3))
}
invariant Inv { (not (no ((P -> S1).(v3 & v3))) implies ((some S1 implies #(v2.r1) != 2) implies (some q4: S1 | #v3 <= 0))) }
reachable Goal { not ((v2 -> P) = ((S1 -> P) + (v3 -> P))) }
scope S0 = 3, S1 = 3, steps = 6
