model G5036
sig S0
rel r0: S0 -> lone S0
rel r1: S0 -> set S0
var v2: one S0
var v3: one S0
init { ((v3.r1) = ((S0.r1) & (r1.v3)) or (S0 & (S0 - v2)) in (v2.(v3 -> v2))) }
action a0(p0_0: S0, p0_1: S0) {
  v3' = ((v3 -> S0).p0_0)
}
action a1(p1_0: S0, p1_1: S0) {
  not (#(S0 & v2) != 3)
  v2' = S0
}
invariant Inv { (all q1: S0 | (not ((q1 -> q1) in (q1 -> S0)) or (q1 not in q1 and #(v2.(S0 -> v2)) < 3))) }
reachable Goal { not ((r0.(r1.v2)) in S0) }
scope S0 = 3, steps = 6
