model G5096
sig S0
rel r0: S0 -> set S0
rel r1: one S0
var v2: S0 -> one S0
var v3: S0 -> set S0
fact { ((r1 -> S0) in (S0 -> S0) or (some q1: S0 | ((r1.(S0 -> r1)) - (r0.S0)) = q1)) }
init { r0 = v3 }
action a0() {
  some (r0.S0)
  some (r0.r1)
  v3' = (r1 -> ((S0 -> S0).S0))
}
invariant Inv { not (((some q2: S0 | some r1) implies #(r1.v3) > 2)) }
reachable Goal { ((not (no (((r1 -> S0) + v2).S0)) implies not (#(r0.S0) >= 2)) implies #S0 <= 3) }
scope S0 = 3, steps = 6
