model G5080
sig S0
enum E = Ea | Eb
rel r0: some E
rel r1: S0 -> some E
var v2: S0 -> set S0
fact { ((S0 + S0).(S0 -> S0)) not in S0 }
init { (all q3: S0 | v2 = (S0 -> q3)) }
action a0(p0_0: S0, p0_1: E) {
  (lone (p0_1 & (r0 & Ea)) or #((E -> E).E) = 0)
  (((E -> Ea).Eb) != ((Ea -> S0).(p0_0 & S0)) or S0 != S0)
  v2' = ((p0_1.(p0_1 -> S0)) -> (S0.v2))
}
action a1(p1_0: E) {
  (#(Ea.(E -> Eb)) >= 0 implies no (((r0 -> p1_0) & (p1_0 -> Ea)).((r0 -> S0).S0)))
  v2' = ((v2.v2).((S0 -> E).(p1_0 -> S0)))
}
invariant Inv { (some (S0.v2) implies (((S0 -> S0) in v2 and (S0 -> S0) in (v2.v2)) implies (((Eb -> Eb).(r0 & none)) in r0 implies (S0 & S0) in S0))) }
reachable Goal { ((v2 & v2) in (v2 & (S0 -> S0)) and ((all q9: S0 | some (S0 - S0)) or some (v2.S0))) }
scope S0 = 2, steps = 6
