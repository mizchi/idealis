model G5204
sig S0
sig S1
type P = S0 + S1
rel r0: S1 -> lone S1
rel r1: one S0
var v2: S1 -> set S1
fact { S1 = P }
init { (no ((r1 -> P).P) or one (S1 + (v2.S1))) }
action a0() {
  (((r1 -> P).P) + ((r1 -> P).P)) != (((r1 -> P).P) + none)
  (some q1: S0 | #(r1 - S0) >= 1)
  v2' = (((S1 -> P).(P -> S1)) + (v2 & r0))
}
action a1(p1_0: S0) {
  lone S0
  v2' = (S1 -> S1)
}
action a2(p2_0: S1, p2_1: P) {
  not (#(r1 + S0) = 3)
  not ((S0 -> P) = ((S0 -> P) - (S0 -> P)))
  v2' = r0
}
invariant Inv { (#S0 <= 1 or (((S1 -> S1) + r0) = ((S1 -> r1).(r1 -> S1)) or (r1 = S0 and (P.((P -> S1).v2)) in S1))) }
reachable Goal { (v2 in (S1 -> S1) or not (#(P.(P -> S0)) < 2)) }
scope S0 = 2, S1 = 3, steps = 6
