model G5123
sig S0
enum E = Ea | Eb
type P = S0 + E
rel r0: S0 -> set S0
rel r1: set S0
var v2: E -> set S0
var v3: set E
fact { ((lone (S0 & S0) or (S0 - S0) in P) and (S0 in (((Ea -> P).P).(Eb -> S0)) implies #Ea >= 3)) }
init { (r0 in (r0 + r0) or #((P -> v3).v3) != 3) }
action a0(p0_0: S0, p0_1: E) {
  (some (r1.(S0 -> P)) and (P -> P) in (P -> P))
  v2' = ((v3 -> P).(P -> p0_0))
}
action a1(p1_0: P) {
  v3' = (P.(P -> Ea))
}
action a2(p2_0: P) {
  (some r1 or ((S0 - S0) + S0) = ((Eb.(Ea -> v3)).((Ea -> v3).(E -> r1))))
  v2' = (Eb -> (S0 - S0))
}
invariant Inv { (all q1: P | (some q2: E | some (P.(P -> v3)))) }
reachable Goal { (((P -> P) in ((P -> P) + (P -> P)) or (((Eb -> E).(v3 -> Ea)) in (Eb -> E) or (P.(P -> P)) in ((P -> P).P))) and some E) }
scope S0 = 3, steps = 6
