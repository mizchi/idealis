model G5269
sig S0
sig S1
enum E = Ea | Eb
type P = S0 + S1
var v0: S1 -> some S0
init { (((Eb.(Ea -> S1)).v0) not in (((S0 -> P).P).(S0 -> S0)) implies (((S1 -> S1).(S1 -> S1)).(S1 & S1)) in (((S1 -> P).P).(S1 -> S1))) }
action a0(p0_0: S1, p0_1: S0) {
  (#S0 <= 3 and S0 in (p0_1 - (E.(Ea -> S0))))
  v0' = (S1 -> ((S0 -> Ea).Eb))
}
action a1() {
  (all q2: E | ((P.(P -> P)) & ((P -> P).P)) not in S0)
  some S0
  v0' = ((none - S1) -> S0)
}
action a2() {
  v0' = (S1 -> S0)
}
invariant Inv { ((all q4: P | (all q5: E | S1 in ((S1 -> Ea).q5))) or one ((v0.S0) + S1)) }
reachable Goal { (some q6: E | (S1.v0) in S0) }
scope S0 = 1, S1 = 1, steps = 6
