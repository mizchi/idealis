model G5032
sig S0
sig S1
type P = S0 + S1
rel r0: S1 -> set P
var v1: S0 -> set S0
var v2: S1 -> some S0
fact { ((S0 -> S1) = (S0 -> S1) or (all q1: S0 | some (S0 - S0))) }
init { (some (S1.v2) or some (S0.v1)) }
action a0() {
  v1' = (v1 + (v1.(S0 -> S0)))
}
action a1(p1_0: P) {
  v2' = (v2.(v1.v1))
}
invariant Inv { (((all q4: S1 | ((S0.(S0 -> S1)) + S1) != S1) and ((P -> P).(P -> P)) in ((P -> P).(P -> P))) implies (((P -> S0) = (P -> S0) and (S1 -> S0) = v2) and not ((r0 & r0) in r0))) }
reachable Goal { (not ((all q5: P | (S1 - (S1 - S1)) != ((S1.(S1 -> S1)) - S1))) and (some q6: S0 | (some q7: P | v1 in v1))) }
scope S0 = 3, S1 = 3, steps = 6
