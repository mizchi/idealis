model G5279
sig S0
enum E = Ea | Eb
rel r0: some S0
rel r1: set S0
var v2: S0 -> set S0
var v3: S0 -> set S0
init { (v3.v2) in (v2 + v3) }
action a0(p0_0: S0) {
  v3' = v3
}
action a1(p1_0: S0, p1_1: S0) {
  v3' = ((S0.(S0 -> S0)) -> ((r1 -> S0).p1_0))
}
action a2(p2_0: E) {
  (r0.(S0 -> r0)) in none
  (all q1: S0 | ((E -> r0) & (Eb -> S0)) in (E -> r1))
  v3' = (r1 -> (S0.v2))
}
invariant Inv { (some (((r0 -> Eb).Eb).v3) or ((some (((Eb -> S0) & (Ea -> r1)).r1) implies some Eb) and (some S0 or (E -> E) = (E -> Eb)))) }
reachable Goal { (some q4: S0 | ((r1.(v3 + (S0 -> S0))) not in ((Ea - Eb).(E -> r1)) or ((S0 -> E) = (q4 -> Eb) implies ((E -> Ea) & (E -> Eb)) = ((Ea -> Ea) & (E -> Eb))))) }
scope S0 = 1, steps = 6
