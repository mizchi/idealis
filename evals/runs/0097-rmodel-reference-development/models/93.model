model G93
sig S0
sig S1
var v0: some S0
var v1: S1 -> one S1
init { some ((v0 -> S1).S0) }
action a0(p0_0: S1) {
  lone S1
  (some p0_0 and one p0_0)
  v1' = ((v1.v0) -> ((S1 -> v0).S1))
}
invariant Inv { (((some q1: S1 | v1 = (v1 + v1)) or (some v0 implies some ((S0 -> v0).v0))) and ((v1.v1) in (S0 -> v0) implies ((v0.(S1 -> S1)) != ((S1 & v0) & S1) or #(S0.v1) <= 2))) }
reachable Goal { (all q2: S0 | ((#((q2 -> S1).q2) = 1 implies v0 != S1) or not (#(q2.v1) >= 1))) }
scope S0 = 3, S1 = 3, steps = 6
