model G151
sig S0
rel r0: S0 -> set S0
rel r1: some S0
var v2: S0 -> set S0
var v3: S0 -> one S0
init { not (some (v3.r1)) }
action a0(p0_0: S0) {
  #(p0_0 & r1) <= 3
  v2' = ((p0_0 - p0_0) -> ((r1 -> r1).r1))
}
action a1(p1_0: S0, p1_1: S0) {
  v2' = ((v3.(p1_0 -> p1_1)) + ((p1_0 -> S0) + v2))
}
invariant Inv { no ((v2.r0).(r1 + r1)) }
reachable Goal { not (((some q1: S0 | none = S0) implies (no ((v2.r1) & (r1.v3)) and (((S0 -> S0) & (S0 -> S0)).(r1 & S0)) = r1))) }
scope S0 = 2, steps = 6
