model G159
sig S0
sig S1
rel r0: S1 -> lone S0
var v1: S1 -> some S1
var v2: S1 -> lone S0
init { #(S1.v2) = 0 }
action a0() {
  v1' = (S1 -> (S1 + S0))
}
action a1() {
  (some q2: S0 | (S1.(q2 -> S1)) != S0)
  v2' = ((v2.(S1 -> S1)).(S1 -> S1))
}
action a2(p2_0: S1, p2_1: S0) {
  p2_0 not in S1
  v2' = r0
}
invariant Inv { (all q3: S1 | (((q3.(q3 -> S1)) - (v1.S1)) in ((v1.(q3 -> q3)).(r0.q3)) implies #S0 < 0)) }
reachable Goal { (all q4: S0 | ((#q4 != 2 implies S0 in (v2.((q4 -> S1).S0))) or (no ((q4.(S1 -> S1)) - (q4.r0)) and ((S1 & S1).v1) = (S0.v2)))) }
scope S0 = 2, S1 = 3, steps = 6
