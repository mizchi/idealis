model G284
sig S0
sig S1
var v0: S1 -> set S1
init { (((v0 + (S0 -> S0)).((S0 -> S1).S1)) in none and some (S0 - none)) }
action a0(p0_0: S1) {
  (some p0_0 or #(S1 & S1) < 1)
  ((((p0_0 -> S1) & v0).(S1.(S0 -> p0_0))) != (((S0 -> S1).v0).(S0.v0)) and #(S1.(S0 -> S1)) != 0)
  v0' = ((S1.v0) -> S0)
}
action a1(p1_0: S1) {
  not (some (S1.(S1 -> S1)))
  one S0
  v0' = v0
}
action a2() {
  ((((S0 -> S0).S1).(v0 + (S1 -> S1))) in ((v0 & v0).((S1 -> S1).S1)) and (S0 -> S0) in (v0.v0))
  v0' = ((S1.v0) -> ((S0 -> S1).S1))
}
invariant Inv { (((all q1: S1 | ((S0 & S1) - (v0.S1)) not in ((v0.v0).(S0.v0))) or #((S1 -> S0).S1) = 2) implies (v0.S1) not in ((S1 -> S0).(S1 & S0))) }
reachable Goal { (((S1 not in ((S1 -> S0).S1) and (S1.(v0 & v0)) in ((v0.(S1 -> S0)).(S0 & S0))) and (lone (v0.S1) implies some ((S0 -> S0).S0))) or ((some q2: S1 | #(v0.S0) <= 3) and (some q3: S1 | #q3 <= 3))) }
scope S0 = 3, S1 = 1, steps = 6
