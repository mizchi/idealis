model G171
sig S0
rel r0: S0 -> lone S0
rel r1: S0 -> set S0
var v2: S0 -> some S0
var v3: S0 -> set S0
init { r1 in v3 }
action a0(p0_0: S0) {
  v3' = v3
}
action a1(p1_0: S0) {
  v3' = (S0 -> S0)
}
action a2() {
  v2' = (S0 -> (S0 - S0))
}
invariant Inv { (((((v2.(S0 -> S0)).S0) in S0 or #none >= 2) and ((((S0 -> S0).S0) & (S0 - S0)) != (S0 + ((S0 -> S0).S0)) implies some (S0.(S0 -> S0)))) or (some (S0 - S0) or (some q1: S0 | (q1 & (S0 - none)) != S0))) }
reachable Goal { #(v3.S0) = 0 }
scope S0 = 3, steps = 6
