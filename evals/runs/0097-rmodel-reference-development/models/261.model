model G261
sig S0
sig S1
rel r0: S0 -> lone S1
rel r1: S0 -> lone S0
var v2: S1 -> set S1
fact { some (S1.r1) }
init { (#S1 <= 1 and (v2.v2) in r0) }
action a0(p0_0: S0) {
  one ((p0_0 -> p0_0).S1)
  (r1 - r1) = ((S1 -> S1) - v2)
  v2' = ((p0_0 -> S0).(r0 & (p0_0 -> S0)))
}
invariant Inv { not (((#(v2.S1) >= 3 or no S0) or ((S1.r1) not in S0 implies some S0))) }
reachable Goal { (not ((S0.((S0 -> S0).r1)) not in ((v2.S0).(S0 -> S0))) or ((all q1: S1 | some (q1 - S0)) implies not (one ((S0.(S0 -> S1)) + (S1 + none))))) }
scope S0 = 3, S1 = 3, steps = 6
