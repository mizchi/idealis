model G129
sig S0
var v0: S0 -> some S0
var v1: S0 -> set S0
init { (some S0 or (v0 & v0) = ((S0 -> S0).v0)) }
action a0(p0_0: S0) {
  ((p0_0 -> p0_0).p0_0) != p0_0
  v0' = v0
}
action a1() {
  v1' = ((S0 -> S0).((S0 -> S0) & v1))
}
action a2(p2_0: S0, p2_1: S0) {
  some p2_0
  v0' = (v1.(v1 - v0))
}
invariant Inv { #(v1.S0) >= 1 }
reachable Goal { not (((some (S0 - ((S0 -> S0).S0)) implies some (S0.(v0 & v0))) and (S0 -> S0) = (S0 -> S0))) }
scope S0 = 3, steps = 6
