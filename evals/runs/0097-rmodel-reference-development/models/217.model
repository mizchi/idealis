model G217
sig S0
rel r0: S0 -> set S0
rel r1: S0 -> lone S0
var v2: S0 -> some S0
var v3: S0 -> some S0
fact { some S0 }
init { (all q1: S0 | v3 = r1) }
action a0(p0_0: S0, p0_1: S0) {
  v3' = v3
}
action a1(p1_0: S0, p1_1: S0) {
  (one S0 or some S0)
  (one S0 and some (none + p1_0))
  v3' = v2
}
invariant Inv { v2 in v2 }
reachable Goal { ((some q4: S0 | #(v3.S0) > 2) or ((some ((r0.v2).(v2.S0)) and some S0) implies one (S0 & (S0 + S0)))) }
scope S0 = 3, steps = 6
