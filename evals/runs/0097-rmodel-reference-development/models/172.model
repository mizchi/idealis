model G172
sig S0
sig S1
enum E = Ea | Eb
rel r0: E -> set S1
rel r1: one S1
var v2: S1 -> lone E
init { (#(none - S0) > 0 or some (v2.S1)) }
action a0() {
  v2' = (S0 -> E)
}
action a1(p1_0: S0) {
  v2' = ((S0 - p1_0) -> (S1.v2))
}
invariant Inv { (r0.v2) = v2 }
reachable Goal { #(v2.Eb) >= 2 }
scope S0 = 2, S1 = 2, steps = 6
