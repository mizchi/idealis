model G34
sig S0
rel r0: set S0
var v1: S0 -> some S0
fact { #r0 != 2 }
init { (((v1 + v1).S0) = ((v1 & (r0 -> r0)).(S0.v1)) or #S0 != 1) }
action a0(p0_0: S0) {
  some S0
  v1' = ((v1.v1) & (S0 -> S0))
}
action a1(p1_0: S0) {
  v1 = (none -> S0)
  v1' = (none -> (v1.p1_0))
}
invariant Inv { (((r0 in r0 or ((v1.(r0 -> S0)).r0) = S0) implies (v1.v1) = v1) implies (all q1: S0 | (all q2: S0 | #(q1.v1) >= 3))) }
reachable Goal { v1 in (v1 & (r0 -> r0)) }
scope S0 = 1, steps = 6
