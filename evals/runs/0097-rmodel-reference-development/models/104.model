model G104
sig S0
enum E = Ea | Eb
rel r0: lone E
rel r1: set E
var v2: S0 -> one S0
var v3: E -> one S0
fact { lone r1 }
init { ((none -> E) in v2 or (Eb -> r1) = (v2.v2)) }
action a0() {
  v3' = v3
}
action a1(p1_0: S0, p1_1: S0) {
  v2' = v2
}
invariant Inv { (r0 & (S0.v2)) != S0 }
reachable Goal { (v2 in (S0 -> r1) or ((#(r1 - r0) > 2 or some none) implies #(E & E) <= 3)) }
scope S0 = 3, steps = 6
