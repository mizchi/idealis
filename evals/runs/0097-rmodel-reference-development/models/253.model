model G253
sig S0
enum E = Ea | Eb
rel r0: some S0
rel r1: E -> one S0
var v2: S0 -> lone S0
var v3: set S0
fact { (all q1: S0 | (#(Eb.r1) = 2 implies lone (((E -> q1).Ea).((S0 -> Ea) & r1)))) }
init { (#(r1.v3) < 0 implies lone v3) }
action a0(p0_0: S0) {
  v2' = r1
}
action a1(p1_0: S0, p1_1: E) {
  (((S0.v2) + v3) in ((p1_0 -> S0).S0) and ((S0 -> r0).r1) in (v2 + v2))
  (#(p1_0.r1) > 2 and no E)
  v2' = ((S0.(E -> r0)) -> none)
}
action a2() {
  ((v2 & (none -> Ea)) = (r1.(E -> r0)) implies some S0)
  (r1.E) = Eb
  v3' = Ea
}
invariant Inv { (all q2: S0 | not ((one ((v3 + E).(v2 + (r0 -> v3))) implies one ((r1.Eb) - ((Eb -> v3).E))))) }
reachable Goal { not ((no (v3 + (S0 & E)) implies #Ea >= 0)) }
scope S0 = 3, steps = 6
