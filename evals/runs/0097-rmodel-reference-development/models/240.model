model G240
sig S0
rel r0: S0 -> set S0
rel r1: S0 -> set S0
var v2: S0 -> set S0
var v3: one S0
init { (some S0 implies (((S0 -> S0) & v2).v3) in none) }
action a0(p0_0: S0, p0_1: S0) {
  (lone (v3.(v3 -> v3)) or r1 = r1)
  v2' = (S0 -> (r1.p0_0))
}
action a1(p1_0: S0, p1_1: S0) {
  not ((S0 -> v3) in (v3 -> v3))
  lone (v2.(S0.r1))
  v3' = (p1_0 & (v3.r0))
}
action a2(p2_0: S0, p2_1: S0) {
  ((r0.(r1.S0)) not in S0 and ((v2.p2_1).r0) in v3)
  ((v2.r0) in (v2.v2) or one S0)
  v2' = ((v3 -> v3) + r0)
}
invariant Inv { (((v3 -> S0).v3).(r1 & r1)) != S0 }
reachable Goal { (((some q1: S0 | some (r1.q1)) and (lone ((v3.v2) + none) and (none -> S0) = (S0 -> S0))) implies #(v3.r1) < 1) }
scope S0 = 3, steps = 6
