model G21
sig S0
sig S1
rel r0: S1 -> set S1
var v1: S0 -> set S0
var v2: S0 -> one S0
fact { some (S0 - S0) }
init { (((r0 - v1).S0) not in ((none + S1) - ((S0 -> S0).S1)) implies ((S0 -> S0) & (S1 -> S0)) = (S1 -> S0)) }
action a0(p0_0: S1) {
  no (S0 + ((S0 -> S0).p0_0))
  v1' = (none -> (S1.r0))
}
action a1(p1_0: S0, p1_1: S0) {
  not (some p1_0)
  (some ((p1_0 -> p1_1).p1_1) implies ((S1 -> p1_0).v1) = (S0 -> p1_1))
  v2' = (p1_1 -> p1_0)
}
invariant Inv { ((not ((S0 -> S0) = (v1 & v2)) implies ((S0 -> S0) in (none -> S0) or #(S1.v1) >= 0)) implies (not (#S0 < 0) or #(S0.v2) <= 0)) }
reachable Goal { none = (v2.(S0.v1)) }
scope S0 = 2, S1 = 3, steps = 6
