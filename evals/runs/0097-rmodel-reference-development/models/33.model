model G33
sig S0
rel r0: S0 -> some S0
rel r1: set S0
var v2: S0 -> set S0
init { ((v2 + r0) = (v2.v2) or some ((r1 -> S0).r1)) }
action a0() {
  v2' = v2
}
action a1(p1_0: S0) {
  v2' = v2
}
invariant Inv { (((some (S0 & r1) and some (r1 + none)) or (((r1.(r1 -> r1)) + (v2.r1)) not in r1 and lone r1)) or ((some q1: S0 | one ((r1 + r1) - (S0.v2))) or (#(r1 + none) != 1 or some (r1.v2)))) }
reachable Goal { (some S0 implies (v2.(r1 + S0)) != r1) }
scope S0 = 3, steps = 6
