model G29
sig S0
rel r0: S0 -> lone S0
rel r1: one S0
var v2: S0 -> set S0
var v3: set S0
fact { not (one (((S0 -> S0).r1) - (r1.r0))) }
init { (v2 in (r1 -> S0) or ((r1 & S0).(v2.(S0 -> v3))) not in ((r0.r1) + S0)) }
action a0(p0_0: S0) {
  lone S0
  ((((v3 -> r1) + v2).v3) != v3 or no ((r0.r1).(v2.r0)))
  v3' = r1
}
invariant Inv { ((v2.v3) + (v3.r0)) = (v3.(v2.v2)) }
reachable Goal { (some q1: S0 | ((all q2: S0 | r1 = S0) and (lone ((r1 & r1).((S0 -> r1) - (q1 -> v3))) implies some r1))) }
scope S0 = 3, steps = 6
