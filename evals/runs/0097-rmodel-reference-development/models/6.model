model G6
sig S0
rel r0: S0 -> some S0
var v1: S0 -> some S0
fact { (some q1: S0 | not (#(r0.q1) > 0)) }
init { ((S0 -> S0) = v1 implies some S0) }
action a0(p0_0: S0) {
  v1' = (((S0 -> p0_0) - r0).((S0 -> S0).v1))
}
invariant Inv { (not ((v1 & v1) in (v1.r0)) or not (#(S0 & S0) <= 3)) }
reachable Goal { (((some ((S0 -> S0).S0) and ((r0.S0).(S0 -> S0)) != ((S0 -> S0).(v1.S0))) and none in ((v1.S0) - none)) and S0 != ((r0.v1).S0)) }
scope S0 = 3, steps = 6
