model G9
sig S0
rel r0: S0 -> one S0
rel r1: set S0
var v2: S0 -> some S0
var v3: S0 -> lone S0
init { (some (S0.v2) and ((r1 -> S0).S0) in r1) }
action a0(p0_0: S0, p0_1: S0) {
  r1 = (((S0 -> p0_1).r1).r0)
  some p0_0
  v2' = (S0 -> S0)
}
action a1(p1_0: S0, p1_1: S0) {
  (((p1_0 -> r1).r0).p1_1) not in (((S0 -> p1_0).p1_0) & (r1.v3))
  v3' = (r1 -> (r1.(p1_0 -> S0)))
}
invariant Inv { (not (v3 in (r0 & v3)) and #(v2.S0) <= 2) }
reachable Goal { (all q1: S0 | (some q2: S0 | (v3.(q2 -> S0)) in ((S0 -> q2).r0))) }
scope S0 = 3, steps = 6
