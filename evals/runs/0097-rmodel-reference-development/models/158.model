model G158
sig S0
rel r0: S0 -> set S0
rel r1: lone S0
var v2: S0 -> set S0
var v3: some S0
fact { not ((all q1: S0 | #S0 < 3)) }
init { (all q2: S0 | (((v3 -> S0).q2) + (q2.(r1 -> S0))) = r1) }
action a0(p0_0: S0) {
  (r0 = v2 or ((v3 & none) & (S0 + S0)) = S0)
  v2' = r0
}
action a1(p1_0: S0) {
  (none -> none) in (v2.r0)
  not (some S0)
  v2' = ((S0 -> p1_0).(r1 -> S0))
}
action a2() {
  not (((r1.v2).(v2.(v3 -> r1))) = r1)
  v2' = ((r1.v2) -> (S0.(r1 -> v3)))
}
invariant Inv { (r1 - (r1 - S0)) != v3 }
reachable Goal { ((r1 -> v3) & v2) = (v3 -> none) }
scope S0 = 3, steps = 6
