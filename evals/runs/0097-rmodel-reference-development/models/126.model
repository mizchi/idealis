model G126
sig S0
sig S1
rel r0: S0 -> set S0
rel r1: S1 -> some S1
var v2: S0 -> lone S0
init { ((((S0 -> S0) & v2).S0) in S0 or some (S1 - none)) }
action a0() {
  v2' = (S0 -> S1)
}
action a1(p1_0: S1, p1_1: S1) {
  (r1 - (S0 -> S1)) in v2
  (all q1: S1 | #(q1.v2) >= 0)
  v2' = (((S1 -> p1_1).v2).(S1 -> p1_0))
}
action a2() {
  ((S0.(v2 + r1)) = (S1.(v2.v2)) or #S0 > 3)
  v2' = v2
}
invariant Inv { (none -> S0) in v2 }
reachable Goal { ((some (S1.r1) or not (((S0 + S0) & (S1.v2)) not in (S1 - (S0 + S1)))) or (one (r0.S1) and #none >= 0)) }
scope S0 = 3, S1 = 3, steps = 6
