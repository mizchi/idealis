model G271
sig S0
rel r0: S0 -> lone S0
rel r1: S0 -> set S0
var v2: S0 -> lone S0
fact { (r1.r1) in (r1.(S0 -> S0)) }
init { (some (v2.S0) and no S0) }
action a0() {
  ((S0 -> S0) = r1 implies #(S0 + none) > 3)
  v2' = (r0.(r1.(S0 -> S0)))
}
action a1(p1_0: S0) {
  v2' = v2
}
action a2() {
  v2' = ((S0 -> S0).(S0 -> S0))
}
invariant Inv { one ((S0.r0).v2) }
reachable Goal { ((all q5: S0 | (#S0 <= 1 and one (q5.(v2.r1)))) implies #S0 = 0) }
scope S0 = 3, steps = 6
