  "inputs": [
    {
      "name": "record-12-safe",
      "source": "---- MODULE Differential ----\nEXTENDS Naturals, TLC\nCONSTANT Nodes\nVARIABLE local\nSymm == Permutations(Nodes)\nInit == local = [n \\in Nodes |-> [term |-> 0, ready |-> FALSE]]\nNext == \\/ (\\E n \\in Nodes: local' = [local EXCEPT ![n].term = IF @ < 2 THEN @ + 1 ELSE 0])\n        \\/ (\\E n \\in Nodes: local' = [local EXCEPT ![n].ready = ~@])\nSafe == \\A n \\in Nodes: local[n].term <= 2\n====",
      "config": "CONSTANT Nodes={p0,p1,p2,p3,p4,p5,p6,p7,p8,p9,p10,p11}\nINIT Init\nNEXT Next\nINVARIANT Safe\nSYMMETRY Symm"
    },
    {
      "name": "record-5-safe",
      "source": "---- MODULE Differential ----\nEXTENDS Naturals, TLC\nCONSTANT Nodes\nVARIABLE local\nSymm == Permutations(Nodes)\nInit == local = [n \\in Nodes |-> [term |-> 0, ready |-> FALSE]]\nNext == \\/ (\\E n \\in Nodes: local' = [local EXCEPT ![n].term = IF @ < 2 THEN @ + 1 ELSE 0])\n        \\/ (\\E n \\in Nodes: local' = [local EXCEPT ![n].ready = ~@])\nSafe == \\A n \\in Nodes: local[n].term <= 2\n====",
      "config": "CONSTANT Nodes={p0,p1,p2,p3,p4}\nINIT Init\nNEXT Next\nINVARIANT Safe\nSYMMETRY Symm"
    },
    {
      "name": "sets-5-safe",
      "source": "---- MODULE Differential ----\nEXTENDS TLC\nCONSTANT Nodes\nVARIABLES first, second\nSymm == Permutations(Nodes)\nInit == /\\ first = {} /\\ second = {}\nNext == \\/ (\\E n \\in Nodes: /\\ first' = (IF n \\in first THEN first \\ {n} ELSE first \\cup {n}) /\\ UNCHANGED second)\n        \\/ (\\E n \\in Nodes: /\\ second' = (IF n \\in second THEN second \\ {n} ELSE second \\cup {n}) /\\ UNCHANGED first)\nSafe == /\\ first \\subseteq Nodes /\\ second \\subseteq Nodes\n====",
      "config": "CONSTANT Nodes={p0,p1,p2,p3,p4}\nINIT Init\nNEXT Next\nINVARIANT Safe\nSYMMETRY Symm"
    },
    {
      "name": "joint-5",
      "source": "---- MODULE Differential ----\nEXTENDS TLC\nCONSTANT Nodes\nVARIABLES first, second\nSymm == Permutations(Nodes)\nInit == /\\ first = [n \\in Nodes |-> FALSE] /\\ second = [n \\in Nodes |-> FALSE]\nNext == \\/ (\\E n \\in Nodes: /\\ first' = [first EXCEPT ![n] = ~@] /\\ UNCHANGED second)\n        \\/ (\\E n \\in Nodes: /\\ second' = [second EXCEPT ![n] = ~@] /\\ UNCHANGED first)\nSafe == /\\ first \\in [Nodes -> BOOLEAN] /\\ second \\in [Nodes -> BOOLEAN]\n====",
      "config": "CONSTANT Nodes={p0,p1,p2,p3,p4}\nINIT Init\nNEXT Next\nINVARIANT Safe\nSYMMETRY Symm"
    },
    {
      "name": "counter-product",
      "states": 81,
      "generated": 325,
      "initialStates": 1,
      "layerWidth": 19,
      "faultPredicate": "a+b+c+d < 4*(M-1)",
      "source": "---- MODULE CounterProduct ----\nEXTENDS Naturals\nCONSTANT M\nVARIABLES a,b,c,d\nInit == a=0 /\\ b=0 /\\ c=0 /\\ d=0\nStepa == a' = (IF a<M-1 THEN a+1 ELSE 0) /\\ UNCHANGED <<b,c,d>>\nStepb == b' = (IF b<M-1 THEN b+1 ELSE 0) /\\ UNCHANGED <<a,c,d>>\nStepc == c' = (IF c<M-1 THEN c+1 ELSE 0) /\\ UNCHANGED <<a,b,d>>\nStepd == d' = (IF d<M-1 THEN d+1 ELSE 0) /\\ UNCHANGED <<a,b,c>>\nNext == Stepa \\/ Stepb \\/ Stepc \\/ Stepd\nSafe == a \\in 0..(M-1) /\\ b \\in 0..(M-1) /\\ c \\in 0..(M-1) /\\ d \\in 0..(M-1)\n====",
      "config": "CONSTANT M=3\nINIT Init\nNEXT Next\nINVARIANT Safe"
    },
    {
      "name": "function-cube",
      "states": 16,
      "generated": 65,
      "initialStates": 1,
      "layerWidth": 6,
      "faultPredicate": "nodes[1]=0",
      "source": "---- MODULE FunctionCube ----\nEXTENDS Naturals\nCONSTANT N\nVARIABLE nodes\nInit == nodes = [node \\in 1..N |-> 0]\nNext == \\E node \\in 1..N: nodes' = [nodes EXCEPT ![node] = 1-@]\nSafe == nodes \\in [1..N -> 0..1]\n====",
      "config": "CONSTANT N=4\nINIT Init\nNEXT Next\nINVARIANT Safe"
    },
    {
      "name": "parallel-channels",
      "states": 64,
      "generated": 193,
      "initialStates": 1,
      "layerWidth": 14,
      "faultPredicate": "\\A node \\in 1..N: chan[node].val=0",
      "source": "---- MODULE ParallelChannels ----\nEXTENDS Naturals\nCONSTANT N\nVARIABLE chan\nInit == chan = [node \\in 1..N |-> [val |-> 0, rdy |-> 0, ack |-> 0]]\nSend(node,message) == /\\ chan[node].rdy=chan[node].ack\n                      /\\ chan'=[chan EXCEPT ![node].val=message, ![node].rdy=1-@]\nRcv(node) == /\\ chan[node].rdy # chan[node].ack\n             /\\ chan'=[chan EXCEPT ![node].ack=1-@]\nNext == \\E node \\in 1..N: (\\E message \\in {0,1}: Send(node,message)) \\/ Rcv(node)\nSafe == chan \\in [1..N -> [val:{0,1}, rdy:{0,1}, ack:{0,1}]]\n====",
      "config": "CONSTANT N=2\nINIT Init\nNEXT Next\nINVARIANT Safe"
    },
    {
      "name": "linear-ring",
      "states": 17,
      "generated": 18,
      "initialStates": 1,
      "layerWidth": 1,
      "faultPredicate": "x<N-1",
      "source": "---- MODULE LinearRing ----\nEXTENDS Naturals\nCONSTANT N\nVARIABLE x\nInit == x=0\nNext == x'=IF x<N-1 THEN x+1 ELSE 0\nSafe == x \\in 0..(N-1)\n====",
      "config": "CONSTANT N=17\nINIT Init\nNEXT Next\nINVARIANT Safe"
    }
