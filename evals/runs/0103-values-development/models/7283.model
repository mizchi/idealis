model G7283
sig S0
var v0: S0 -> some S0
var v1: S0 -> set S0
var w0: S0 -> one Int
init { one ((S0.v1) - (S0 + S0)) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((k * 2))
}
action a0() {
  v0' = (v1.(S0 -> S0))
}
action a1(p1_0: S0) {
  #p1_0 >= (0 * #S0)
  v0' = v1
}
invariant Inv { (all q4: S0 | (((S0 -> S0) in v1 implies (q4 -> q4) = (q4 -> S0)) implies (v0 = (S0 -> q4) or q4 not in ((q4.(S0 -> q4)) - (S0.v1))))) }
reachable Goal { v1 = (v0 & v0) }
scope S0 = 3, Int = -1..2, steps = 6
