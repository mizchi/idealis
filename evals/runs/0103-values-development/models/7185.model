model G7185
sig S0
sig S1
rel r0: set S0
var v1: S0 -> some S0
var v2: S1 -> set S1
var w0: S0 -> one Int
var w1: S0 -> one Bool
fact { (all q1: S1 | #q1 <= 0) }
init { ((S0.v1).(S0 -> S0)) in S0 }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = false }
action set0(x: S0, k: Int) {
  x.w1
  w0' = w0 - x -> x.w0 + x -> (x.w0)
}
action set1(x: S0) {
  not x.w1
  w1' = w1 - x -> x.w1 + x -> (true)
}
action a0() {
  (some q3: S0 | q3.w1)
  v2' = ((v2.(S1 -> S1)).v2)
}
action a1(p1_0: S1) {
  v1' = v1
}
action a2(p2_0: S0) {
  p2_0.w1
  (one ((none + S0).(r0 -> S1)) and some r0)
  v1' = ((v1.v1).v1)
}
invariant Inv { ((#(S1 & S1) > 0 implies not (#(S1.v2) > 2)) and #((S1 -> S1).S1) > 2) }
reachable Goal { not ((v1.v1) = v1) }
scope S0 = 3, S1 = 1, Int = -1..2, steps = 6
