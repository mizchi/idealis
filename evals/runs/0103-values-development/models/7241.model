model G7241
sig S0
sig S1
enum E = Ea | Eb
rel r0: S1 -> some S1
rel r1: lone E
var v2: E -> set E
var w0: S0 -> one Int
var w1: S0 -> one Bool
fact { not (((S0 -> Eb) = (S0 -> r1) or some (r1.((r1 -> S0).(S0 -> S0))))) }
init { (((S1 -> Eb).r1).((S1 -> r1).v2)) = r1 }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = false }
action set0(x: S0, k: Int) {
  k > 2
  w0' = w0 - x -> x.w0 + x -> (x.w0)
}
action set1(x: S0) {
  w1' = w1 - x -> x.w1 + x -> (true)
}
action a0(p0_0: E, p0_1: S1) {
  v2' = (r1 -> E)
}
action a1() {
  v2' = (((E -> E).(Eb -> S1)).((S1 -> Ea) - (S1 -> Eb)))
}
invariant Inv { (all q11: S1 | not (lone (((Eb -> E) & v2).((E -> S0).S0)))) }
reachable Goal { (((some q20: E | (v2.(E -> S0)) in (r1 -> S0)) or not (some ((S0 & S0) & ((S0 -> S1).S1)))) or #((r1 -> S1).S1) <= 2) }
scope S0 = 3, S1 = 3, Int = -1..2, steps = 6
