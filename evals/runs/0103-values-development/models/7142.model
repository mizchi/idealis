model G7142
sig S0
enum E = Ea | Eb
rel r0: set E
rel r1: set E
var v2: E -> some S0
var w0: S0 -> one Int
init { lone ((v2.S0).v2) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (k)
}
action a0(p0_0: E, p0_1: S0) {
  v2' = v2
}
action a1() {
  v2' = (v2.(S0 -> S0))
}
action a2() {
  v2' = (Ea -> S0)
}
invariant Inv { r1 not in ((v2.(S0 -> r0)).Eb) }
reachable Goal { some (v2.S0) }
scope S0 = 3, Int = -1..2, steps = 6
