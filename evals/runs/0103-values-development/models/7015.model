model G7015
sig S0
sig S1
rel r0: S1 -> lone S0
rel r1: S1 -> set S1
var v2: one S0
var v3: lone S1
record R { n: Int, b: Bool }
var w0: S0 -> one Bool
var w1: S0 -> one R
init { ((v3 -> v2).(S0 -> v2)) in r0 }
init { all x: S0 | x.w0 = true }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (false)
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: (0 * x.w1.n), b: false })
}
action a0(p0_0: S0, p0_1: S1) {
  not p0_0.w0
  v2' = v2
}
action a1(p1_0: S0) {
  not p1_0.w0
  2 = (0 * 1)
  v2' = ((v3 & S1).r0)
}
action a2() {
  (S0 = S0 implies ((v2 -> v2) + (S0 -> v2)) = ((v2 -> v2) - (v2 -> S0)))
  ((S0 -> S0) in (v2 -> v2) implies ((v2 -> S0).(v2.(S0 -> S0))) not in (S0.((S0 -> S0) - (v2 -> S0))))
  v2' = (((v2 -> v3).S1) & (S0.(S0 -> v2)))
}
invariant Inv { (some (S1 - S1) and not ((#v2 >= 3 implies some S1))) }
reachable Goal { no ((S0 -> S0).((S0 -> v2).S0)) }
scope S0 = 2, S1 = 1, Int = 0..2, steps = 6
