model G7174
sig S0
sig S1
rel r0: some S1
rel r1: S0 -> set S1
var v2: S1 -> some S0
var v3: S0 -> some S1
var w0: S0 -> one Int
init { v2 in ((r0 -> r0).(r0 -> S0)) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((k * 2))
}
action a0(p0_0: S0, p0_1: S0) {
  p0_0.w0 > #r0
  (p0_1.w0 + p0_1.w0) < (0 + p0_0.w0)
  v2' = (v2.(S0 -> S0))
}
invariant Inv { (all q5: S0 | ((no (((S1 -> r0).r0) - S1) or some (S1.(r0 -> r0))) implies v3 in (r1 + r1))) }
reachable Goal { (all q6: S1 | not (((r1 + r1).S1) != ((v3.S1) & S0))) }
scope S0 = 3, S1 = 2, Int = -1..2, steps = 6
