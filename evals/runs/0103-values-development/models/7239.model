model G7239
sig S0
rel r0: S0 -> lone S0
rel r1: S0 -> one S0
var v2: S0 -> one S0
var v3: S0 -> one S0
fact { #none <= 3 }
init { v3 in (r1.v2) }
action a0() {
  (some q1: S0 | #(q1 & none) = 2)
  (((S0 -> S0).r1) = (S0 -> S0) or (S0 -> S0) in (S0 -> S0))
  v3' = ((S0 & S0) -> (S0 - none))
}
action a1(p1_0: S0) {
  v3' = ((r0.v2) & (r0.(p1_0 -> p1_0)))
}
invariant Inv { ((some (S0 + S0) implies (r1 & r1) = (r1.v2)) or not (((v3 - v3) in (S0 -> S0) and #(S0 + S0) < 0))) }
reachable Goal { ((not ((r0.v2) = (S0 -> S0)) and not (some (v2.S0))) and not ((#S0 != 1 implies S0 in (((S0 -> S0).S0) - (S0 + S0))))) }
scope S0 = 3, steps = 6
