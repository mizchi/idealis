model G7122
sig S0
var v0: S0 -> one S0
var v1: lone S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one R
init { (no v1 implies (some q1: S0 | 1 <= (1 * q1.w1.n))) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((#x + x.w0))
}
action set1(x: S0, k: Int) {
  k <= (x.w1.n * x.w0)
  w1' = w1 - x -> x.w1 + x -> (R { n: (0 + #v1), b: false })
}
action a0(p0_0: S0) {
  v1' = (((v1 -> v1).v0).(v1 & p0_0))
}
action a1(p1_0: S0) {
  (some v1 and lone (((S0 -> v1).v1) + (v0.S0)))
  v1' = ((v0.S0) + (v0.p1_0))
}
action a2(p2_0: S0) {
  v0' = ((v0 + (S0 -> S0)) & v0)
}
invariant Inv { (some v1 and ((all q3: S0 | 0 = (#S0 + #S0)) and some S0)) }
reachable Goal { (((some q4: S0 | q4.w0 > q4.w0) implies (some q5: S0 | (v0.(S0 & v1)) not in ((q5.v0) + (v0.v1)))) and ((some q6: S0 | #(S0 - q6) <= 2) and some S0)) }
scope S0 = 1, Int = 0..2, steps = 6
