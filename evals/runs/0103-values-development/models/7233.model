model G7233
sig S0
sig S1
rel r0: S0 -> lone S0
rel r1: S1 -> one S0
var v2: S0 -> some S1
var v3: S1 -> one S1
fact { some (r0.S0) }
init { v3 in v3 }
action a0(p0_0: S0, p0_1: S0) {
  (some q1: S0 | v2 = ((S0 -> S1) + v2))
  v3' = v3
}
action a1(p1_0: S1) {
  (all q2: S0 | no (((S0 -> q2) - (q2 -> S0)).(q2 - S0)))
  v3' = ((S1 -> S1).(S1 -> p1_0))
}
invariant Inv { (((no (S0 - S0) or (v3.r1) in r1) implies #(none & S0) > 3) implies not (not (no (S0 - S0)))) }
reachable Goal { ((((((S0 -> S0).S0).r0) in ((S0.r0) - S0) or (S0 -> S0) in (r0 & r0)) and not (some (S1 & S1))) and not (not ((v3.r1) in (S1 -> S0)))) }
scope S0 = 2, S1 = 3, steps = 6
