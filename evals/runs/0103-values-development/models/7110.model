model G7110
sig S0
enum E = Ea | Eb
var v0: S0 -> one S0
var w0: S0 -> one Int
var w1: S0 -> one Bool
init { (#(S0.v0) <= 3 implies ((Eb -> S0) & (Ea -> S0)) in (E -> S0)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
action set0(x: S0, k: Int) {
  x.w0 >= k
  w0' = w0 - x -> x.w0 + x -> (2)
}
action set1(x: S0) {
  w1' = w1 - x -> x.w1 + x -> (false)
}
action a0(p0_0: S0) {
  p0_0.w1
  p0_0.w1
  v0' = v0
}
action a1(p1_0: S0, p1_1: S0) {
  1 < (p1_1.w0 + p1_0.w0)
  v0' = ((v0.p1_0) -> p1_0)
}
invariant Inv { (((all q6: S0 | v0 in (S0 -> S0)) implies ((Eb -> E).((E -> E).Eb)) not in ((S0.(S0 -> E)).(E -> E))) implies (all q7: S0 | (#q7 + q7.w0) != 1)) }
reachable Goal { (not (not ((v0 - v0) = v0)) implies #(none + none) != 3) }
scope S0 = 3, Int = -1..2, steps = 6
