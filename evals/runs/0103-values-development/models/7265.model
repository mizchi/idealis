model G7265
sig S0
sig S1
rel r0: S0 -> set S0
rel r1: S0 -> some S1
var v2: S0 -> one S1
var w0: S0 -> one Int
init { ((v2.S1) & (S1.(S1 -> S0))) != S0 }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((x.w0 - k))
}
action a0(p0_0: S0, p0_1: S1) {
  0 != p0_0.w0
  v2' = (S0 -> p0_1)
}
invariant Inv { (lone ((v2.(S1 -> S1)).((S1 -> S1).S1)) implies (S1.(S1 -> S1)) != (((S0 -> S1).S1).v2)) }
reachable Goal { some v2 }
scope S0 = 3, S1 = 2, Int = -1..2, steps = 6
