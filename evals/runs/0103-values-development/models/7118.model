model G7118
sig S0
rel r0: S0 -> lone S0
var v1: S0 -> set S0
var v2: S0 -> set S0
record R { n: Int, b: Bool }
var w0: S0 -> one R
fact { ((all q1: S0 | some S0) or not (no S0)) }
init { some ((S0.(S0 -> S0)).(v2 + r0)) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (R { n: (1 + 2), b: false })
}
action a0(p0_0: S0, p0_1: S0) {
  not (#p0_1 = 1)
  (all q3: S0 | #(r0.p0_0) < 3)
  v1' = v1
}
invariant Inv { ((S0 -> S0).(S0 -> S0)) in v2 }
reachable Goal { ((((S0 -> S0) + (S0 -> S0)).(S0.v2)) in S0 implies ((all q10: S0 | (S0 -> q10) in v2) or not ((all q11: S0 | q11.w0.b)))) }
scope S0 = 2, Int = 0..2, steps = 6
