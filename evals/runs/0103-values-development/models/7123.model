model G7123
sig S0
var v0: S0 -> set S0
var v1: S0 -> set S0
init { (S0 -> S0) = (v1.v1) }
action a0(p0_0: S0) {
  some (S0.v1)
  v0' = ((v0.v0) - ((p0_0 -> p0_0).v1))
}
action a1(p1_0: S0) {
  v0' = v1
}
invariant Inv { ((some q1: S0 | not (#S0 <= 0)) or ((some q2: S0 | some (v0.S0)) or (v0 = (v1 - v0) or some S0))) }
reachable Goal { (all q3: S0 | ((v1.(q3.(q3 -> q3))) != (v0.(S0 & S0)) or #((q3 -> q3).S0) <= 1)) }
scope S0 = 3, steps = 6
