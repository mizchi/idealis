model G7070
sig S0
sig S1
enum E = Ea | Eb
type P = S0 + S1
rel r0: P -> some S1
rel r1: S1 -> set S1
var v2: P -> one P
record R { n: Int, b: Bool }
var w0: S0 -> one R
fact { (all q1: P | ((P -> Eb).(E -> S1)) in r0) }
init { (#S0 < 1 and no ((P.v2) & (S1.(S1 -> P)))) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  x.w0.b
  w0' = w0 - x -> x.w0 + x -> (R { n: (2 - x.w0.n), b: true })
}
action a0() {
  ((all q3: S0 | (0 * 0) = 2) or some ((Ea -> S0).S0))
  (some ((P -> S0).S0) implies (S1 -> P) in (S1 -> P))
  v2' = (P -> P)
}
action a1() {
  #S1 < 3
  some ((S1 -> S0).S0)
  v2' = ((r0.(S1 -> P)) + (v2 - v2))
}
invariant Inv { not (some (v2.P)) }
reachable Goal { some v2 }
scope S0 = 2, S1 = 1, Int = 0..2, steps = 6
