model G7145
sig S0
rel r0: some S0
rel r1: S0 -> lone S0
var v2: set S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one Bool
var w2: S0 -> one R
fact { (((S0 -> S0).r0) in (r0.((S0 -> S0).r1)) or ((S0 -> S0) in ((S0 -> S0).r1) or one r0)) }
init { r1 = (v2 -> S0) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
init { all x: S0 | x.w2 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (#x)
}
action set1(x: S0) {
  x.w1
  w1' = w1 - x -> x.w1 + x -> (true)
}
action set2(x: S0, k: Int) {
  (#v2 - x.w2.n) < (0 - x.w0)
  w2' = w2 - x -> x.w2 + x -> (R { n: x.w2.n, b: true })
}
action a0() {
  (some q2: S0 | v2 in S0)
  v2' = none
}
action a1() {
  v2' = v2
}
invariant Inv { some (((v2 -> S0).r0).(r1 & (v2 -> r0))) }
reachable Goal { (#S0 <= 2 implies ((some v2 and some (r1.(v2.(v2 -> r0)))) implies (some q4: S0 | q4.w2.b))) }
scope S0 = 2, Int = 0..2, steps = 6
