model G7054
sig S0
var v0: some S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one R
init { (all q1: S0 | 2 != #v0) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((k + x.w1.n))
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: x.w1.n, b: false })
}
action a0(p0_0: S0, p0_1: S0) {
  not (lone ((p0_1 + p0_1).(S0 -> p0_0)))
  p0_0.w1.b
  v0' = (((v0 -> S0).p0_0) + S0)
}
action a1(p1_0: S0) {
  (#v0 <= 2 or lone ((S0 -> p1_0).(p1_0.(p1_0 -> v0))))
  (#((S0 -> p1_0).v0) <= 3 implies some v0)
  v0' = S0
}
action a2(p2_0: S0, p2_1: S0) {
  v0' = v0
}
invariant Inv { some ((v0 -> S0).v0) }
reachable Goal { (some q3: S0 | (#v0 * q3.w1.n) <= #q3) }
scope S0 = 3, Int = 0..2, steps = 6
