model G7156
sig S0
sig S1
rel r0: S1 -> lone S0
var v1: some S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one Bool
var w2: S0 -> one R
fact { (all q1: S0 | (lone q1 implies (S0 -> S1) in ((q1 -> S0).(q1 -> S1)))) }
init { (all q2: S1 | some ((v1 -> v1).S0)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
init { all x: S0 | x.w2 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (x.w2.n)
}
action set1(x: S0) {
  x.w2.b
  w1' = w1 - x -> x.w1 + x -> (false)
}
action set2(x: S0, k: Int) {
  w2' = w2 - x -> x.w2 + x -> (R { n: (k - 1), b: false })
}
action a0() {
  S1 != (r0.(S1.r0))
  some ((S1 -> v1).(v1 & S0))
  v1' = ((v1 -> S1).(S0.(v1 -> S1)))
}
action a1(p1_0: S1, p1_1: S0) {
  ((S1 -> p1_0) = (S1 -> S1) or p1_1.w1)
  p1_1.w1
  v1' = v1
}
action a2(p2_0: S0) {
  (all q3: S0 | #((S1 -> S1).S1) < 2)
  v1' = p2_0
}
invariant Inv { (all q4: S0 | (#v1 * q4.w2.n) = (q4.w0 * q4.w0)) }
reachable Goal { not ((((((v1 -> S0) & (S0 -> S0)).S0) not in (((S0 -> S1).S1) + ((S0 -> v1).v1)) implies ((S1 + S1).r0) = (((v1 -> S1) & (v1 -> S1)).S1)) or (all q6: S0 | q6.w1))) }
scope S0 = 2, S1 = 1, Int = 0..2, steps = 6
