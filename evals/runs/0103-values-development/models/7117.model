model G7117
sig S0
enum E = Ea | Eb
type P = S0 + E
var v0: S0 -> lone E
var v1: one P
record R { n: Int, b: Bool }
var w0: S0 -> one R
init { (#(S0.v0) != 2 implies (some q5: S0 | q5.w0.b)) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (R { n: (k + #P), b: true })
}
action a0() {
  some v1
  v0' = ((v0.(E -> Eb)) & v0)
}
invariant Inv { (some q18: E | (all q19: E | (#((E -> P).P) > 2 and ((v0.(q18 -> q19)).q19) = (S0 + S0)))) }
reachable Goal { #v1 != 1 }
scope S0 = 2, Int = 0..2, steps = 6
