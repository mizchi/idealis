model G7132
sig S0
rel r0: S0 -> one S0
var v1: S0 -> lone S0
var w0: S0 -> one Int
var w1: S0 -> one Bool
fact { r0 in (S0 -> S0) }
init { (r0 + r0) = v1 }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
action set0(x: S0, k: Int) {
  not x.w1
  w0' = w0 - x -> x.w0 + x -> (#S0)
}
action set1(x: S0) {
  w1' = w1 - x -> x.w1 + x -> (false)
}
action a0() {
  v1' = (S0 -> S0)
}
action a1() {
  v1' = (v1 & v1)
}
invariant Inv { ((all q8: S0 | q8.w1) implies not ((some (S0.v1) or lone ((S0 - S0) - S0)))) }
reachable Goal { (v1 in (S0 -> S0) implies (some q9: S0 | q9.w1)) }
scope S0 = 2, Int = -1..2, steps = 6
