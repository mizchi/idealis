model G7161
sig S0
sig S1
enum E = Ea | Eb
rel r0: E -> lone S1
rel r1: lone E
var v2: E -> one S0
var v3: lone E
var w0: S0 -> one Bool
fact { (((Eb -> Eb) = (Eb -> r1) or one (S0 & S0)) implies (none = ((E -> E).E) or S0 != ((S0 -> S0).(S0 + S0)))) }
init { (((S1 -> E).v2) = ((S1 -> S1).(S1 -> S0)) and ((S0 -> S0) - (S0 -> S0)) in ((S0 -> S0) + (S0 -> S0))) }
init { all x: S0 | x.w0 = false }
action set0(x: S0) {
  not x.w0
  w0' = w0 - x -> x.w0 + x -> (false)
}
action a0(p0_0: S0) {
  (((p0_0 -> S1).(S1 -> p0_0)) in (S0 -> p0_0) and some Eb)
  (all q3: S0 | not p0_0.w0)
  v2' = v2
}
action a1() {
  v3' = ((Eb.(E -> r1)) & v3)
}
invariant Inv { (not ((all q5: S0 | not q5.w0)) or (some q6: S0 | no v3)) }
reachable Goal { ((some q9: S0 | q9.w0) or not ((none = ((S1 -> S1).(Ea.(v3 -> S1))) and some Ea))) }
scope S0 = 3, S1 = 2, steps = 6
