model G7069
sig S0
sig S1
rel r0: some S1
rel r1: one S1
var v2: S0 -> lone S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one R
init { (some q14: S1 | ((S0 -> S0) & v2) = v2) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  x.w1.b
  w0' = w0 - x -> x.w0 + x -> (x.w1.n)
}
action set1(x: S0, k: Int) {
  0 >= x.w1.n
  w1' = w1 - x -> x.w1 + x -> (R { n: k, b: false })
}
action a0(p0_0: S0) {
  (((S0 -> S1).(r0 -> r1)).((r1 -> p0_0).S0)) = (p0_0 - ((S0 -> r0).S1))
  (some q15: S1 | p0_0.w1.b)
  v2' = v2
}
action a1(p1_0: S1, p1_1: S0) {
  not (p1_1.w1.b)
  v2' = ((S0 -> S0) - (p1_1 -> S0))
}
action a2() {
  #r0 != 1
  v2' = v2
}
invariant Inv { ((((((S0 -> S1).S1).(S0 -> S0)) != ((r1 & r0).((S1 -> S0).v2)) and (r0.((S1 -> r0) & (S1 -> r1))) = none) or (((r0.(r1 -> r1)).(S1 -> r1)) in r0 implies #(r1.(r1 -> r0)) != 3)) and ((all q25: S1 | lone ((v2.S0).((S0 -> S0).v2))) implies (all q26: S0 | (q26.w0 * 1) != (1 - q26.w1.n)))) }
reachable Goal { (((all q33: S0 | q33.w0 >= 2) or S1 != (S0.(v2.(S0 -> S1)))) and lone ((r0.(r1 -> S0)).(S0 -> r1))) }
scope S0 = 2, S1 = 2, Int = 0..2, steps = 6
