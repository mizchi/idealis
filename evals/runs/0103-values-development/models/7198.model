model G7198
sig S0
sig S1
rel r0: one S1
rel r1: S0 -> set S1
var v2: S1 -> some S1
var v3: set S0
var w0: S0 -> one Bool
fact { (S0 -> S1) in ((S0 -> S0).r1) }
init { some v3 }
init { all x: S0 | x.w0 = false }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (false)
}
action a0(p0_0: S0) {
  v3' = ((r1 & r1).(S1.(r0 -> r0)))
}
action a1(p1_0: S1) {
  v3' = v3
}
action a2(p2_0: S0, p2_1: S0) {
  not p2_0.w0
  (p2_0.w0 and some v3)
  v3' = ((r1.S1) + (S0 & S0))
}
invariant Inv { (some ((r0.(S1 -> v3)).(S0 -> S1)) and not ((all q2: S0 | not q2.w0))) }
reachable Goal { #(r0.(S1 -> v3)) >= 3 }
scope S0 = 3, S1 = 2, steps = 6
