model G7083
sig S0
sig S1
enum E = Ea | Eb
rel r0: E -> lone S0
rel r1: lone S1
var v2: some E
var v3: E -> set S0
record R { n: Int, b: Bool }
var w0: S0 -> one Bool
var w1: S0 -> one R
fact { #S1 < 3 }
init { ((E -> S0) in v3 implies lone ((S0.(S0 -> S1)).((S1 -> E).(Eb -> r1)))) }
init { all x: S0 | x.w0 = true }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0) {
  x.w0
  w0' = w0 - x -> x.w0 + x -> (true)
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: #Ea, b: true })
}
action a0(p0_0: S0) {
  v3' = (((v2 -> S0).p0_0) -> S0)
}
invariant Inv { some (v2.(E -> S1)) }
reachable Goal { (some q12: S0 | ((((r1 -> Ea) + (S1 -> v2)) in (r1 -> E) implies q12.w0) implies not q12.w0)) }
scope S0 = 3, S1 = 2, Int = 0..2, steps = 6
