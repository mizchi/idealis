model G7294
sig S0
sig S1
rel r0: set S1
rel r1: S1 -> set S0
var v2: S1 -> set S1
var v3: S1 -> some S0
fact { (all q1: S1 | lone ((S0 -> S0).((S0 -> S0).S0))) }
init { (((S0 -> r0).v3) in ((S0 -> S0) - (S0 -> S0)) or some r0) }
action a0(p0_0: S0, p0_1: S0) {
  v3' = v3
}
invariant Inv { ((not (((S0.(S0 -> S0)).(S0 -> S0)) != ((S0 -> S0).S0)) or (#(S0 - S0) > 3 or #(v2.S1) != 1)) or ((v3.S0) - r0) != (S0.(S0 -> r0))) }
reachable Goal { v2 = v2 }
scope S0 = 3, S1 = 2, steps = 6
