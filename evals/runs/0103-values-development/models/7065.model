model G7065
sig S0
sig S1
var v0: S1 -> some S1
var v1: S0 -> some S1
record R { n: Int, b: Bool }
var w0: S0 -> one R
init { ((v0 & (S1 -> S1)) = ((S1 -> S0).v1) implies (all q2: S0 | (1 * q2.w0.n) >= q2.w0.n)) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  x.w0.b
  w0' = w0 - x -> x.w0 + x -> (R { n: (k * k), b: false })
}
action a0(p0_0: S1, p0_1: S0) {
  some S1
  v1' = (((p0_1 -> S0).S0) -> (p0_0 & p0_0))
}
action a1(p1_0: S0) {
  v0' = (v0.(S1 -> S1))
}
action a2(p2_0: S0, p2_1: S0) {
  v0' = (S1 -> (S1.v0))
}
invariant Inv { (((some (v1.S1) or #S1 >= 3) and not (some (v1.S1))) and not (not (some (v0.S1)))) }
reachable Goal { ((some q10: S0 | q10.w0.b) or (v1 + (S0 -> S1)) in (S0 -> S1)) }
scope S0 = 2, S1 = 3, Int = 0..2, steps = 6
