model G7016
sig S0
sig S1
rel r0: S1 -> set S1
rel r1: S1 -> one S1
var v2: some S0
var v3: S0 -> set S0
var w0: S0 -> one Int
var w1: S0 -> one Bool
init { not ((S0 -> v2) in ((S0 -> S1).(S1 -> v2))) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
action set0(x: S0, k: Int) {
  0 > k
  w0' = w0 - x -> x.w0 + x -> (2)
}
action set1(x: S0) {
  w1' = w1 - x -> x.w1 + x -> (true)
}
action a0() {
  #S1 >= 0
  v3' = ((S0 - S0) -> ((v2 -> S1).S1))
}
action a1(p1_0: S1) {
  v3' = ((v2 -> S0) - v3)
}
action a2(p2_0: S0) {
  p2_0.w1
  not p2_0.w1
  v2' = v2
}
invariant Inv { some (((S1 -> v2).v3).(S0 & S0)) }
reachable Goal { not (((all q5: S0 | q5.w0 > q5.w0) implies ((some q6: S0 | q6.w0 != (0 * q6.w0)) implies (S1 -> v2) = (S1 -> S0)))) }
scope S0 = 3, S1 = 3, Int = -1..2, steps = 6
