model G7099
sig S0
sig S1
var v0: S1 -> one S1
var w0: S0 -> one Int
init { (some q3: S1 | (S1.((S1 -> S1) + v0)) = ((v0.S1).v0)) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  (x.w0 - #S1) = 2
  w0' = w0 - x -> x.w0 + x -> (k)
}
action a0(p0_0: S1, p0_1: S1) {
  ((all q4: S0 | (0 - q4.w0) = q4.w0) and (S0 -> S1) = (S0 -> S1))
  v0' = (S1 -> S1)
}
invariant Inv { ((all q11: S1 | #(S1.v0) <= 1) implies #((S0 -> S0).S0) != 2) }
reachable Goal { ((not (#(v0.S1) >= 0) or (all q23: S0 | (q23.w0 + #q23) = (q23.w0 - q23.w0))) and some (S1 & S1)) }
scope S0 = 3, S1 = 3, Int = -1..2, steps = 6
