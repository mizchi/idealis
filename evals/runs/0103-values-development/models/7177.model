model G7177
sig S0
sig S1
var v0: S0 -> some S1
var v1: some S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one R
init { (((v0.S1).(S0 -> S1)) not in (((S1 -> S0).v1) - S1) and v0 in ((S0 -> v1).v0)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (#x)
}
action set1(x: S0, k: Int) {
  w1' = w1 - x -> x.w1 + x -> (R { n: (x.w1.n * 0), b: false })
}
action a0() {
  v0' = v0
}
action a1() {
  (some q2: S1 | (((q2 -> q2).S1).((q2 -> q2) - (S1 -> S1))) in ((q2 -> S1).q2))
  v0' = (v1 -> S1)
}
action a2(p2_0: S1) {
  (S1 -> S1) = ((S1 -> p2_0).(p2_0 -> S1))
  v0' = v0
}
invariant Inv { #(v0.S1) < 1 }
reachable Goal { ((some q6: S1 | (some (S0.(v1 -> v1)) and (S0 -> v1) = (S0 -> S0))) and ((no (S1 + (S1 - S1)) and #(S0.(v1 -> S0)) >= 2) implies (v1 = (((v1 -> S1) - v0).S1) and (all q7: S0 | q7.w1.n >= (#S1 + q7.w0))))) }
scope S0 = 3, S1 = 1, Int = 0..2, steps = 6
