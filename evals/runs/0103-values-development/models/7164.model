model G7164
sig S0
sig S1
enum E = Ea | Eb
rel r0: S0 -> set S1
rel r1: S1 -> lone S1
var v2: E -> one S0
var v3: set S0
init { ((v3 & (S1.(S1 -> v3))) = (((S0 -> v3).r0).S1) and v3 = (((v3 -> S0).S0) + ((v3 -> v3).S0))) }
action a0(p0_0: E) {
  v3' = (((S0 -> p0_0).Ea) & (Ea.v2))
}
action a1(p1_0: S0) {
  (some (p1_0 - v3) and (Eb -> S1) in (Ea -> S1))
  (Eb -> E) in (Eb -> Eb)
  v2' = ((Eb.(Eb -> E)) -> (none - v3))
}
action a2(p2_0: S1, p2_1: S0) {
  (#(E & Eb) <= 2 and (p2_0 -> Ea) = (p2_0 -> E))
  ((E -> S1) in ((Eb -> S1).(p2_0 -> S1)) implies (p2_0 -> v3) = ((p2_0 -> Eb).v2))
  v3' = (((S0 -> S1) & r0).S1)
}
invariant Inv { (all q1: S0 | (some E or (one (v3 - (S1.(S1 -> q1))) and no S1))) }
reachable Goal { (some q2: S1 | ((some q3: E | ((q2 -> v3) & (q2 -> S0)) = ((q2 -> v3).(v3 -> S0))) implies not (#(v3.r0) <= 3))) }
scope S0 = 3, S1 = 2, steps = 6
