model G7126
sig S0
var v0: S0 -> some S0
var v1: S0 -> one S0
var w0: S0 -> one Int
init { (#(v0.S0) = 3 or ((S0 -> S0) - v1) in v1) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  (k - 1) < 1
  w0' = w0 - x -> x.w0 + x -> ((k * #x))
}
action a0(p0_0: S0) {
  1 != p0_0.w0
  some ((none + p0_0).(v1.v1))
  v0' = (p0_0 -> p0_0)
}
action a1() {
  (some q1: S0 | (2 + 0) <= q1.w0)
  v1' = ((S0 -> S0) - (S0 -> S0))
}
action a2(p2_0: S0, p2_1: S0) {
  (2 * p2_0.w0) < p2_0.w0
  p2_1.w0 = (#p2_0 - p2_0.w0)
  v1' = ((p2_1 -> p2_0) & v0)
}
invariant Inv { not (not (not (some (S0.v0)))) }
reachable Goal { ((#(v1.S0) >= 0 or some (S0.v0)) or (some q3: S0 | (some (S0.(S0 -> S0)) or (#q3 + 1) != q3.w0))) }
scope S0 = 3, Int = -1..2, steps = 6
