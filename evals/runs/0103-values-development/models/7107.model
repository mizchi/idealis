model G7107
sig S0
rel r0: S0 -> set S0
rel r1: one S0
var v2: S0 -> set S0
var v3: set S0
var w0: S0 -> one Int
init { not ((r1 -> v3) = r0) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  2 >= k
  w0' = w0 - x -> x.w0 + x -> (1)
}
action a0(p0_0: S0, p0_1: S0) {
  (no ((S0 -> r1).(r1.(r1 -> S0))) implies (p0_1.w0 + p0_0.w0) <= #p0_0)
  v3' = ((v3.(S0 -> S0)).(p0_1 -> v3))
}
invariant Inv { lone ((r0.S0).(r0 & (v3 -> v3))) }
reachable Goal { ((lone S0 and #((S0 -> r1).S0) >= 3) implies some (r0.v3)) }
scope S0 = 3, Int = -1..2, steps = 6
