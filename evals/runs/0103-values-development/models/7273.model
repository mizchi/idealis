model G7273
sig S0
enum E = Ea | Eb
rel r0: S0 -> one S0
var v1: E -> some S0
var v2: E -> lone E
var w0: S0 -> one Int
var w1: S0 -> one Bool
fact { (some q1: E | (all q2: S0 | (Eb -> S0) in (Ea -> S0))) }
init { (one ((S0 - S0) + ((S0 -> Eb).Eb)) and ((v2 + v2).(S0.(S0 -> Ea))) not in (v1.((S0 -> E).E))) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
action set0(x: S0, k: Int) {
  #S0 = x.w0
  w0' = w0 - x -> x.w0 + x -> ((k * k))
}
action set1(x: S0) {
  not x.w1
  w1' = w1 - x -> x.w1 + x -> (true)
}
action a0() {
  ((all q3: S0 | q3.w1) or (all q4: S0 | q4.w1))
  (all q5: S0 | 0 < 2)
  v1' = ((v2 - (Eb -> E)).(Ea -> S0))
}
invariant Inv { (S0 not in S0 or ((Ea -> S0) = (v2.(E -> S0)) implies (all q9: S0 | 2 <= (0 + #S0)))) }
reachable Goal { ((all q16: S0 | q16.w0 <= 0) or (#S0 >= 3 implies ((S0 -> S0) = r0 and ((r0.(S0 -> Eb)).(Ea + Eb)) = ((S0 -> S0).(E.v1))))) }
scope S0 = 2, Int = -1..2, steps = 6
