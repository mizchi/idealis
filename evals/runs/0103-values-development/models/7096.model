invariant Inv { ((some q4: S0 | q4.w0) or (((v2.(Eb & E)) in Eb implies (some q5: S0 | not q5.w0)) and (some q6: E | (some q7: S0 | not q7.w0)))) }
reachable Goal { ((not (((S0 -> E).v1) = (S0 -> S0)) or (S0 -> S0) in (S0 -> S0)) implies (all q12: S0 | not q12.w0)) }
scope S0 = 3, steps = 6
