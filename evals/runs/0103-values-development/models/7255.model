model G7255
sig S0
enum E = Ea | Eb
var v0: one S0
var v1: S0 -> one E
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one R
init { (all q3: E | (((q3 -> v0).(S0 -> S0)).S0) not in Eb) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  x.w1.n < x.w1.n
  w0' = w0 - x -> x.w0 + x -> ((k * x.w1.n))
}
action set1(x: S0, k: Int) {
  (x.w0 + k) > 2
  w1' = w1 - x -> x.w1 + x -> (R { n: 2, b: true })
}
action a0() {
  v1' = ((Ea.(E -> S0)) -> (E.(Ea -> E)))
}
invariant Inv { (#((Ea -> Eb).Ea) = 3 implies (lone v0 implies (some q4: E | #q4 != 3))) }
reachable Goal { (some q5: S0 | ((q5.w0 - 1) >= (q5.w0 - q5.w1.n) implies (#v0 != 2 implies #(S0.(S0 -> E)) >= 0))) }
scope S0 = 3, Int = 0..2, steps = 6
