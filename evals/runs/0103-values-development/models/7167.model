model G7167
sig S0
enum E = Ea | Eb
type P = S0 + E
rel r0: set P
var v1: E -> some P
var w0: S0 -> one Int
init { (S0 not in S0 and some (E.v1)) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (#P)
}
action a0(p0_0: S0, p0_1: S0) {
  some (((P -> P).(P -> P)).P)
  v1' = (E -> P)
}
action a1(p1_0: E) {
  v1' = ((S0.(S0 -> p1_0)) -> P)
}
invariant Inv { ((S0 -> Ea).v1) = (S0 -> P) }
reachable Goal { (some P or some ((v1.(P -> P)).P)) }
scope S0 = 2, Int = -1..2, steps = 6
