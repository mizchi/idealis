model G7175
sig S0
sig S1
var v0: set S0
var v1: lone S0
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one Bool
var w2: S0 -> one R
init { (some ((v1 -> v1).S0) implies some (S1 & S1)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = false }
init { all x: S0 | x.w2 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  not x.w1
  w0' = w0 - x -> x.w0 + x -> (k)
}
action set1(x: S0) {
  w1' = w1 - x -> x.w1 + x -> (true)
}
action set2(x: S0, k: Int) {
  w2' = w2 - x -> x.w2 + x -> (R { n: (#x * x.w0), b: true })
}
action a0(p0_0: S0, p0_1: S1) {
  (#(none - v0) <= 3 and not p0_0.w1)
  not (#((v0 -> S1).S1) < 2)
  v0' = (S0 - ((v1 -> S1).S1))
}
action a1(p1_0: S1, p1_1: S0) {
  (all q3: S1 | some ((q3 -> q3).S1))
  1 = (p1_1.w2.n + p1_1.w2.n)
  v0' = v0
}
invariant Inv { (not ((all q5: S0 | ((S1 - S1) & S1) = ((S1 -> q5).q5))) or (((v0 -> v0).v0) = ((v0 -> S1).(S1.(S1 -> S1))) or (all q6: S0 | q6.w2.b))) }
reachable Goal { (some q7: S0 | (q7.w2.n + q7.w0) = #v0) }
scope S0 = 3, S1 = 3, Int = 0..2, steps = 6
