model G7003
sig S0
sig S1
rel r0: S1 -> set S0
rel r1: S1 -> lone S1
var v2: set S0
var v3: S1 -> lone S0
fact { S1 not in (r0.S0) }
init { ((S1 + S1).((S1 -> S1) & r1)) not in (S0.((v2 -> S1) + (S0 -> S1))) }
action a0(p0_0: S0) {
  v3' = (S1 -> p0_0)
}
action a1() {
  (#v2 < 0 and some ((v2 -> S1).S1))
  (all q1: S1 | no (v3.v2))
  v2' = ((S1.v3).(S0 -> S0))
}
invariant Inv { ((#((v2 -> S0).v2) >= 3 or some S1) and (no S1 and (some q2: S1 | #v2 = 0))) }
reachable Goal { (some q3: S0 | ((no S1 and some q3) implies (((q3.(q3 -> v2)) & (S0.(v2 -> q3))) != ((S1.r0) & ((S0 -> S0).S0)) implies (S1 & (S1 & S1)) not in ((r0.(q3 -> S0)).((S0 -> S1).S1))))) }
scope S0 = 3, S1 = 2, steps = 6
