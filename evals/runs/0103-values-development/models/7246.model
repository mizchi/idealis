model G7246
sig S0
var v0: set S0
var v1: S0 -> set S0
var w0: S0 -> one Int
init { some ((v0.(v0 -> S0)) & (S0 & S0)) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  k > k
  w0' = w0 - x -> x.w0 + x -> (#S0)
}
action a0() {
  (all q1: S0 | #v0 > 1)
  (all q2: S0 | #v0 != 1)
  v1' = ((S0.v1) -> (none + v0))
}
action a1(p1_0: S0, p1_1: S0) {
  v1' = v1
}
action a2(p2_0: S0) {
  not (some p2_0)
  lone ((S0.v1) & (p2_0.v1))
  v1' = v1
}
invariant Inv { (((all q4: S0 | (2 * q4.w0) > (0 + q4.w0)) or (v0 != S0 and (some q5: S0 | (#q5 - q5.w0) > 2))) implies (all q6: S0 | (q6.w0 - #v0) < #S0)) }
reachable Goal { one ((v1 - v1).v0) }
scope S0 = 3, Int = -1..2, steps = 6
