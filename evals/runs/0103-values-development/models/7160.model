model G7160
sig S0
sig S1
enum E = Ea | Eb
rel r0: S1 -> set S1
var v1: some S1
var w0: S0 -> one Int
var w1: S0 -> one Bool
fact { (not (some S1) and (some q1: S0 | (q1 -> Ea) in (q1 -> Eb))) }
init { not (some ((v1 -> S0).S0)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = false }
action set0(x: S0, k: Int) {
  x.w1
  w0' = w0 - x -> x.w0 + x -> (#v1)
}
action set1(x: S0) {
  not x.w1
  w1' = w1 - x -> x.w1 + x -> (false)
}
action a0(p0_0: S1) {
  not (some (Eb.(Ea -> S0)))
  (some q4: S0 | not q4.w1)
  v1' = ((p0_0 - p0_0) - (p0_0.r0))
}
action a1(p1_0: S1) {
  some ((Eb -> S0).S0)
  v1' = ((v1 + v1).r0)
}
invariant Inv { (((some (S0.(S0 -> S1)) or (r0.r0) in ((v1 -> Eb).(E -> v1))) implies (some (S0 - ((S0 -> S0).S0)) or no ((S1 - v1).((S1 -> Eb) + (v1 -> Ea))))) implies ((S0 -> E).(Ea -> E)) in (S0 -> E)) }
reachable Goal { (some ((v1 -> Ea).E) or (all q17: E | S0 not in S0)) }
scope S0 = 3, S1 = 2, Int = -1..2, steps = 6
