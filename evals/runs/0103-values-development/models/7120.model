model G7120
sig S0
sig S1
type P = S0 + S1
rel r0: set P
var v1: one S0
var v2: S0 -> set P
var w0: S0 -> one Int
fact { (all q1: S1 | (((S0 -> S0).(S0 -> S0)) = (S0 -> S0) or lone S1)) }
init { (some v1 or some ((P -> S0).v1)) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (k)
}
action a0(p0_0: P) {
  ((P -> P).P) = P
  no (P.(P -> S1))
  v1' = ((v1.(v1 -> v1)) - ((S0 -> v1).S0))
}
action a1(p1_0: S1) {
  v1' = S0
}
invariant Inv { (P -> v1) = ((P -> P).(P -> S0)) }
reachable Goal { (((all q13: P | #(S1.(S1 -> S1)) < 3) implies (some q14: S0 | (q14.w0 + #v1) <= q14.w0)) or (all q15: S0 | (1 * q15.w0) <= q15.w0)) }
scope S0 = 3, S1 = 1, Int = -1..2, steps = 6
