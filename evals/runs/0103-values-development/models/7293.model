model G7293
sig S0
sig S1
rel r0: S1 -> one S0
rel r1: S0 -> set S0
var v2: S0 -> set S0
init { (((S0.(S0 -> S1)).(S1 -> S1)) != ((S1 -> S0).(S0 + S0)) or some (S0.v2)) }
action a0(p0_0: S1, p0_1: S1) {
  (((S1 -> S1).p0_0) + (S0.(S0 -> S1))) = p0_0
  (all q3: S1 | #p0_0 != 2)
  v2' = (r1 + (S0 -> S0))
}
action a1(p1_0: S1) {
  (some (S1 & none) implies some S0)
  v2' = ((S0 -> S1).r0)
}
invariant Inv { ((S0 -> S0) in (v2 + r1) or not ((#(S1.r0) = 0 or S0 in (v2.S0)))) }
reachable Goal { (r0.v2) in (S1 -> S0) }
scope S0 = 3, S1 = 1, steps = 6
