model G7137
sig S0
rel r0: S0 -> one S0
var v1: S0 -> lone S0
var w0: S0 -> one Bool
fact { not (not (S0 != S0)) }
init { (((S0 -> S0).(S0 + S0)) in S0 or ((S0 -> S0).((S0 -> S0).S0)) != (((S0 -> S0).v1).(v1.S0))) }
init { all x: S0 | x.w0 = false }
action set0(x: S0) {
  not x.w0
  w0' = w0 - x -> x.w0 + x -> (true)
}
action a0(p0_0: S0, p0_1: S0) {
  v1' = (r0 - (r0 + (S0 -> p0_0)))
}
action a1() {
  some none
  v1' = (r0.r0)
}
action a2(p2_0: S0) {
  r0 = r0
  p2_0.w0
  v1' = ((S0 -> p2_0) & (v1.v1))
}
invariant Inv { ((some q8: S0 | q8.w0) and ((no (v1.(S0 + S0)) and (all q9: S0 | q9.w0)) implies some (S0 + none))) }
reachable Goal { r0 in v1 }
scope S0 = 3, steps = 6
