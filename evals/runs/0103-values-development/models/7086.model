model G7086
sig S0
var v0: one S0
var v1: S0 -> one S0
var w0: S0 -> one Int
var w1: S0 -> one Bool
init { some (v1.S0) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = true }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((k - 0))
}
action set1(x: S0) {
  #x < (x.w0 * x.w0)
  w1' = w1 - x -> x.w1 + x -> (false)
}
action a0(p0_0: S0, p0_1: S0) {
  v1' = (p0_1 -> S0)
}
action a1(p1_0: S0, p1_1: S0) {
  #S0 != p1_0.w0
  not (one S0)
  v0' = (p1_0 - p1_0)
}
action a2() {
  (S0 & ((S0 -> S0).S0)) = (S0 & (v1.v0))
  v0 not in (v0 - (v1.S0))
  v0' = (S0 + v0)
}
invariant Inv { ((some q3: S0 | not q3.w1) and ((some q4: S0 | v1 in (v1 - v1)) implies (some q5: S0 | 2 = 2))) }
reachable Goal { (((some q7: S0 | #(v1.S0) = 3) or not (lone ((v0.v1).(v1 & (S0 -> S0))))) and (some q8: S0 | q8.w1)) }
scope S0 = 3, Int = -1..2, steps = 6
