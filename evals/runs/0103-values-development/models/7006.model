model G7006
sig S0
sig S1
var v0: S0 -> set S0
var v1: S1 -> lone S1
var w0: S0 -> one Int
init { (#((S1 -> S0).S0) >= 2 and ((S0 -> S1).(v1.S1)) = S0) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  k <= x.w0
  w0' = w0 - x -> x.w0 + x -> ((1 + x.w0))
}
action a0(p0_0: S0, p0_1: S0) {
  lone S1
  v1' = (S1 -> (p0_0.(p0_0 -> S1)))
}
action a1(p1_0: S0) {
  v0' = (v0.((S0 -> p1_0) & v0))
}
action a2(p2_0: S1, p2_1: S1) {
  (#S0 < 3 implies (all q4: S0 | (q4.w0 - 0) >= 0))
  (all q5: S0 | ((S1.(S1 -> q5)).v0) in (S0 + (S0 - q5)))
  v1' = (S1 -> p2_0)
}
invariant Inv { (all q13: S0 | ((S0 -> S0) & v0) in v0) }
reachable Goal { (some (S1 - none) or (not ((S0 -> S1) = (S0 -> S1)) or (all q21: S0 | some (q21.v0)))) }
scope S0 = 1, S1 = 3, Int = -1..2, steps = 6
