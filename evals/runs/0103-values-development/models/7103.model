model G7103
sig S0
sig S1
rel r0: S0 -> lone S0
rel r1: some S1
var v2: S0 -> set S0
var v3: set S0
init { (all q2: S0 | (v3 -> S0) = r0) }
action a0() {
  some v3
  (some (S1.(r1 -> S1)) implies some v3)
  v2' = (((v3 -> S1).S1) -> ((S0 -> r1).S1))
}
invariant Inv { (((some q3: S1 | some (v3.r0)) or (one v3 implies ((S1 - r1) - (v3.(S0 -> S1))) in ((r1 -> v3).(S0 - v3)))) or (all q4: S1 | (q4 -> v3) = (r1 -> S0))) }
reachable Goal { ((none & (v3 - S0)) = v3 and not (#(S0 & S0) < 2)) }
scope S0 = 3, S1 = 2, steps = 6
