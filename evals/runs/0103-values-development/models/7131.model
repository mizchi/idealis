model G7131
sig S0
sig S1
enum E = Ea | Eb
var v0: E -> set S0
record R { n: Int, b: Bool }
var w0: S0 -> one R
init { not (((S0.(S0 -> Eb)) & (S1.(S1 -> Ea))) != ((v0.(S0 -> S1)).((S1 -> E).Eb))) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  (x.w0.n - x.w0.n) <= (x.w0.n * k)
  w0' = w0 - x -> x.w0 + x -> (R { n: k, b: true })
}
action a0() {
  v0' = ((Eb -> S0).(S0 -> S0))
}
action a1() {
  v0' = v0
}
invariant Inv { (((((S0 -> S0) & (S0 -> S0)) in ((S0 -> S1).(S1 -> S0)) implies #S0 <= 0) and ((S1 - (S1 & S1)) != ((S1 -> E).(v0.S0)) implies #none < 1)) or (some q3: S0 | (1 - 2) <= q3.w0.n)) }
reachable Goal { not ((v0 - v0) = ((E -> S0) + v0)) }
scope S0 = 3, S1 = 1, Int = 0..2, steps = 6
