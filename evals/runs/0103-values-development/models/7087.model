model G7087
sig S0
rel r0: S0 -> some S0
rel r1: S0 -> lone S0
var v2: S0 -> one S0
var v3: lone S0
var w0: S0 -> one Bool
fact { (((S0.((S0 -> S0).r1)) in ((S0 & S0).(S0 -> S0)) or #((S0 -> S0).S0) = 0) and some ((r0 & r0).(r0.S0))) }
init { (no S0 implies some (S0.(v3 -> S0))) }
init { all x: S0 | x.w0 = false }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (true)
}
action a0() {
  v2' = r0
}
action a1(p1_0: S0, p1_1: S0) {
  v3' = ((r0.(p1_1 -> p1_1)).p1_0)
}
invariant Inv { (some ((v3 & S0) & (S0 & v3)) implies ((S0 -> S0) in r0 implies (some (S0.r0) implies (v3 -> S0) in (r1 + r0)))) }
reachable Goal { #v3 >= 0 }
scope S0 = 3, steps = 6
