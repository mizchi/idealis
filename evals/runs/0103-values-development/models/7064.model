model G7064
sig S0
rel r0: one S0
var v1: one S0
record R { n: Int, b: Bool }
var w0: S0 -> one R
init { some ((S0 -> S0).v1) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (R { n: (2 * k), b: true })
}
action a0(p0_0: S0, p0_1: S0) {
  v1' = v1
}
invariant Inv { (all q4: S0 | ((S0 -> S0).(q4 -> S0)) = ((v1 -> S0).(v1 -> q4))) }
reachable Goal { ((v1 -> r0) in (v1 -> S0) implies (all q6: S0 | q6.w0.b)) }
scope S0 = 3, Int = 0..2, steps = 6
