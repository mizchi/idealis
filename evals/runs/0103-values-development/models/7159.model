model G7159
sig S0
sig S1
type P = S0 + S1
rel r0: S0 -> set P
rel r1: S0 -> one S1
var v2: S0 -> set S1
var w0: S0 -> one Int
init { (((S0.(S0 -> S1)) - (S1 - S1)) in (((S1 -> S0).S0) - (S0.v2)) implies (some q1: S0 | (0 + 2) = (#P * 0))) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((k + #P))
}
action a0() {
  #S1 >= 2
  (all q2: S0 | (1 + 2) != 2)
  v2' = (v2.(S1 -> S1))
}
action a1(p1_0: P, p1_1: S0) {
  v2' = r1
}
invariant Inv { (((all q31: S0 | 0 != q31.w0) or ((P.(P -> S1)) != ((S0.v2) & (P.(P -> S1))) and (S1 -> S1) = ((S1 -> S1) - (S1 -> S1)))) or (all q32: S0 | (2 - q32.w0) != q32.w0)) }
reachable Goal { some v2 }
scope S0 = 1, S1 = 2, Int = -1..2, steps = 6
