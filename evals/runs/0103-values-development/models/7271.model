model G7271
sig S0
rel r0: set S0
var v1: set S0
record R { n: Int, b: Bool }
var w0: S0 -> one R
init { ((((r0 -> v1).(S0 -> S0)).((v1 -> r0).v1)) = ((r0.(S0 -> v1)).(v1 -> S0)) or lone S0) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  x.w0.n < k
  w0' = w0 - x -> x.w0 + x -> (R { n: (x.w0.n + #v1), b: false })
}
action a0(p0_0: S0) {
  (#((p0_0 -> p0_0).v1) = 3 and p0_0.w0.b)
  ((p0_0.(r0 -> v1)) in ((r0 & p0_0).(r0 -> p0_0)) and p0_0.w0.b)
  v1' = r0
}
action a1() {
  v1' = r0
}
action a2(p2_0: S0) {
  not (1 <= (p2_0.w0.n - p2_0.w0.n))
  v1' = (p2_0.(p2_0 -> S0))
}
invariant Inv { ((not ((v1 -> S0) in (r0 -> S0)) implies ((S0 + none).((r0 -> r0) + (r0 -> S0))) not in r0) and (all q1: S0 | (0 - q1.w0.n) > (q1.w0.n * #v1))) }
reachable Goal { (#(v1.(r0 -> r0)) >= 1 implies not (not (#((v1 -> v1).v1) < 2))) }
scope S0 = 3, Int = 0..2, steps = 6
