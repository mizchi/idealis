model G7189
sig S0
sig S1
type P = S0 + S1
rel r0: one S1
rel r1: set P
var v2: S0 -> some S1
var w0: S0 -> one Bool
fact { ((some q1: S1 | #(q1 & q1) != 3) and (some (S1.(S1 -> S1)) implies (r1 + r1) != S1)) }
init { #(v2.S1) != 3 }
init { all x: S0 | x.w0 = false }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (false)
}
action a0(p0_0: P, p0_1: P) {
  v2' = v2
}
action a1(p1_0: S0, p1_1: S0) {
  not p1_0.w0
  not p1_0.w0
  v2' = (p1_0 -> S1)
}
invariant Inv { some v2 }
reachable Goal { not ((v2 in (v2 - (S0 -> r0)) and (all q47: S0 | some (P.(P -> S1))))) }
scope S0 = 3, S1 = 3, steps = 6
