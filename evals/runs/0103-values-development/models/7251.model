model G7251
sig S0
sig S1
type P = S0 + S1
rel r0: some P
rel r1: S1 -> lone P
var v2: lone S0
var v3: S0 -> some S1
record R { n: Int, b: Bool }
var w0: S0 -> one Bool
var w1: S0 -> one R
fact { some S1 }
init { no v2 }
init { all x: S0 | x.w0 = false }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (false)
}
action set1(x: S0, k: Int) {
  k < #P
  w1' = w1 - x -> x.w1 + x -> (R { n: 2, b: false })
}
action a0(p0_0: P, p0_1: P) {
  #(P.(P -> P)) < 0
  (some (((P -> P).(P -> P)).P) implies #S1 >= 0)
  v2' = ((S0.(S0 -> S0)) & (P.(P -> S0)))
}
invariant Inv { (not ((all q1: S0 | q1.w1.n = (q1.w1.n - 0))) and (((all q2: S0 | q2.w1.b) and ((S0.(S0 -> v2)).(v2 -> S1)) not in S1) or (some q3: S0 | lone S1))) }
reachable Goal { ((v2.(v2 -> S0)) - S0) != (S0 - S0) }
scope S0 = 1, S1 = 2, Int = 0..2, steps = 6
