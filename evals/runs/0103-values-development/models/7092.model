model G7092
sig S0
enum E = Ea | Eb
type P = S0 + E
rel r0: E -> set S0
var v1: P -> some P
record R { n: Int, b: Bool }
var w0: S0 -> one Int
var w1: S0 -> one R
fact { ((((S0 -> Eb) - (S0 -> Ea)) in (S0 -> Ea) implies ((Ea -> E).Eb) != Ea) implies (no E or one P)) }
init { some v1 }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  #S0 > x.w0
  w0' = w0 - x -> x.w0 + x -> (x.w1.n)
}
action set1(x: S0, k: Int) {
  (k - #Ea) != x.w0
  w1' = w1 - x -> x.w1 + x -> (R { n: #P, b: false })
}
action a0(p0_0: E, p0_1: S0) {
  (no P and #(Eb - Eb) != 1)
  v1' = (P -> P)
}
action a1(p1_0: E) {
  v1' = (P -> P)
}
invariant Inv { #(v1.P) = 2 }
reachable Goal { ((((S0 -> Eb) + (S0 -> Eb)).(P.(P -> E))) != S0 and v1 in v1) }
scope S0 = 3, Int = 0..2, steps = 6
