model G7207
sig S0
sig S1
enum E = Ea | Eb
type P = S0 + S1
rel r0: some S0
rel r1: S1 -> set P
var v2: S0 -> one S0
var w0: S0 -> one Int
fact { ((one ((P.(P -> r0)) & r0) and lone none) or (lone (r0.((S0 -> Eb).(E -> S1))) implies no S0)) }
init { some v2 }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> (2)
}
action a0() {
  (#(P.(P -> S1)) = 2 implies some (((S0 -> Ea).(Ea -> P)).P))
  (#S1 <= 0 implies (none + ((r0 -> P).P)) = (((E -> r0).r0).(Ea -> r0)))
  v2' = (r0 -> (S0 + r0))
}
action a1(p1_0: P, p1_1: E) {
  v2' = v2
}
action a2() {
  v2' = (S0 -> r0)
}
invariant Inv { (((one S0 or lone (Eb + (S1.(S1 -> Eb)))) or (some q40: S1 | (((E -> Ea).Ea) + Eb) not in ((Eb + E) + Ea))) and ((v2.S0) & (none & none)) in r0) }
reachable Goal { v2 = v2 }
scope S0 = 2, S1 = 3, Int = -1..2, steps = 6
