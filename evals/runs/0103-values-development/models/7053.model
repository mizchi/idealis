model G7053
sig S0
rel r0: one S0
var v1: S0 -> some S0
var w0: S0 -> one Int
init { some (S0.v1) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((k * 0))
}
action a0(p0_0: S0, p0_1: S0) {
  (some S0 and some (v1.r0))
  (some p0_1 or (v1 - v1) = v1)
  v1' = v1
}
action a1(p1_0: S0, p1_1: S0) {
  (((v1 - v1).S0) in ((v1.S0) - (p1_1 - p1_1)) implies p1_0.w0 = (p1_1.w0 + p1_0.w0))
  (2 + 0) <= 2
  v1' = (S0 -> p1_0)
}
action a2(p2_0: S0) {
  v1' = (r0 -> p2_0)
}
invariant Inv { (v1.(r0 -> S0)) = v1 }
reachable Goal { (S0 -> r0) = v1 }
scope S0 = 3, Int = -1..2, steps = 6
