model G7114
sig S0
enum E = Ea | Eb
rel r0: E -> some S0
rel r1: set S0
var v2: S0 -> set S0
var w0: S0 -> one Int
fact { some r1 }
init { not ((v2.v2) = v2) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  k >= k
  w0' = w0 - x -> x.w0 + x -> (k)
}
action a0(p0_0: S0) {
  v2' = (((S0 -> Eb).r0) + (v2 + v2))
}
action a1() {
  ((all q7: S0 | (q7.w0 - 2) < (0 + 1)) and some E)
  v2' = v2
}
action a2(p2_0: E) {
  (some (S0 - r1) and some (Eb & Ea))
  v2' = (r1 -> r1)
}
invariant Inv { ((some q11: S0 | (2 * 1) >= q11.w0) implies (not (Eb != (((Ea -> S0) - r0).(v2.S0))) implies (all q12: S0 | (q12 -> Eb) in ((r1 -> Eb).(Eb -> Eb))))) }
reachable Goal { some (S0.v2) }
scope S0 = 3, Int = -1..2, steps = 6
