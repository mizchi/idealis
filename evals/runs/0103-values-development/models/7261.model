model G7261
sig S0
sig S1
rel r0: S1 -> one S1
rel r1: S1 -> some S1
var v2: set S1
var v3: set S0
record R { n: Int, b: Bool }
var w0: S0 -> one Bool
var w1: S0 -> one R
fact { (not (one none) or (some (S1.(S1 -> S1)) or none not in (((S0 -> S1).S1).(S0 -> S1)))) }
init { (v3 -> S0) = (v3 -> S0) }
init { all x: S0 | x.w0 = false }
init { all x: S0 | x.w1 = R { n: 0, b: false } }
action set0(x: S0) {
  w0' = w0 - x -> x.w0 + x -> (true)
}
action set1(x: S0, k: Int) {
  x.w0
  w1' = w1 - x -> x.w1 + x -> (R { n: x.w1.n, b: true })
}
action a0(p0_0: S1, p0_1: S1) {
  #(p0_0.r1) > 2
  ((v2 -> v3).(S0 + S0)) in (p0_0 + (r0.p0_0))
  v2' = ((S1.(p0_0 -> S0)).(S0 -> p0_1))
}
action a1(p1_0: S0, p1_1: S1) {
  v2' = S1
}
invariant Inv { (not (#(v3 - v3) != 2) or (some q5: S1 | (all q6: S0 | (q6.w1.n * #v3) = (0 * 2)))) }
reachable Goal { (all q10: S0 | #v2 > 1) }
scope S0 = 1, S1 = 2, Int = 0..2, steps = 6
