model G7052
sig S0
enum E = Ea | Eb
rel r0: one S0
var v1: S0 -> one S0
var v2: E -> some S0
record R { n: Int, b: Bool }
var w0: S0 -> one R
fact { (#(Ea.(Eb -> r0)) > 3 or (some (none & r0) and #(S0.(S0 -> S0)) = 2)) }
init { (some q1: S0 | (v1.(S0 -> S0)) = (r0 -> S0)) }
init { all x: S0 | x.w0 = R { n: 0, b: false } }
action set0(x: S0, k: Int) {
  #x >= 1
  w0' = w0 - x -> x.w0 + x -> (R { n: #Eb, b: true })
}
action a0(p0_0: E) {
  ((all q2: S0 | q2.w0.b) or some ((E.v2) & r0))
  v1' = ((Ea.v2) -> r0)
}
action a1(p1_0: S0) {
  v1' = (((r0 -> Ea).Ea) -> (r0.(S0 -> p1_0)))
}
invariant Inv { #(S0.v1) >= 1 }
reachable Goal { lone ((S0 & r0) + (v1.r0)) }
scope S0 = 3, Int = 0..2, steps = 6
