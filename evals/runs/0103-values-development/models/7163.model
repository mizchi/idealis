model G7163
sig S0
sig S1
rel r0: S1 -> lone S1
var v1: S0 -> some S1
var w0: S0 -> one Int
init { ((some q5: S0 | q5.w0 <= (0 + 1)) or some (S0.v1)) }
init { all x: S0 | x.w0 = 0 }
action set0(x: S0, k: Int) {
  w0' = w0 - x -> x.w0 + x -> ((k + k))
}
action a0(p0_0: S0, p0_1: S0) {
  v1' = (p0_0 -> S1)
}
invariant Inv { some (S0.v1) }
reachable Goal { (((all q28: S1 | (S0 & (v1.q28)) not in (S0 - (S0 & S0))) and (S0 -> S0) = (S0 -> S0)) and (some q29: S0 | (1 + #q29) >= (2 * 2))) }
scope S0 = 2, S1 = 1, Int = -1..2, steps = 6
