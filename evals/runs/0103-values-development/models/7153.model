model G7153
sig S0
rel r0: some S0
rel r1: S0 -> set S0
var v2: lone S0
var v3: one S0
var w0: S0 -> one Int
var w1: S0 -> one Bool
fact { ((r1 = r1 implies some ((r0 -> S0).S0)) implies not (one r0)) }
init { ((all q1: S0 | (1 - #q1) = #v3) implies some (S0.r1)) }
init { all x: S0 | x.w0 = 0 }
init { all x: S0 | x.w1 = false }
action set0(x: S0, k: Int) {
  not x.w1
  w0' = w0 - x -> x.w0 + x -> (k)
}
action set1(x: S0) {
  not x.w1
  w1' = w1 - x -> x.w1 + x -> (false)
}
action a0(p0_0: S0) {
  (p0_0.w1 or #(v2.r1) = 3)
  (#(S0.r1) > 1 and 1 <= 0)
  v3' = (((p0_0 -> S0).v2).(r0 -> r0))
}
invariant Inv { (v2.(r1.(S0 -> S0))) != (r1.v2) }
reachable Goal { ((all q2: S0 | some (v3 + q2)) implies (some S0 or not (some v3))) }
scope S0 = 3, Int = -1..2, steps = 6
