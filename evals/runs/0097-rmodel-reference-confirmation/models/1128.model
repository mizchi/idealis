model G1128
sig S0
rel r0: set S0
rel r1: set S0
var v2: S0 -> set S0
var v3: S0 -> set S0
fact { ((one S0 or (r1 + none) != r0) and some (S0 - S0)) }
init { (v2.(r0 -> r1)) in v2 }
action a0(p0_0: S0, p0_1: S0) {
  v2' = ((r0 -> p0_0).(r0 -> r1))
}
invariant Inv { ((((r1 -> r0) = (v2 + v2) or some (S0.v2)) implies (all q1: S0 | some (S0 + q1))) or one ((S0.(r1 -> r1)).(v3 - (r0 -> r1)))) }
reachable Goal { not (some (v3.r0)) }
scope S0 = 3, steps = 6
