model G1095
sig S0
var v0: S0 -> set S0
init { not (((S0.v0).((S0 -> S0).v0)) in S0) }
action a0(p0_0: S0, p0_1: S0) {
  ((p0_1 -> p0_1) & v0) in v0
  v0' = (p0_0 -> (p0_1.v0))
}
action a1(p1_0: S0) {
  p1_0 in (v0.(v0.p1_0))
  (some (v0.p1_0) and #p1_0 <= 1)
  v0' = ((v0.(S0 -> p1_0)).((S0 -> p1_0).(p1_0 -> p1_0)))
}
invariant Inv { not (((#(none - S0) <= 0 or (S0 -> S0) in v0) or #(v0.S0) <= 1)) }
reachable Goal { some (v0.S0) }
scope S0 = 1, steps = 6
