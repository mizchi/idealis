model G1182
sig S0
rel r0: S0 -> set S0
rel r1: lone S0
var v2: S0 -> set S0
var v3: S0 -> lone S0
init { (r0.(v2.r1)) in none }
action a0() {
  (((S0 & r1) & (S0.v2)) != S0 or some ((r1 -> r1).S0))
  v2' = (r1 -> (v2.S0))
}
action a1(p1_0: S0, p1_1: S0) {
  v3' = ((p1_1 - p1_0) -> p1_1)
}
action a2(p2_0: S0, p2_1: S0) {
  (#r1 = 2 implies p2_1 in p2_1)
  ((v3.(p2_1 + p2_0)) in r1 implies some (S0.v2))
  v2' = (r0 & r0)
}
invariant Inv { ((all q1: S0 | ((v2 - r0) = r0 implies some (S0.v3))) and (some (S0.r0) or (S0 -> S0) = v3)) }
reachable Goal { (all q2: S0 | ((all q3: S0 | #S0 != 0) and (v2.v3) = (v2 & r0))) }
scope S0 = 1, steps = 6
