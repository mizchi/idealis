model G1025
sig S0
enum E = Ea | Eb
rel r0: E -> set S0
rel r1: S0 -> one S0
var v2: S0 -> some S0
init { (v2.E) = E }
action a0() {
  v2' = (r1 & r0)
}
action a1(p1_0: E) {
  v2' = v2
}
invariant Inv { ((v2 in r1 and not ((r0.(S0 -> E)) = (Ea -> Ea))) or ((some q2: E | (r0 + v2) = r1) implies not (#(Eb & S0) < 1))) }
reachable Goal { (v2 + v2) = (v2 - (E -> Ea)) }
scope S0 = 3, steps = 6
