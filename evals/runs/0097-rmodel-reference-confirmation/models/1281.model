model G1281
sig S0
sig S1
rel r0: S1 -> some S0
var v1: set S0
var v2: S0 -> lone S0
init { not (v2 in (v1 -> S1)) }
action a0() {
  (some (none - S0) or some (v1 + S0))
  (all q1: S0 | #v1 < 1)
  v2' = ((v1 -> S0) - (r0.r0))
}
action a1(p1_0: S0, p1_1: S0) {
  v2' = (((S0 -> v1).(p1_1 -> p1_0)) + ((S0 -> S1) + r0))
}
action a2(p2_0: S1) {
  not (v2 in v2)
  v2' = ((S1.(S1 -> S0)) -> ((v1 -> S0).S1))
}
invariant Inv { (((some none and (r0.(v1 -> v1)) = v2) or not (#v1 != 0)) or ((some (S0 & S0) implies lone S1) and (some none implies lone (S0 + (v1.v2))))) }
reachable Goal { (v2 = (v2.(S1 -> S1)) and (not (r0 = ((v1 -> v1).(v1 -> S0))) and S0 = (S1.(v2 - r0)))) }
scope S0 = 3, S1 = 3, steps = 6
