model G1239
sig S0
rel r0: S0 -> set S0
rel r1: lone S0
var v2: S0 -> set S0
var v3: S0 -> one S0
fact { ((r0.S0).(r1 -> S0)) = ((r0 + r0).S0) }
init { (((S0.v3) + (S0.r0)) != ((v2.r1) & (r1.r0)) or some none) }
action a0() {
  lone r1
  v2' = (((S0 -> r1).S0) -> (r1 - S0))
}
action a1(p1_0: S0, p1_1: S0) {
  (((r0.v3).(S0 + r1)) not in p1_0 or some p1_1)
  v2' = ((p1_1 - p1_1) -> ((r1 -> r1).S0))
}
invariant Inv { #(v2.S0) = 0 }
reachable Goal { (all q1: S0 | not (none = ((v3.v3).(v3.S0)))) }
scope S0 = 3, steps = 6
