model G1202
sig S0
rel r0: S0 -> one S0
rel r1: S0 -> set S0
var v2: S0 -> one S0
fact { some S0 }
init { ((S0 -> S0) in (S0 -> S0) or (v2.S0) not in ((r0.S0).r1)) }
action a0(p0_0: S0, p0_1: S0) {
  (r1 in v2 and one ((p0_1.r1).(p0_1 -> p0_1)))
  v2' = r0
}
action a1(p1_0: S0) {
  ((p1_0 -> S0) in (S0 -> none) and some p1_0)
  ((r1.p1_0) & (S0 + S0)) not in p1_0
  v2' = ((r1.r1).r0)
}
action a2(p2_0: S0) {
  (no (p2_0.((S0 -> S0).v2)) or (p2_0 & (v2.p2_0)) != ((r0.v2).S0))
  ((((p2_0 -> p2_0).r0).p2_0) != (p2_0.v2) or (v2.(p2_0 - S0)) != ((S0 + S0) & (p2_0.(p2_0 -> p2_0))))
  v2' = ((v2.S0) -> (v2.p2_0))
}
invariant Inv { ((v2.S0) & S0) != S0 }
reachable Goal { ((some q3: S0 | q3 != ((v2.r1).(S0.v2))) or (S0.(S0 -> S0)) != S0) }
scope S0 = 3, steps = 6
