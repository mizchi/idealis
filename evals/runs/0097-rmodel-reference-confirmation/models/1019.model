model G1019
sig S0
var v0: S0 -> some S0
var v1: S0 -> set S0
init { (lone ((S0 - S0) & (v0.S0)) and #(S0 - S0) = 1) }
action a0() {
  ((v1.v1) = v1 implies some (S0 + S0))
  (some (v0.S0) or no S0)
  v0' = ((S0 & S0) -> S0)
}
action a1(p1_0: S0) {
  #(v1.p1_0) <= 2
  v1' = ((S0 + S0) -> (S0.v0))
}
action a2(p2_0: S0) {
  v0' = v0
}
invariant Inv { one ((S0 -> S0).(S0.v0)) }
reachable Goal { ((#(S0 - S0) != 3 implies (no (v1.((S0 -> S0).S0)) and ((S0 -> S0).S0) != S0)) implies no S0) }
scope S0 = 2, steps = 6
