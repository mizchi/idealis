model G1114
sig S0
var v0: S0 -> some S0
var v1: S0 -> set S0
init { (((S0 -> S0) + (S0 -> S0)) = v1 and no S0) }
action a0(p0_0: S0) {
  some S0
  (none != ((p0_0 - p0_0).(v0 & (p0_0 -> S0))) implies ((S0 -> p0_0).v1) = ((S0 -> p0_0).v0))
  v0' = (S0 -> p0_0)
}
action a1() {
  (some (S0.v0) implies #((S0 -> S0).S0) >= 2)
  v1' = ((S0.(S0 -> S0)) -> (v1.S0))
}
action a2(p2_0: S0) {
  (#S0 <= 0 and some (S0 + S0))
  v1' = v0
}
invariant Inv { S0 = ((S0 -> S0).(v1.S0)) }
reachable Goal { (((#(v1.S0) >= 2 implies some S0) implies ((S0 & S0) not in ((v0.S0) & S0) and #S0 < 3)) or some (S0 - S0)) }
scope S0 = 2, steps = 6
