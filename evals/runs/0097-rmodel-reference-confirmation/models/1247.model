model G1247
sig S0
enum E = Ea | Eb
rel r0: S0 -> some E
var v1: S0 -> lone S0
var v2: S0 -> some E
fact { (Eb = ((r0.Eb).(r0.r0)) or (some q1: S0 | #(E.r0) <= 1)) }
init { ((S0 -> Eb) in v1 or some none) }
action a0(p0_0: E) {
  #(p0_0 & E) >= 2
  v2' = ((E -> E).(Eb -> E))
}
action a1(p1_0: E) {
  v2' = (v2.(v2 + r0))
}
action a2(p2_0: S0, p2_1: S0) {
  (all q2: S0 | E in Eb)
  v2' = v2
}
invariant Inv { (not (not ((E.v1) = ((Eb -> S0).S0))) and not ((r0.v2) in (S0 -> Ea))) }
reachable Goal { (not (v2 = (S0 -> S0)) implies ((Eb & E).r0) not in (v2.(v1.Eb))) }
scope S0 = 3, steps = 6
