model G1005
sig S0
enum E = Ea | Eb
rel r0: S0 -> some S0
rel r1: S0 -> one S0
var v2: E -> set E
init { not ((r1.r0) in (r0 + v2)) }
action a0(p0_0: E) {
  some E
  v2' = r1
}
action a1() {
  (some q1: S0 | q1 not in (r0.Ea))
  none in ((v2.(S0 -> E)).(r0.Ea))
  v2' = ((S0 -> Eb).r0)
}
invariant Inv { ((all q2: S0 | (all q3: E | E = ((q2.v2).(r1 - v2)))) or one (E.(S0 -> E))) }
reachable Goal { (not (some (S0.v2)) and one E) }
scope S0 = 3, steps = 6
