model G1259
sig S0
sig S1
rel r0: S0 -> set S0
rel r1: S0 -> some S1
var v2: S0 -> set S0
fact { (some S0 and (some (S1.r1) or one (S1 & none))) }
init { (#(S1.r0) < 3 or (v2 - r1) in (S1 -> S0)) }
action a0(p0_0: S1, p0_1: S0) {
  #(p0_1 & p0_1) <= 3
  v2' = (r0 - r1)
}
invariant Inv { (v2.r1) = ((S1 -> S1) + r1) }
reachable Goal { ((not ((S1 -> S0) in (S1 -> none)) and #(r0.S1) > 3) or some (v2.S1)) }
scope S0 = 3, S1 = 3, steps = 6
