model G1131
sig S0
sig S1
var v0: S1 -> some S0
init { some ((v0 + v0).(S0.v0)) }
action a0(p0_0: S0, p0_1: S1) {
  some p0_0
  v0 = ((S1 -> S0).v0)
  v0' = ((p0_0 + S1) -> (S1.v0))
}
invariant Inv { (not ((one S0 or #((S0 -> S1).S1) > 3)) and ((some q1: S1 | some (S0.v0)) implies (one ((S1.(S0 -> S0)).v0) or some (v0.S0)))) }
reachable Goal { (some q2: S0 | ((some q3: S0 | lone (v0.(q3 + q2))) or not ((v0 + v0) in (v0 - v0)))) }
scope S0 = 1, S1 = 2, steps = 6
