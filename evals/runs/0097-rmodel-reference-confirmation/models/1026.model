model G1026
sig S0
sig S1
rel r0: S0 -> lone S0
rel r1: lone S0
var v2: S0 -> set S1
fact { (some q1: S0 | not ((S0 -> S1) in (r0.r0))) }
init { ((v2.r1) & S0) in (S1.r0) }
action a0(p0_0: S1) {
  (all q2: S0 | some r1)
  v2' = ((none - r1) -> (S0.r0))
}
action a1() {
  v2' = (((S1 -> r1) + r0).(v2.r0))
}
action a2(p2_0: S0, p2_1: S1) {
  some p2_1
  ((S0 -> p2_1) in ((none -> S1) & r0) or some none)
  v2' = r0
}
invariant Inv { not (((((r1 + S1).(S1 -> r1)) not in (S0.v2) and S1 = S1) and (r0 = (S1 -> S1) or v2 = r0))) }
reachable Goal { ((((r0.v2) = ((r1 -> S0).v2) or #(v2.S0) != 2) and not (some r1)) or v2 = (r0.(r1 -> S0))) }
scope S0 = 1, S1 = 3, steps = 6
