model G1018
sig S0
rel r0: some S0
rel r1: S0 -> set S0
var v2: S0 -> set S0
fact { ((S0 & S0).r1) = (((r0 -> r0).S0).(r0 -> S0)) }
init { not (v2 in ((S0 -> none) & r1)) }
action a0(p0_0: S0, p0_1: S0) {
  not (#(none - p0_1) <= 0)
  v2' = (r1 + ((p0_0 -> r0).v2))
}
action a1(p1_0: S0, p1_1: S0) {
  v2' = (r1 + (S0 -> r0))
}
action a2(p2_0: S0, p2_1: S0) {
  (r1 = v2 implies some (p2_1.(S0 -> S0)))
  v2' = (r1.(S0 -> S0))
}
invariant Inv { (some q1: S0 | ((v2 - v2) = ((q1 -> S0).v2) implies S0 in r0)) }
reachable Goal { some ((S0.v2).(r0 -> S0)) }
scope S0 = 3, steps = 6
