model G1276
sig S0
sig S1
enum E = Ea | Eb
rel r0: E -> set S0
var v1: E -> lone S1
var v2: set S1
fact { (some q1: S1 | some (S1 - none)) }
init { #(v2 & S0) <= 1 }
action a0() {
  v1' = (Eb -> ((Ea -> E).Ea))
}
invariant Inv { (some S0 or (S1 not in Eb and ((v1.(Ea -> E)) in ((S0 -> E) & v1) or ((S0 -> S1).(S0 -> Ea)) = (v1.v1)))) }
reachable Goal { (v1.v1) = r0 }
scope S0 = 1, S1 = 2, steps = 6
