model G1149
sig S0
sig S1
var v0: S0 -> set S1
var v1: S1 -> lone S0
init { some (S0.v1) }
action a0(p0_0: S0, p0_1: S1) {
  some (p0_1.v1)
  v0' = ((p0_1 -> S1).(p0_0 -> S1))
}
action a1(p1_0: S0, p1_1: S1) {
  not (((S1 + S0) & (v0.p1_0)) = ((p1_0 -> p1_0).(p1_1.(S0 -> p1_1))))
  v1' = ((S0.v1) -> (S1.v0))
}
action a2() {
  (all q1: S0 | #(S0.v0) <= 3)
  (#(S0.(S0 -> S0)) >= 3 or (v0.v1) in v0)
  v1' = ((v0.S1) -> S1)
}
invariant Inv { ((S1 -> S0) = ((S1 -> S0) + v1) implies S0 in S0) }
reachable Goal { (some q2: S0 | ((lone S0 implies (q2 -> S0) = (S1 -> none)) and v1 = (none -> S0))) }
scope S0 = 2, S1 = 3, steps = 6
