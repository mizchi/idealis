model G1293
sig S0
rel r0: one S0
rel r1: S0 -> lone S0
var v2: set S0
var v3: S0 -> lone S0
fact { #(none + r0) < 2 }
init { (no none implies some ((S0 - v2) & v2)) }
action a0() {
  v2' = ((S0 + S0) + r0)
}
invariant Inv { not ((#(v2.v3) < 2 or (some ((v3 - v3).((S0 -> r0).v2)) and #(r0 - v2) > 1))) }
reachable Goal { (r0 != r0 implies some ((v3.v3).r0)) }
scope S0 = 3, steps = 6
