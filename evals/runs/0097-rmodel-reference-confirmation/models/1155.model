model G1155
sig S0
var v0: S0 -> set S0
init { ((((S0 -> S0).S0) & (v0.S0)) not in S0 and (S0 - S0) in S0) }
action a0() {
  (all q1: S0 | ((q1 -> q1).(S0 + q1)) not in (q1 + q1))
  v0' = v0
}
action a1(p1_0: S0) {
  v0' = v0
}
action a2(p2_0: S0) {
  (all q2: S0 | no none)
  v0' = (p2_0 -> (v0.S0))
}
invariant Inv { no ((S0 & S0) + (v0.S0)) }
reachable Goal { (v0 in v0 implies (some q3: S0 | (v0 + v0) = (v0 - (q3 -> q3)))) }
scope S0 = 2, steps = 6
