model G1046
sig S0
enum E = Ea | Eb
rel r0: set E
var v1: E -> some S0
var v2: set E
init { (none + r0) = ((v1 & v1).(Eb & E)) }
action a0() {
  (some (Eb + Eb) or E in (Ea + (Ea.v1)))
  some (r0.v1)
  v2' = Eb
}
action a1(p1_0: S0) {
  (some q1: E | (q1 -> r0) = ((Eb -> E).v1))
  v1' = ((Ea - r0) -> (v1.v2))
}
action a2(p2_0: S0) {
  (some q2: E | #Ea = 2)
  (((E -> Eb).(r0 -> v2)) in (v1 & (r0 -> E)) implies no (v2 - none))
  v2' = p2_0
}
invariant Inv { ((not (#(S0 & Eb) < 2) and (some (v1.v2) implies #(v1.Eb) = 1)) and no ((v1.v1).(v1.E))) }
reachable Goal { (((all q3: S0 | no E) or (some q4: E | (S0 -> E) in v1)) implies v1 = (v1 + v1)) }
scope S0 = 1, steps = 6
