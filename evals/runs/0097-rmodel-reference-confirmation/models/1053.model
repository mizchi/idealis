model G1053
sig S0
rel r0: one S0
var v1: S0 -> some S0
var v2: S0 -> lone S0
init { #(r0.v1) >= 0 }
action a0(p0_0: S0, p0_1: S0) {
  v1' = ((v2.p0_0) -> (r0.(r0 -> r0)))
}
action a1() {
  (r0 = S0 implies ((r0 -> r0).S0) != ((S0.v2).v1))
  v1' = (S0 -> (S0 + none))
}
action a2(p2_0: S0, p2_1: S0) {
  ((p2_1.(p2_1 -> r0)) in (p2_1.(p2_1 -> r0)) or p2_0 != p2_1)
  (one r0 or no S0)
  v1' = (v1.(v2 + v2))
}
invariant Inv { (((no (v2.S0) and #(S0.v2) > 2) implies some none) or not (#r0 != 2)) }
reachable Goal { ((some q3: S0 | (all q4: S0 | (v2.q4) not in (v2.q4))) and (S0.(r0 -> S0)) not in S0) }
scope S0 = 2, steps = 6
