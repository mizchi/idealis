model G1284
sig S0
enum E = Ea | Eb
var v0: E -> one E
var v1: S0 -> set E
init { (one Eb or v0 in ((S0 -> S0) & (Ea -> Eb))) }
action a0() {
  (some q2: S0 | (none & Eb) not in (((Eb -> Eb).S0) & Eb))
  (one Ea implies (v0 - v0) = (v1.(E -> S0)))
  v1' = ((v0.(E -> E)) & v0)
}
action a1(p1_0: S0) {
  v1' = ((none -> E) & (v0.(S0 -> S0)))
}
action a2(p2_0: E, p2_1: E) {
  (no (v0.(E & p2_1)) and lone Eb)
  (some p2_1 or v0 = (p2_1 -> none))
  v0' = ((Ea.v0) -> (p2_0.v0))
}
invariant Inv { lone ((E.v0) - (Eb.v1)) }
reachable Goal { (all q3: S0 | (((S0.v0) in q3 and some Eb) or (some (S0.v1) and (Eb -> Ea) = v1))) }
scope S0 = 1, steps = 6
