model G1107
sig S0
sig S1
enum E = Ea | Eb
rel r0: S0 -> one E
var v1: S0 -> set E
fact { (r0 = ((S1 -> E).r0) implies ((r0.r0) in ((S0 -> Ea).r0) implies (r0.r0) = (r0 - (S0 -> Eb)))) }
init { (some S0 implies some (v1.Eb)) }
action a0(p0_0: E) {
  v1' = (p0_0 -> (p0_0.(S0 -> S0)))
}
action a1() {
  v1' = ((r0.v1) - (v1 - (Ea -> S0)))
}
invariant Inv { (v1 = (r0.v1) or (((v1 - (S0 -> none)) = ((S0 -> none) + r0) implies some S0) and (some (Ea & E) and (S1 -> none) in (v1 & r0)))) }
reachable Goal { one ((v1 - r0).E) }
scope S0 = 1, S1 = 3, steps = 6
