model G1022
sig S0
enum E = Ea | Eb
rel r0: E -> set E
var v1: S0 -> set S0
var v2: E -> some E
init { (Ea != Ea implies v2 in (r0.r0)) }
action a0(p0_0: S0, p0_1: S0) {
  not (((S0.v2) - E) in none)
  v2' = ((Ea -> S0) + (v2.v1))
}
action a1(p1_0: S0) {
  (all q1: S0 | (none -> p1_0) in (r0.v1))
  not (#S0 >= 2)
  v2' = (v1 + v2)
}
invariant Inv { ((r0.v2) in (none -> S0) or ((v1.S0) = ((S0 -> Eb).(Eb.r0)) implies Ea in ((Eb -> Ea).((E -> Ea).E)))) }
reachable Goal { (Eb -> Eb) = (v2 + v2) }
scope S0 = 3, steps = 6
