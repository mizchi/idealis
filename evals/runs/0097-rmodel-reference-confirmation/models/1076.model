model G1076
sig S0
sig S1
rel r0: set S0
rel r1: one S1
var v2: set S1
var v3: S0 -> some S0
init { (some (v3.S1) and ((S1 -> r1) - v3) in (S0 -> v2)) }
action a0() {
  (#(r0.(v2 -> r1)) < 3 and v2 in S0)
  not (one (v2.v3))
  v3' = ((v3.v2) -> (v3.r1))
}
invariant Inv { ((all q2: S1 | some (r1.v3)) or (some (r0.v3) and (S1 = ((v2 & S0) + S1) and #none <= 1))) }
reachable Goal { #(S0.v3) <= 0 }
scope S0 = 3, S1 = 1, steps = 6
