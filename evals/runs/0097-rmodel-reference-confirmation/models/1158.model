model G1158
sig S0
var v0: S0 -> one S0
init { (some q1: S0 | no (((S0 -> S0).v0).S0)) }
action a0() {
  v0' = ((S0.v0) -> (v0.S0))
}
action a1(p1_0: S0) {
  (v0 + v0) in (p1_0 -> S0)
  not ((v0.v0) in v0)
  v0' = v0
}
action a2(p2_0: S0) {
  (some (p2_0.v0) and #(p2_0 & p2_0) = 3)
  v0' = (((S0 -> p2_0).v0).((S0 -> p2_0).v0))
}
invariant Inv { ((some q2: S0 | not (q2 in ((S0.v0) - (q2.v0)))) and not ((all q3: S0 | lone S0))) }
reachable Goal { not ((some q4: S0 | (v0.(S0 -> q4)) in (v0 + v0))) }
scope S0 = 2, steps = 6
