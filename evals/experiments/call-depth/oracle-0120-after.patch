diff -ruN a/crates/rtlc/src/probe.rs b/crates/rtlc/src/probe.rs
--- a/crates/rtlc/src/probe.rs
+++ b/crates/rtlc/src/probe.rs
@@ -0,0 +1,166 @@
+use crate::ir::SafetyResult;
+use crate::value::CoreError;
+use std::cell::{Cell, RefCell};
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicBool, AtomicU16, AtomicU32, Ordering};
+
+pub const LIMIT: u16 = 4096;
+pub const RAW_MESSAGE: &str = "Safety evaluation nesting exceeds 256";
+
+static ACTIVE: AtomicBool = AtomicBool::new(true);
+static CUTTING: AtomicBool = AtomicBool::new(false);
+static PARALLEL: AtomicBool = AtomicBool::new(false);
+static PEAK_DEPTH: AtomicU16 = AtomicU16::new(0);
+static PEAK_TOTAL: AtomicU16 = AtomicU16::new(0);
+static HITS: AtomicU32 = AtomicU32::new(0);
+static PUBLISHED: Mutex<Published> = Mutex::new(Published::Own);
+
+#[derive(Clone, Debug)]
+pub enum Published {
+    Own,
+    Hit(String),
+    Cut(Result<SafetyResult, (String, String)>),
+}
+
+pub struct Summary {
+    pub peak_depth: u16,
+    pub peak_total: u16,
+    pub hits: u32,
+    pub published: Published,
+}
+
+thread_local! {
+    static FOLDS: RefCell<Vec<&'static str>> = const { RefCell::new(Vec::new()) };
+    static FIRST: RefCell<Option<String>> = const { RefCell::new(None) };
+    static CUT_LEN: Cell<Option<usize>> = const { Cell::new(None) };
+}
+
+pub fn begin() {
+    ACTIVE.store(true, Ordering::SeqCst);
+    CUTTING.store(false, Ordering::SeqCst);
+    PARALLEL.store(false, Ordering::SeqCst);
+    PEAK_DEPTH.store(0, Ordering::SeqCst);
+    PEAK_TOTAL.store(0, Ordering::SeqCst);
+    HITS.store(0, Ordering::SeqCst);
+    *PUBLISHED.lock().unwrap() = Published::Own;
+    reset_thread();
+}
+
+fn reset_thread() {
+    FOLDS.with_borrow_mut(Vec::clear);
+    FIRST.with_borrow_mut(|first| *first = None);
+    CUT_LEN.set(None);
+}
+
+pub fn summary() -> Summary {
+    Summary {
+        peak_depth: PEAK_DEPTH.load(Ordering::SeqCst),
+        peak_total: PEAK_TOTAL.load(Ordering::SeqCst),
+        hits: HITS.load(Ordering::SeqCst),
+        published: PUBLISHED.lock().unwrap().clone(),
+    }
+}
+
+pub fn line() -> String {
+    let summary = summary();
+    format!(
+        "peak={} total={} hits={} published={}",
+        summary.peak_depth,
+        summary.peak_total,
+        summary.hits,
+        match summary.published {
+            Published::Own => "own".to_string(),
+            Published::Hit(message) => format!("hit:{message}"),
+            Published::Cut(Ok(result)) => format!("cut:{} {} {}", result.status, result.states, result.generated),
+            Published::Cut(Err((code, message))) => format!("cut-error:{code}:{message}"),
+        }
+    )
+}
+
+#[inline]
+pub(crate) fn record(depth: u16, total: u16) {
+    if ACTIVE.load(Ordering::Relaxed) {
+        PEAK_DEPTH.fetch_max(depth, Ordering::Relaxed);
+        PEAK_TOTAL.fetch_max(total, Ordering::Relaxed);
+    }
+}
+
+pub(crate) fn hit() {
+    if ACTIVE.load(Ordering::Relaxed) {
+        HITS.fetch_add(1, Ordering::Relaxed);
+    }
+    let diagnostic = FOLDS.with_borrow(|folds| folds.last().copied());
+    FIRST.with_borrow_mut(|first| {
+        if first.is_none() {
+            *first = Some(diagnostic.unwrap_or(RAW_MESSAGE).to_string());
+        }
+    });
+}
+
+pub(crate) fn fold_enter(replacement: Option<&'static str>) -> bool {
+    match replacement {
+        Some(message) => {
+            FOLDS.with_borrow_mut(|folds| folds.push(message));
+            true
+        }
+        None => false,
+    }
+}
+
+pub(crate) fn fold_exit(entered: bool) {
+    if entered {
+        FOLDS.with_borrow_mut(|folds| {
+            folds.pop();
+        });
+    }
+}
+
+pub(crate) fn cutting() -> bool {
+    CUTTING.load(Ordering::Relaxed)
+}
+
+pub(crate) fn mark_parallel() {
+    if ACTIVE.load(Ordering::Relaxed) {
+        PARALLEL.store(true, Ordering::Relaxed);
+    }
+}
+
+pub(crate) fn worker_begin() {
+    reset_thread();
+}
+
+pub(crate) fn worker_note(length: usize) {
+    if FIRST.with_borrow(Option::is_some) && CUT_LEN.get().is_none() {
+        CUT_LEN.set(Some(length));
+    }
+}
+
+pub(crate) fn worker_end(length: usize) -> Option<(usize, String)> {
+    worker_note(length);
+    let message = FIRST.with_borrow(Clone::clone)?;
+    Some((CUT_LEN.get().unwrap_or(length), message))
+}
+
+pub(crate) fn observed(
+    mut run: impl FnMut() -> Result<SafetyResult, CoreError>,
+) -> Result<SafetyResult, CoreError> {
+    let own = run();
+    if HITS.load(Ordering::SeqCst) == 0 {
+        return own;
+    }
+    if !PARALLEL.load(Ordering::SeqCst) {
+        let message = FIRST.with_borrow(Clone::clone).unwrap_or_else(|| RAW_MESSAGE.to_string());
+        *PUBLISHED.lock().unwrap() = Published::Hit(message);
+        return own;
+    }
+    ACTIVE.store(false, Ordering::SeqCst);
+    CUTTING.store(true, Ordering::SeqCst);
+    let cut = run();
+    CUTTING.store(false, Ordering::SeqCst);
+    ACTIVE.store(true, Ordering::SeqCst);
+    *PUBLISHED.lock().unwrap() = Published::Cut(match &cut {
+        Ok(result) => Ok(result.clone()),
+        Err(error) => Err((error.code.to_string(), error.message.clone())),
+    });
+    own
+}
