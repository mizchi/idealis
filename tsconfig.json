{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["fixtures", "evals/runs"],
  "include": [
    "packages/idealis/src/**/*.ts",
    "packages/idealis/cli/**/*.ts",
    "scripts/**/*.ts",
    "examples/**/*.ts",
    "evals/experiments/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ]
}
